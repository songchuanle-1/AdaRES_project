(lang_query), p=2, dim=-1))\r\nAdaRES\\ipdn\\model_paper5\\adares_b4_query_competition\\dec.py:424:        return {\r\nAdaRES\\ipdn\\model_paper5\\adares_b4_query_competition\\dec.py:425:            'masks': pred_masks,\r\nAdaRES\\ipdn\\model_paper5\\adares_b4_query_competition\\dec.py:428:            'indis': pred_indis, # [B, B_q, 2]\r\nAdaRES\\ipdn\\model_paper5\\adares_b4_query_competition\\dec.py:463:        return new_feats, mask\r\nAdaRES\\ipdn\\model_paper5\\adares_b4_query_competition\\dec.py:466:        pred_masks = torch.einsum('bnd,bmd->bnm', query\r\n, mask_feats)\r\nAdaRES\\ipdn\\model_paper5\\adares_b4_query_competition\\dec.py:468:            attn_masks = (pred_masks.sigmoid() < 0.5).b\r\nool() # [B, 1, num_sp]\r\nAdaRES\\ipdn\\model_paper5\\adares_b4_query_competition\\dec.py:475:        return pred_masks, attn_masks\r\nAdaRES\\ipdn\\model_paper5\\adares_b4_query_competition\\dec.py:480:        pred_masks, attn_masks = self.get_mask(query, m\r\nask_feats, batch_mask)\r\nAdaRES\\ipdn\\model_paper5\\adares_b4_query_competition\\dec.py:481:        return pred_scores, pred_masks, attn_masks\r\nAdaRES\\ipdn\\model_paper5\\adares_b4_query_competition\\dec.py:500:        return scg_weight, scg_mask\r\nAdaRES\\ipdn\\model_paper5\\adares_b4_query_competition\\dec.py:504:    def forward(self, x, fps_seed_sp, batch_offsets, la\r\nng_feats=None, lang_masks=None, sp_pos=None, feats_2d=None):\r\nAdaRES\\ipdn\\model_paper5\\adares_b4_query_competition\\dec.py:506:            return self.forward_iter_pred(x, fps_seed_s\r\np, batch_offsets, lang_feats, lang_masks, sp_pos, feats_2d)\r\nimport argparse\r\nimport json\r\nimport statistics\r\nimport sys\r\nimport types\r\nfrom pathlib import Path\r\n\r\nimport gorilla\r\nimport torch\r\nimport torch.nn.functional as F\r\n\r\nROOT = Path(__file__).resolve().parents[1]\r\nsys.path.insert(0, str(ROOT))\r\n\r\nfrom ipdn.dataset import build_dataset\r\nfrom ipdn.model_paper5.adares_b4_query_competition import IPDN\r\nfrom ipdn.utils import get_root_logger\r\n\r\n\r\ndef predictor(self, scan_ids, object_idss, ann_ids, out, superpoints,\r\n              gt_pmasks, gt_spmasks, fps_seed_sp):\r\n    valid = (~out[\"batch_mask\"]).float()\r\n    weights = out[\"masks\"].sigmoid() * valid[:, None, :]\r\n    scene = self.probe_scene\r\n    fg = torch.bmm(weights, scene) / weights.sum(-1, keepdim=True).clamp_min(1e-6)\r\n    bg_weight = valid[:, None, :] - weights\r\n    bg = torch.bmm(bg_weight, scene) / bg_weight.sum(-1, keepdim=True).clamp_min(1e-6)\r\n    contrast = F.normalize(fg - bg, dim=-1)\r\n    language = F.normalize(self.probe_language, dim=-1)\r\n    token_valid = self.probe_token_mask.bool()\r\n    similarity = torch.bmm(contrast, language.transpose(1, 2))\r\n    similarity = similarity.masked_fill(~token_valid[:, None, :], -1e4)\r\n    token_match = similarity.max(-1).values\r\n    shifted = torch.bmm(contrast, language.roll(1, dims=0).transpose(1, 2))\r\n    shifted = shifted.masked_fill(~token_valid.roll(1, dims=0)[:, None, :], -1e4)\r\n    shifted_match = shifted.max(-1).values\r\n    scores = out[\"indis\"].softmax(-1)[..., 1]\r\n    rows = []\r\n    for index, target in enumerate(gt_pmasks):\r\n        masks = out[\"masks\"][index].sigmoid().gt(0.5)[:, superpoints]\r\n        truth = target.gt(0.5).to(masks.device)\r\n        ious = (masks & truth).sum(-1).float() / (\r\n            (masks | truth).sum(-1).clamp_min(1).float()\r\n        )\r\n        selected, oracle = int(scores[index].argmax()), int(ious.argmax())\r\n        rows.append({\r\n            \"selected_iou\": float(ious[selected]),\r\n            \"oracle_iou\": float(ious[oracle]),\r\n            \"selected_token\": float(token_match[index, selected]),\r\n            \"oracle_token\": float(token_match[index, oracle]),\r\n            \"selected_shifted\": float(shifted_match[index, selected]),\r\n            \"oracle_shifted\": float(shifted_match[index, oracle]),\r\n            \"token_only_iou\": float(ious[token_match[index].argmax()]),\r\n            \"shifted_only_iou\": float(ious[shifted_match[index].argmax()]),\r\n        })\r\n    return {\"rows\": rows}\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser()\r\n    parser.add_argument(\"config\")\r\n    parser.add_argument(\"checkpoint\")\r\n    parser.add_argument(\"--output\", required=True)\r\n    parser.add_argument(\"--scenes\", type=int, default=64)\r\n    parser.add_argument(\"--gpu-id\", type=int, default=0)\r\n    args = parser.parse_args()\r\n    gorilla.set_cuda_visible_devices([args.gpu_id], 1)\r\n    gorilla.set_random_seed(1999)\r\n    cfg = gorilla.Config.fromfile(args.config)\r\n    data_cfg = cfg.data.train.copy()\r\n    data_cfg.training = False\r\n    data_cfg.aug = False\r\n    data_cfg.with_elastic = False\r\n    data_cfg.lang_num_max = 32\r\n    dataset = build_dataset(data_cfg, get_root_logger())\r\n    model = IPDN(**cfg.model).cuda()\r\n    checkpoint = torch.load(args.checkpoint, map_location=\"cpu\")\r\n    loaded = model.load_state_dict(checkpoint.get(\"model\", checkpoint), strict=False)\r\n    allowed = {\"text_encoder.embeddings.position_ids\",\r\n               \"text_encoder.embeddings.token_type_ids\"}\r\n    if loaded.missing_keys or set(loaded.unexpected_keys) - allowed:\r\n        raise RuntimeError(f\"Checkpoint mismatch: {loaded}\")\r\n    model.eval()\r\n\r\n    def capture_scene(module, inputs, output):\r\n        model.probe_scene = output\r\n\r\n    def capture_language(module, inputs, output):\r\n        model.probe_language = output\r\n\r\n    model.dec.ila_ffn_layers[-1].register_forward_hook(capture_scene)\r\n    model.dec.lia_ffn_layers[-1].register_forward_hook(capture_language)\r\n    model.predict_by_feat = types.MethodType(predictor, model)\r\n    rows = []\r\n    mismatch = 0\r\n    for scene in range(min(args.scenes, len(dataset))):\r\n        batch = dataset.collate_fn([dataset[scene]])\r\n        model.probe_token_mask = batch[\"lang_masks\"].cuda()\r\n        with torch.no_grad():\r\n            first = model(batch, mode=\"predict\")[\"rows\"]\r\n            repeat = model(batch, mode=\"predict\")[\"rows\"]\r\n        mismatch += sum(\r\n            abs(a[\"selected_token\"] - b[\"selected_token\"]) > 1e-4\r\n            or a[\"selected_iou\"] != b[\"selected_iou\"]\r\n            for a, b in zip(first, repeat)\r\n        )\r\n        rows.extend(first)\r\n    errors = [r for r in rows if r[\"oracle_iou\"] - r[\"selected_iou\"] > 0.05]\r\n    result = {\r\n        \"scenes\": min(args.scenes, len(dataset)),\r\n        \"expressions\": len(rows),\r\n        \"material_errors\": len(errors),\r\n        \"repeat_mismatch\": mismatch,\r\n        \"oracle_token_higher\": sum(r[\"oracle_token\"] > r[\"selected_token\"] for r in errors),\r\n        \"oracle_shifted_higher\": sum(\r\n            r[\"oracle_shifted\"] > r[\"selected_shifted\"] for r in errors\r\n        ),\r\n        \"indicator_miou\": statistics.fmean(r[\"selected_iou\"] for r in rows),\r\n        \"token_only_miou\": statistics.fmean(r[\"token_only_iou\"] for r in rows),\r\n        \"shifted_only_miou\": statistics.fmean(r[\"shifted_only_iou\"] for r in rows),\r\n        \"peak_reserved_gib\": torch.cuda.max_memory_reserved() / 2**30,\r\n        \"rows\": rows,\r\n    }\r\n    Path(args.output).write_text(json.dumps(result, indent=2), encoding=\"utf-8\")\r\n    print(json.dumps({k: v for k, v in result.items() if k != \"rows\"}))\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"\"C:\\\\Users\\\\chuanle song\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\pwsh.exe\" -Command 'Get-Content pipeline/reviews/motivation_review_20260927-010000.md -Raw; Get-Content pipeline/decisions/20260926-235952_route_change.md -Raw; Get-Content pipeline/decisions/20260926-233033_route_change.md -Raw'","aggregated_output":"# Motivation Review - AdaRES_project\n\n2026-09-27 01:00 Asia/Shanghai\n\n## 1. Goal\nAdaRES: improve a faithful standard-indicator 3D referring expression segmentation baseline by learning query confidence from metric-aligned evidence, targeting ScanRefer mIoU >= 0.515. B1 0.5020; B4-E30 0.5094; gap 0.0056. Goal constraints and bans checked: server-2 GPU0/1 only, single-GPU tasks, released backbone and project decoder, fixed B2/B4 continuation, required metrics and resources, no validation scans.\n\n## 2. Story Status\nQuery competition has a positive B4 result but misses the target. Existing overlap, mask geometry, modality perturbation and pooled-language directions were negative. U1 tests direct cross-modal agreement; U2 tests token-resolved mask-language evidence, not pooled-language contrast.\n\n## 3. Experiment Assessment\nB4-E30 remains champion 0.5094. U1/U2 are fixed train64 native inference diagnostics, not trained experiments or validation estimates. U1 oracle ordering 148/388 versus outside 207/388; U2 179/388 versus shifted-language 182/388.\n\n## 4. Gap Analysis\nNeither signal distinguishes missed oracles from wrong selections reliably. Active-query, latency and training peak-memory metrics remain unmeasured for unadmitted variants.\n\n## 5. Design Rationale\nIndependent cross-modal and token-specific routes tested with predeclared controls. Both failed before backward and resource checks; extending them by numerical fusion or token subset scans would not repair the causal evidence.\n\n## 6. Next Batch\nNo admission. Seek a new inference-valid mechanism with native paired diagnosis/control, backward, resource and independence gates; do not rename U1/U2 or tune on validation.\n\r\n# AdaRES_project 决策记录\n\n- **时间**: 2026-09-26 23:59:52\n- **类型**: route_change\n- **问题**: T1/T2 fixed native train64: admit either vacant server-2 slot?\n- **决策**: Reject T1 competitor-removal and T2 local-3D top-two; leave GPU0/1 unqueued\n- **依据**: T1 0.82133 vs B4 0.82256; T2 0.81370 vs B4 0.82256 and outside 0.82307; diagnosis/controls fail\n- **证据**: pipeline/analyses/AdaRES-T1-T2_diagnosis_20260926-235700.md; pipeline/research_work.json\n\r\n# AdaRES_project 决策记录\n\n- **时间**: 2026-09-26 23:30:33\n- **类型**: route_change\n- **问题**: S1/S2 fixed native train64: admit either of two vacant server-2 slots?\n- **决策**: Reject order-average S1 and local-2D top-two S2; leave server-2 GPU0/1 unqueued\n- **依据**: S1 0.80927 vs B4 0.82256; S2 0.82007 vs B4 0.82256 and outside control 0.82271; neither clears diagnosis/control gates\n- **证据**: pipeline/analyses/AdaRES-S1-S2_diagnosis_20260926-232500.md; pipeline/research_work.json\n\r\n","exit_code":0,"status":"completed"}}
