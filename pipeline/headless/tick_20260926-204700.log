{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"\"C:\\\\Users\\\\chuanle song\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\pwsh.exe\" -Command 'Get-Content AdaRES/tools/diagnose_adares_p1_fragmentation.py -TotalCount 320; Get-Content AdaRES/tools/diagnose_adares_p2_confidence_trajectory.py -TotalCount 280'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"\"C:\\\\Users\\\\chuanle song\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\pwsh.exe\" -Command 'Get-Content AdaRES/ipdn/model_paper5/adares_b4_query_competition/dec.py -TotalCount 350'","aggregated_output":"import torch\r\nimport torch.nn as nn\r\nfrom .sample_model import SamplingModule\r\nimport ipdn.torch.nn_new.functional as F\r\nfrom ipdn.torch.nn_new import MultiheadAttention\r\n\r\nclass ThreeLayerMLP(nn.Module):\r\n    \"\"\"A 3-layer MLP with normalization and dropout.\"\"\"\r\n\r\n    def __init__(self, dim, out_dim):\r\n        super().__init__()\r\n        self.net = nn.Sequential(\r\n            nn.Conv1d(dim, dim, 1, bias=False),\r\n            nn.BatchNorm1d(dim),\r\n            nn.ReLU(),\r\n            nn.Dropout(0.3),\r\n            nn.Conv1d(dim, dim, 1, bias=False),\r\n            nn.BatchNorm1d(dim),\r\n            nn.ReLU(),\r\n            nn.Dropout(0.3),\r\n            nn.Conv1d(dim, out_dim, 1)\r\n        )\r\n\r\n    def forward(self, x):\r\n        \"\"\"Forward pass, x can be (B, dim, N).\"\"\"\r\n        return self.net(x)\r\n\r\nclass CrossAttentionLayer(nn.Module):\r\n\r\n    def __init__(self, d_model=256, nhead=8, dropout=0.0):\r\n        super().__init__()\r\n        self.attn = MultiheadAttention(d_model, nhead, dropout=dropout, batch_first=True)\r\n        self.norm = nn.LayerNorm(d_model)\r\n        self.dropout = nn.Dropout(dropout)\r\n        self._reset_parameters()\r\n        self.nhead = nhead\r\n\r\n    def _reset_parameters(self):\r\n        for p in self.parameters():\r\n            if p.dim() > 1:\r\n                nn.init.xavier_uniform_(p)\r\n\r\n    def with_pos_embed(self, tensor, pos):\r\n        return tensor if pos is None else tensor + pos\r\n\r\n    def forward(self, source, query, batch_mask=None, attn_mask=None, pe=None, att_weights=None):\r\n        \"\"\"\r\n        source (B, N_p, d_model)\r\n        batch_offsets Tensor (b, n_p)\r\n        query Tensor (b, n_q, d_model)\r\n        attn_masks Tensor (b, n_q, n_p)\r\n        \"\"\"\r\n        B = query.shape[0]\r\n        query = self.with_pos_embed(query, pe)\r\n        k = v = source\r\n        if attn_mask is not None:\r\n            attn_mask = attn_mask.unsqueeze(1).repeat(1, self.nhead, 1, 1).view(B*self.nhead, query.shape[1], k.shape[1])\r\n            output, output_weight, src_weight = self.attn(query, k, v, key_padding_mask=batch_mask, attn_mask=attn_mask, att_weights =att_weights)  # (1, 100, d_model)\r\n        else:\r\n            output, output_weight, src_weight = self.attn(query, k, v, key_padding_mask=batch_mask, att_weights =att_weights)\r\n        self.dropout(output)\r\n        output = output + query\r\n        self.norm(output)\r\n\r\n        return output, output_weight, src_weight # (b, n_q, d_model), (b, n_q, n_v)\r\n\r\nclass SelfAttentionLayer(nn.Module):\r\n\r\n    def __init__(self, d_model=256, nhead=8, dropout=0.0, glu = False):\r\n        super().__init__()\r\n        self.attn = MultiheadAttention(\r\n            d_model,\r\n            nhead,\r\n            dropout=dropout,\r\n            batch_first=True,\r\n        )\r\n        self.nhead = nhead\r\n        self.norm = nn.LayerNorm(d_model)\r\n        self.dropout = nn.Dropout(dropout)\r\n        self.glu = glu\r\n        if glu:\r\n            self.glu_p = nn.Linear(d_model, d_model)\r\n            self.glu_g = nn.Linear(d_model, d_model)\r\n\r\n    def with_pos_embed(self, tensor, pos):\r\n        return tensor if pos is None else tensor + pos\r\n\r\n    def forward(self, x, x_mask=None, attn_mask=None, pe=None, norm=True, att_weights=None):\r\n        \"\"\"\r\n        x Tensor (b, n_w, c)\r\n        x_mask Tensor (b, n_w)\r\n        \"\"\"\r\n        B = x.shape[0]\r\n        q = k = self.with_pos_embed(x, pe)\r\n        if attn_mask is not None:\r\n            attn_mask = attn_mask.unsqueeze(1).repeat(1, self.nhead, 1, 1).view(B*self.nhead, q.shape[1], k.shape[1])\r\n            output, output_weight, src_weight = self.attn(q, k, x, key_padding_mask=x_mask, attn_mask=attn_mask, att_weights =att_weights)  # (1, 100, d_model)\r\n        else:\r\n            output, output_weight, src_weight = self.attn(q, k, x, key_padding_mask=x_mask, att_weights =att_weights)\r\n        if self.glu:\r\n            output = self.glu_p(output) * (self.glu_g(output).sigmoid())\r\n        output = self.dropout(output) + x\r\n        if norm: output = self.norm(output)\r\n        return output\r\n\r\nclass FFN(nn.Module):\r\n\r\n    def __init__(self, d_model, hidden_dim, dropout=0.0, activation_fn='relu'):\r\n        super().__init__()\r\n        if activation_fn == 'relu':\r\n            self.net = nn.Sequential(\r\n                nn.Linear(d_model, hidden_dim),\r\n                nn.ReLU(),\r\n                nn.Dropout(dropout),\r\n                nn.Linear(hidden_dim, d_model),\r\n                nn.Dropout(dropout),\r\n            )\r\n        elif activation_fn == 'gelu':\r\n            self.net = nn.Sequential(\r\n                nn.Linear(d_model, hidden_dim),\r\n                nn.GELU(),\r\n                nn.Dropout(dropout),\r\n                nn.Linear(hidden_dim, d_model),\r\n                nn.Dropout(dropout),\r\n            )\r\n        self.norm = nn.LayerNorm(d_model)\r\n\r\n    def forward(self, x, norm=True):\r\n        output = self.net(x)\r\n        output = output + x\r\n        if norm: output = self.norm(output)\r\n        return output\r\n\r\nclass MLP(nn.Module):\r\n    \"\"\" Very simple multi-layer perceptron (also called FFN)\"\"\"\r\n\r\n    def __init__(self, input_dim, hidden_dim, output_dim, num_layers):\r\n        super().__init__()\r\n        self.num_layers = num_layers\r\n        h = [hidden_dim] * (num_layers - 1)\r\n        self.layers = nn.ModuleList(nn.Linear(n, k) for n, k in zip([input_dim] + h, h + [output_dim]))\r\n\r\n    def forward(self, x):\r\n        for i, layer in enumerate(self.layers):\r\n            x = F.relu(layer(x)) if i < self.num_layers - 1 else layer(x)\r\n        return x\r\n\r\n\r\nclass QueryCompetitionIndicator(nn.Module):\r\n    \"\"\"Predict confidence from a query and its overlapping competitors.\"\"\"\r\n\r\n    def __init__(self, d_model):\r\n        super().__init__()\r\n        self.query_norm = nn.LayerNorm(d_model)\r\n        self.evidence_norm = nn.LayerNorm(3 * d_model + 1)\r\n        self.head = nn.Sequential(\r\n            nn.Linear(3 * d_model + 1, d_model),\r\n            nn.GELU(),\r\n            nn.Linear(d_model, d_model),\r\n            nn.GELU(),\r\n            nn.Linear(d_model, 2),\r\n        )\r\n\r\n    def forward(self, query, pred_masks, batch_mask):\r\n        valid = (~batch_mask).unsqueeze(1).to(pred_masks.dtype)\r\n        probabilities = pred_masks.sigmoid() * valid\r\n        areas = probabilities.sum(-1)\r\n        intersection = torch.einsum(\r\n            'bim,bjm->bij', probabilities, probabilities\r\n        )\r\n        union = areas.unsqueeze(-1) + areas.unsqueeze(1) - intersection\r\n        overlap = intersection / union.clamp_min(1e-6)\r\n        diagonal = torch.eye(\r\n            overlap.shape[-1], dtype=torch.bool, device=overlap.device\r\n        ).unsqueeze(0)\r\n        overlap = overlap.masked_fill(diagonal, 0.0)\r\n\r\n        competition = overlap / overlap.sum(-1, keepdim=True).clamp_min(1e-6)\r\n        normalized_query = self.query_norm(query)\r\n        context = torch.einsum('bij,bjd->bid', competition, normalized_query)\r\n        max_overlap = overlap.max(-1).values.unsqueeze(-1)\r\n        evidence = torch.cat(\r\n            [\r\n                normalized_query,\r\n                context,\r\n                normalized_query - context,\r\n                max_overlap,\r\n            ],\r\n            dim=-1,\r\n        )\r\n        return self.head(self.evidence_norm(evidence))\r\n    \r\n    \r\nclass DEC(nn.Module):\r\n    \"\"\"\r\n    in_channels List[int] (4,) [64,96,128,160]\r\n    \"\"\"\r\n    def __init__(\r\n        self,\r\n        num_layer=6,\r\n        num_class=256,\r\n        in_channel=32,\r\n        d_model=256,\r\n        nhead=8,\r\n        hidden_dim=1024,\r\n        dropout=0.0,\r\n        activation_fn='relu',\r\n        iter_pred=False,\r\n        attn_mask=False,\r\n        sampling_module=None,\r\n        kernel='top1',\r\n        global_feat='mean',\r\n        lang_att=False,\r\n        contrastive_align_loss=False,\r\n        num_proposal_fine=512,\r\n        num_proposal_query = [128,64,32,16,8,4],\r\n        num_proposal_query_inst = [128,64,32,16,8,4]\r\n    ):\r\n        super().__init__()\r\n        self.num_layer = num_layer\r\n        self.num_class = num_class\r\n        self.d_model = d_model\r\n        self.input_proj = nn.Sequential(nn.Linear(in_channel, d_model), nn.LayerNorm(d_model), nn.ReLU())\r\n        \r\n        self.input_proj_2d = nn.Sequential(nn.Linear(1024, d_model*2),nn.ReLU(),nn.Linear(d_model*2, d_model),nn.ReLU(),nn.Linear(d_model, d_model))#clip\r\n        self.sum_norm = nn.LayerNorm(d_model)\r\n        \r\n        self.lang_att = lang_att\r\n        self.contrastive_align_loss = contrastive_align_loss\r\n\r\n        H = 768\r\n        self.lang_proj = nn.Linear(H, d_model)\r\n        self.lang_norm = nn.LayerNorm(d_model)\r\n        \r\n        if sampling_module is not None:\r\n            self.sampling_module = SamplingModule(**sampling_module)\r\n        else:\r\n            self.sampling_module = None\r\n        self.num_proposal_fine = num_proposal_fine\r\n        self.num_proposal_query = num_proposal_query\r\n        self.num_proposal_query_inst = num_proposal_query_inst\r\n        self.query_generator = nn.Sequential(nn.Linear(d_model, d_model),nn.ReLU(),nn.Linear(d_model, d_model),nn.ReLU(),nn.Linear(d_model, d_model))\r\n        \r\n        # DDI and SWA\r\n        self.qia_layers = nn.ModuleList([])\r\n        self.qia_layers_fine = nn.ModuleList([])\r\n        self.qla_layers = nn.ModuleList([])\r\n        self.qqa_layers = nn.ModuleList([])\r\n        self.qqa_ffn_layers = nn.ModuleList([])\r\n        self.qia_ffn_layers = nn.ModuleList([])\r\n        self.sem_cls_heads = nn.ModuleList([])\r\n        # self.scg = nn.ModuleList([])\r\n        self.lqg = nn.ModuleList([])\r\n        if self.lang_att:\r\n            self.lla_layers = nn.ModuleList([])\r\n            self.lia_layers = nn.ModuleList([])\r\n            self.ila_layers = nn.ModuleList([])\r\n            self.lia_ffn_layers = nn.ModuleList([])\r\n            self.ila_ffn_layers = nn.ModuleList([])\r\n        for i in range(num_layer):\r\n            self.qia_layers.append(CrossAttentionLayer(d_model, nhead, dropout))\r\n            self.qia_layers_fine.append(CrossAttentionLayer(d_model, nhead, dropout))\r\n            self.qla_layers.append(CrossAttentionLayer(d_model, nhead, dropout))\r\n            self.qqa_layers.append(SelfAttentionLayer(d_model, nhead, dropout))\r\n            self.qqa_ffn_layers.append(FFN(d_model, hidden_dim, dropout, activation_fn))\r\n            self.qia_ffn_layers.append(FFN(d_model, hidden_dim, dropout, activation_fn))\r\n            \r\n            self.sem_cls_heads.append(ThreeLayerMLP(d_model, self.num_class))\r\n            # self.scg.append(SelfAttentionLayer(d_model, nhead, dropout))\r\n            self.lqg.append(CrossAttentionLayer(d_model, nhead, dropout))\r\n\r\n            self.lla_layers.append(SelfAttentionLayer(d_model, nhead, dropout))\r\n            self.lia_layers.append(CrossAttentionLayer(d_model, nhead, dropout))\r\n            self.ila_layers.append(CrossAttentionLayer(d_model, nhead, dropout))\r\n            self.lia_ffn_layers.append(FFN(d_model, hidden_dim, dropout, activation_fn))    \r\n            self.ila_ffn_layers.append(FFN(d_model, hidden_dim, dropout, activation_fn))    \r\n        self.norm_qqa = nn.LayerNorm(d_model)\r\n\r\n        self.sem_cls_head = ThreeLayerMLP(d_model, self.num_class)\r\n\r\n        self.out_norm = nn.LayerNorm(d_model)\r\n        self.out_score = nn.Sequential(nn.Linear(d_model, d_model), nn.ReLU(), nn.Linear(d_model, 1))\r\n        self.x_mask = nn.Sequential(nn.Linear(in_channel, d_model), nn.ReLU(), nn.Linear(d_model, d_model))\r\n        \r\n        self.indi_embedding = QueryCompetitionIndicator(d_model)\r\n        self.indi_norm = nn.LayerNorm(d_model)\r\n\r\n        self.iter_pred = iter_pred\r\n        self.attn_mask = attn_mask\r\n\r\n        \r\n\r\n        # Extra layers for contrastive losses\r\n        if contrastive_align_loss:\r\n            self.contrastive_align_projection_vision = nn.Sequential(nn.Linear(d_model, d_model),nn.ReLU(),nn.Linear(d_model, d_model),nn.ReLU(),nn.Linear(d_model, 64))\r\n            self.contrastive_align_projection_text = nn.Sequential(nn.Linear(d_model, d_model),nn.ReLU(),nn.Linear(d_model, d_model),nn.ReLU(),nn.Linear(d_model, 64))         \r\n        \r\n        self.scg_head = SelfAttentionLayer(d_model, nhead, dropout=0, glu=True)\r\n        \r\n    \r\n    def forward_iter_pred(self, x, fps_seed_sp, batch_offsets, lang_feats=None, lang_masks=None, sp_pos=None, feats_2d=None):\r\n        \"\"\"\r\n        x [B*M, inchannel]\r\n        \"\"\"\r\n        \r\n        lang_feats = self.lang_proj(lang_feats) \r\n        lang_feats = self.lang_norm(lang_feats)  \r\n        lang_masks = ~(lang_masks.bool())\r\n        inst_feats = self.input_proj(x)\r\n        \r\n        inst_feats_2d = self.input_proj_2d(feats_2d)\r\n        inst_feats = self.sum_norm(inst_feats+inst_feats_2d)\r\n        \r\n        mask_feats = self.x_mask(x)\r\n        inst_feats, batch_mask = self.get_batches(inst_feats, batch_offsets)\r\n        mask_feats, _ = self.get_batches(mask_feats, batch_offsets)\r\n        \r\n        sp_pos, _ = self.get_batches(sp_pos, batch_offsets)\r\n        \r\n        prediction_masks, prediction_scores, prediction_indis = [], [], []\r\n        \r\n        sample_inds = None\r\n        ref_scores = None\r\n         \r\n        seed_sp = inst_feats.gather(dim=1, index=fps_seed_sp.long().unsqueeze(-1).repeat(1, 1, inst_feats.size(-1)))\r\n        seed_sp_pos = sp_pos.gather(dim=1, index=fps_seed_sp.long().unsqueeze(-1).repeat(1, 1, sp_pos.size(-1)))\r\n        \r\n        scg_weights,scg_mask = self.get_scg_weight(seed_sp_pos)\r\n        # print(scg_weights)\r\n        # print(scg_weights.size())\r\n        # pp\r\n        # seed_sp = self.scg_head(seed_sp, seed_sp, seed_sp, attention_weights = scg_weights)\r\n        seed_sp = self.scg_head(seed_sp, att_weights = scg_weights)\r\n\r\n         # sampling\r\n        if hasattr(self, 'sampling_module') and self.sampling_module is not None:\r\n            sample_inds, ref_scores = self.sampling_module(seed_sp, lang_feats, None, lang_masks)\r\n            sample_inds = sample_inds.long()\r\n            sampled_seed = seed_sp.gather(dim=1, index=sample_inds.unsqueeze(-1).repeat(1, 1, seed_sp.size(-1)))\r\n            query_pos = seed_sp_pos.gather(dim=1, index=sample_inds.unsqueeze(-1).repeat(1, 1, seed_sp_pos.size(-1)))\r\n            query = self.query_generator(sampled_seed)\r\n        else:\r\n            query = self.query_generator(seed_sp)\r\n            query_pos = seed_sp_pos\r\n            \r\n        # scg_weights = self.get_scg_weight(query_pos)\r\n\r\n        proj_queries = []\r\n        if self.contrastive_align_loss:\r\n            proj_queries.append(F.normalize(self.contrastive_align_projection_vision(query), p=2, dim=-1))\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"\"C:\\\\Users\\\\chuanle song\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\pwsh.exe\" -Command 'Get-Content AdaRES/tools/diagnose_adares_p1_fragmentation.py -TotalCount 320; Get-Content AdaRES/tools/diagnose_adares_p2_confidence_trajectory.py -TotalCount 280'","aggregated_output":"import argparse\r\nimport json\r\nimport statistics\r\nimport sys\r\nimport types\r\nfrom pathlib import Path\r\n\r\nimport gorilla\r\nimport torch\r\nimport torch.nn.functional as F\r\n\r\nROOT = Path(__file__).resolve().parents[1]\r\nsys.path.insert(0, str(ROOT))\r\n\r\nfrom ipdn.dataset import build_dataset\r\nfrom ipdn.model_paper5.adares_b4_query_competition import IPDN\r\nfrom ipdn.utils import get_root_logger\r\n\r\n\r\ndef component_fraction(mask, neighbors):\r\n    foreground = mask.nonzero(as_tuple=True)[0].tolist()\r\n    if not foreground:\r\n        return 0.0\r\n    active = set(foreground)\r\n    seen = set()\r\n    largest = 0\r\n    for start in foreground:\r\n        if start in seen:\r\n            continue\r\n        stack = [start]\r\n        seen.add(start)\r\n        size = 0\r\n        while stack:\r\n            current = stack.pop()\r\n            size += 1\r\n            for neighbor in neighbors[current]:\r\n                if neighbor in active and neighbor not in seen:\r\n                    seen.add(neighbor)\r\n                    stack.append(neighbor)\r\n        largest = max(largest, size)\r\n    return largest / len(foreground)\r\n\r\n\r\ndef predictor(self, scan_ids, object_idss, ann_ids, out, superpoints,\r\n              gt_pmasks, gt_spmasks, fps_seed_sp):\r\n    rows = []\r\n    for index, target in enumerate(gt_pmasks):\r\n        valid = ~out[\"batch_mask\"][index]\r\n        coords = self.probe_coords[index, valid]\r\n        count = coords.shape[0]\r\n        nearest = torch.cdist(coords, coords).topk(\r\n            min(9, count), largest=False\r\n        ).indices[:, 1:].tolist()\r\n        neighbors = [set(row) for row in nearest]\r\n        for source, row in enumerate(nearest):\r\n            for destination in row:\r\n                neighbors[destination].add(source)\r\n        masks = out[\"masks\"][index, :, valid].sigmoid().gt(0.5)\r\n        point_masks = out[\"masks\"][index].sigmoid().gt(0.5)[:, superpoints]\r\n        truth = target.gt(0.5).to(point_masks.device)\r\n        ious = (point_masks & truth).sum(-1).float() / (\r\n            (point_masks | truth).sum(-1).clamp_min(1).float()\r\n        )\r\n        confidence = F.softmax(out[\"indis\"][index], dim=-1)[:, 1]\r\n        selected = int(confidence.argmax())\r\n        oracle = int(ious.argmax())\r\n        fractions = [\r\n            component_fraction(mask.cpu(), neighbors) for mask in masks\r\n        ]\r\n        rows.append({\r\n            \"selected\": selected,\r\n            \"selected_iou\": float(ious[selected]),\r\n            \"oracle_iou\": float(ious[oracle]),\r\n            \"selected_fraction\": fractions[selected],\r\n            \"oracle_fraction\": fractions[oracle],\r\n            \"fraction_only_iou\": float(ious[max(\r\n                range(len(fractions)), key=fractions.__getitem__\r\n            )]),\r\n        })\r\n    return {\"rows\": rows}\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser()\r\n    parser.add_argument(\"config\")\r\n    parser.add_argument(\"checkpoint\")\r\n    parser.add_argument(\"--output\", required=True)\r\n    parser.add_argument(\"--scenes\", type=int, default=16)\r\n    parser.add_argument(\"--gpu-id\", type=int, default=0)\r\n    args = parser.parse_args()\r\n    gorilla.set_cuda_visible_devices([args.gpu_id], 1)\r\n    gorilla.set_random_seed(1999)\r\n    cfg = gorilla.Config.fromfile(args.config)\r\n    data_cfg = cfg.data.train.copy()\r\n    data_cfg.training = False\r\n    data_cfg.aug = False\r\n    data_cfg.with_elastic = False\r\n    data_cfg.lang_num_max = 32\r\n    dataset = build_dataset(data_cfg, get_root_logger())\r\n    model = IPDN(**cfg.model).cuda()\r\n    checkpoint = torch.load(args.checkpoint, map_location=\"cpu\")\r\n    loaded = model.load_state_dict(checkpoint.get(\"model\", checkpoint), strict=False)\r\n    allowed = {\"text_encoder.embeddings.position_ids\",\r\n               \"text_encoder.embeddings.token_type_ids\"}\r\n    if loaded.missing_keys or set(loaded.unexpected_keys) - allowed:\r\n        raise RuntimeError(f\"Checkpoint mismatch: {loaded}\")\r\n    model.eval()\r\n\r\n    def capture_coords(module, inputs):\r\n        model.probe_coords = module.get_batches(inputs[5], inputs[2])[0]\r\n\r\n    model.dec.register_forward_pre_hook(capture_coords)\r\n    model.predict_by_feat = types.MethodType(predictor, model)\r\n    rows = []\r\n    repeat_mismatch = 0\r\n    for scene in range(min(args.scenes, len(dataset))):\r\n        batch = dataset.collate_fn([dataset[scene]])\r\n        with torch.no_grad():\r\n            base = model(batch, mode=\"predict\")[\"rows\"]\r\n            repeat = model(batch, mode=\"predict\")[\"rows\"]\r\n        repeat_mismatch += sum(a != b for a, b in zip(base, repeat))\r\n        rows.extend(base)\r\n    errors = [r for r in rows if r[\"oracle_iou\"] - r[\"selected_iou\"] > 0.05]\r\n    result = {\r\n        \"scenes\": min(args.scenes, len(dataset)),\r\n        \"expressions\": len(rows),\r\n        \"material_errors\": len(errors),\r\n        \"repeat_mismatch\": repeat_mismatch,\r\n        \"oracle_more_connected\": sum(\r\n            r[\"oracle_fraction\"] > r[\"selected_fraction\"] for r in errors\r\n        ),\r\n        \"selected_fraction_mean\": statistics.fmean(\r\n            r[\"selected_fraction\"] for r in errors\r\n        ) if errors else None,\r\n        \"oracle_fraction_mean\": statistics.fmean(\r\n            r[\"oracle_fraction\"] for r in errors\r\n        ) if errors else None,\r\n        \"indicator_miou\": statistics.fmean(r[\"selected_iou\"] for r in rows),\r\n        \"fraction_only_miou\": statistics.fmean(\r\n            r[\"fraction_only_iou\"] for r in rows\r\n        ),\r\n        \"peak_reserved_gib\": torch.cuda.max_memory_reserved() / 2**30,\r\n        \"rows\": rows,\r\n    }\r\n    Path(args.output).write_text(json.dumps(result, indent=2), encoding=\"utf-8\")\r\n    print(json.dumps({k: v for k, v in result.items() if k != \"rows\"}))\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\nimport argparse\r\nimport json\r\nimport statistics\r\nimport sys\r\nimport types\r\nfrom pathlib import Path\r\n\r\nimport gorilla\r\nimport torch\r\nimport torch.nn.functional as F\r\n\r\nROOT = Path(__file__).resolve().parents[1]\r\nsys.path.insert(0, str(ROOT))\r\n\r\nfrom ipdn.dataset import build_dataset\r\nfrom ipdn.model_paper5.adares_b4_query_competition import IPDN\r\nfrom ipdn.utils import get_root_logger\r\n\r\n\r\ndef predictor(self, scan_ids, object_idss, ann_ids, out, superpoints,\r\n              gt_pmasks, gt_spmasks, fps_seed_sp):\r\n    previous = out[\"aux_outputs\"][-1][\"indis\"]\r\n    rows = []\r\n    for index, target in enumerate(gt_pmasks):\r\n        point_masks = out[\"masks\"][index].sigmoid().gt(0.5)[:, superpoints]\r\n        truth = target.gt(0.5).to(point_masks.device)\r\n        ious = (point_masks & truth).sum(-1).float() / (\r\n            (point_masks | truth).sum(-1).clamp_min(1).float()\r\n        )\r\n        final = F.softmax(out[\"indis\"][index], dim=-1)[:, 1]\r\n        prior = F.softmax(previous[index], dim=-1)[:, 1]\r\n        selected, previous_selected, oracle = (\r\n            int(final.argmax()), int(prior.argmax()), int(ious.argmax())\r\n        )\r\n        rows.append({\r\n            \"selected\": selected,\r\n            \"previous_selected\": previous_selected,\r\n            \"selected_iou\": float(ious[selected]),\r\n            \"previous_iou\": float(ious[previous_selected]),\r\n            \"oracle_iou\": float(ious[oracle]),\r\n            \"oracle_final_rank\": int((final > final[oracle]).sum()) + 1,\r\n            \"oracle_previous_rank\": int((prior > prior[oracle]).sum()) + 1,\r\n            \"final_margin\": float(final[selected] - final[oracle]),\r\n            \"previous_margin\": float(prior[selected] - prior[oracle]),\r\n        })\r\n    return {\"rows\": rows}\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser()\r\n    parser.add_argument(\"config\")\r\n    parser.add_argument(\"checkpoint\")\r\n    parser.add_argument(\"--output\", required=True)\r\n    parser.add_argument(\"--scenes\", type=int, default=16)\r\n    parser.add_argument(\"--gpu-id\", type=int, default=0)\r\n    args = parser.parse_args()\r\n    gorilla.set_cuda_visible_devices([args.gpu_id], 1)\r\n    gorilla.set_random_seed(1999)\r\n    cfg = gorilla.Config.fromfile(args.config)\r\n    data_cfg = cfg.data.train.copy()\r\n    data_cfg.training = False\r\n    data_cfg.aug = False\r\n    data_cfg.with_elastic = False\r\n    data_cfg.lang_num_max = 32\r\n    dataset = build_dataset(data_cfg, get_root_logger())\r\n    model = IPDN(**cfg.model).cuda()\r\n    checkpoint = torch.load(args.checkpoint, map_location=\"cpu\")\r\n    loaded = model.load_state_dict(checkpoint.get(\"model\", checkpoint), strict=False)\r\n    allowed = {\"text_encoder.embeddings.position_ids\",\r\n               \"text_encoder.embeddings.token_type_ids\"}\r\n    if loaded.missing_keys or set(loaded.unexpected_keys) - allowed:\r\n        raise RuntimeError(f\"Checkpoint mismatch: {loaded}\")\r\n    model.eval()\r\n    model.predict_by_feat = types.MethodType(predictor, model)\r\n    rows = []\r\n    repeat_mismatch = 0\r\n    for scene in range(min(args.scenes, len(dataset))):\r\n        batch = dataset.collate_fn([dataset[scene]])\r\n        with torch.no_grad():\r\n            base = model(batch, mode=\"predict\")[\"rows\"]\r\n            repeat = model(batch, mode=\"predict\")[\"rows\"]\r\n        repeat_mismatch += sum(\r\n            a[\"selected\"] != b[\"selected\"]\r\n            or a[\"previous_selected\"] != b[\"previous_selected\"]\r\n            or abs(a[\"selected_iou\"] - b[\"selected_iou\"]) > 1e-6\r\n            or abs(a[\"previous_iou\"] - b[\"previous_iou\"]) > 1e-6\r\n            for a, b in zip(base, repeat)\r\n        )\r\n        rows.extend(base)\r\n    errors = [r for r in rows if r[\"oracle_iou\"] - r[\"selected_iou\"] > 0.05]\r\n    result = {\r\n        \"scenes\": min(args.scenes, len(dataset)),\r\n        \"expressions\": len(rows),\r\n        \"material_errors\": len(errors),\r\n        \"repeat_mismatch\": repeat_mismatch,\r\n        \"selection_changed\": sum(\r\n            r[\"selected\"] != r[\"previous_selected\"] for r in rows\r\n        ),\r\n        \"previous_recovers_error\": sum(\r\n            r[\"previous_iou\"] > r[\"selected_iou\"] + 0.05 for r in errors\r\n        ),\r\n        \"previous_harms_correct\": sum(\r\n            r[\"previous_iou\"] + 0.05 < r[\"selected_iou\"]\r\n            for r in rows if r not in errors\r\n        ),\r\n        \"oracle_previous_rank_better\": sum(\r\n            r[\"oracle_previous_rank\"] < r[\"oracle_final_rank\"] for r in errors\r\n        ),\r\n        \"oracle_previous_margin_lower\": sum(\r\n            r[\"previous_margin\"] < r[\"final_margin\"] for r in errors\r\n        ),\r\n        \"final_miou\": statistics.fmean(r[\"selected_iou\"] for r in rows),\r\n        \"previous_miou\": statistics.fmean(r[\"previous_iou\"] for r in rows),\r\n        \"peak_reserved_gib\": torch.cuda.max_memory_reserved() / 2**30,\r\n        \"rows\": rows,\r\n    }\r\n    Path(args.output).write_text(json.dumps(result, indent=2), encoding=\"utf-8\")\r\n    print(json.dumps({k: v for k, v in result.items() if k != \"rows\"}))\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n","exit_code":0,"status":"completed"}}
