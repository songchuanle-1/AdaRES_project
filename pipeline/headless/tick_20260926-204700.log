{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"\"C:\\\\Users\\\\chuanle song\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\pwsh.exe\" -Command 'Get-Content AdaRES/tools/diagnose_adares_o2_appearance_counterfactual.py -TotalCount 290; Get-Content AdaRES/configs_song/model_paper5/adares_b4_query_competition_res.yaml -Raw'","aggregated_output":"import argparse\r\nimport json\r\nimport statistics\r\nimport sys\r\nimport types\r\nfrom pathlib import Path\r\n\r\nimport gorilla\r\nimport torch\r\nimport torch.nn.functional as F\r\n\r\nROOT = Path(__file__).resolve().parents[1]\r\nsys.path.insert(0, str(ROOT))\r\n\r\nfrom ipdn.dataset import build_dataset\r\nfrom ipdn.model_paper5.adares_b4_query_competition import IPDN\r\nfrom ipdn.utils import get_root_logger\r\n\r\n\r\ndef predictor(self, scan_ids, object_idss, ann_ids, out, superpoints,\r\n              gt_pmasks, gt_spmasks, fps_seed_sp):\r\n    rows = []\r\n    for index, truth in enumerate(gt_pmasks):\r\n        masks = out[\"masks\"][index].sigmoid().gt(0.5)[:, superpoints]\r\n        target = truth.gt(0.5).to(masks.device)\r\n        ious = (masks & target).sum(-1).float() / (\r\n            (masks | target).sum(-1).clamp_min(1).float()\r\n        )\r\n        confidence = F.softmax(out[\"indis\"][index], dim=-1)[:, 1]\r\n        selected = int(confidence.argmax())\r\n        rows.append({\r\n            \"selected\": selected,\r\n            \"iou\": float(ious[selected]),\r\n            \"oracle_iou\": float(ious.max()),\r\n            \"mask\": torch.where(masks[selected])[0].tolist(),\r\n            \"confidence\": float(confidence[selected]),\r\n        })\r\n    return {\"rows\": rows}\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser()\r\n    parser.add_argument(\"config\")\r\n    parser.add_argument(\"checkpoint\")\r\n    parser.add_argument(\"--output\", required=True)\r\n    parser.add_argument(\"--scenes\", type=int, default=16)\r\n    parser.add_argument(\"--gpu-id\", type=int, default=0)\r\n    parser.add_argument(\"--split\", choices=(\"train\", \"val\"), default=\"train\")\r\n    args = parser.parse_args()\r\n    gorilla.set_cuda_visible_devices([args.gpu_id], 1)\r\n    gorilla.set_random_seed(1999)\r\n    cfg = gorilla.Config.fromfile(args.config)\r\n    data_cfg = getattr(cfg.data, args.split).copy()\r\n    data_cfg.training = False\r\n    data_cfg.aug = False\r\n    data_cfg.with_elastic = False\r\n    data_cfg.lang_num_max = 32\r\n    dataset = build_dataset(data_cfg, get_root_logger())\r\n    model = IPDN(**cfg.model).cuda()\r\n    model.eval()\r\n    checkpoint = torch.load(args.checkpoint, map_location=\"cpu\")\r\n    loaded = model.load_state_dict(checkpoint.get(\"model\", checkpoint), strict=False)\r\n    allowed = {\"text_encoder.embeddings.position_ids\",\r\n               \"text_encoder.embeddings.token_type_ids\"}\r\n    if loaded.missing_keys or set(loaded.unexpected_keys) - allowed:\r\n        raise RuntimeError(f\"Checkpoint mismatch: {loaded}\")\r\n    model.predict_by_feat = types.MethodType(predictor, model)\r\n    rows = []\r\n    for scene in range(min(args.scenes, len(dataset))):\r\n        batch = dataset.collate_fn([dataset[scene]])\r\n        with torch.no_grad():\r\n            base = model(batch, mode=\"predict\")[\"rows\"]\r\n            repeat = model(batch, mode=\"predict\")[\"rows\"]\r\n            batch[\"feats_2d\"] = torch.zeros_like(batch[\"feats_2d\"])\r\n            ablated = model(batch, mode=\"predict\")[\"rows\"]\r\n        for original, control, changed in zip(base, repeat, ablated):\r\n            def overlap(left, right):\r\n                a, b = set(left[\"mask\"]), set(right[\"mask\"])\r\n                return len(a & b) / max(1, len(a | b))\r\n            rows.append({\r\n                \"scene\": scene,\r\n                \"base_iou\": original[\"iou\"],\r\n                \"oracle_iou\": original[\"oracle_iou\"],\r\n                \"repeat_iou\": control[\"iou\"],\r\n                \"counterfactual_iou\": changed[\"iou\"],\r\n                \"repeat_mask_iou\": overlap(original, control),\r\n                \"counterfactual_mask_iou\": overlap(original, changed),\r\n                \"query_flip\": original[\"selected\"] != changed[\"selected\"],\r\n                \"base_confidence\": original[\"confidence\"],\r\n                \"counterfactual_confidence\": changed[\"confidence\"],\r\n            })\r\n    errors = [r for r in rows if r[\"oracle_iou\"] - r[\"base_iou\"] > 0.05]\r\n    correct = [r for r in rows if r[\"oracle_iou\"] - r[\"base_iou\"] <= 0.05]\r\n    result = {\r\n        \"split\": args.split,\r\n        \"scenes\": min(args.scenes, len(dataset)),\r\n        \"expressions\": len(rows),\r\n        \"material_errors\": len(errors),\r\n        \"repeat_mismatch\": sum(r[\"repeat_mask_iou\"] < 1 for r in rows),\r\n        \"flips_errors\": sum(r[\"query_flip\"] for r in errors),\r\n        \"flips_correct\": sum(r[\"query_flip\"] for r in correct),\r\n        \"overlap_errors\": statistics.fmean(r[\"counterfactual_mask_iou\"] for r in errors),\r\n        \"overlap_correct\": statistics.fmean(r[\"counterfactual_mask_iou\"] for r in correct),\r\n        \"base_miou\": statistics.fmean(r[\"base_iou\"] for r in rows),\r\n        \"counterfactual_miou\": statistics.fmean(r[\"counterfactual_iou\"] for r in rows),\r\n        \"peak_reserved_gib\": torch.cuda.max_memory_reserved() / 2**30,\r\n        \"rows\": rows,\r\n    }\r\n    Path(args.output).write_text(json.dumps(result, indent=2), encoding=\"utf-8\")\r\n    print(json.dumps({k: v for k, v in result.items() if k != \"rows\"}))\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\nwork_dir: /bak_home/songcl/Project/AdaRES_project/AdaRES_checkpoints\ntrain:\n  seed: 1999\n  epochs: 30\n  interval: 1\n  pretrain: /bak_home/songcl/3D_visual_grounding/data/ipdn_data/data/sp_unet_backbone.pth\n  save_epoch: 100\n  grad_clip: 0.1\n\ntest:\n  seed: 1999\n  test_topk_per_scene: 100\n  test_score_thresh: 0.0\n  test_npoint_thresh: 100\n\ndataloader:\n  train:\n    batch_size: 2\n    num_workers: 4\n    persistent_workers: True\n  val:\n    batch_size: 1\n    num_workers: 2\n    persistent_workers: True\n  test:\n    batch_size: 1\n    num_workers: 1\n    persistent_workers: True\n\ndata:\n  train:\n    type: scannetv2_sample_graph_edge\n    dataset: scanrefer\n    data_root: /bak_home/songcl/3D_visual_grounding/data/ipdn_data/data/\n    prefix: train\n    suffix: .pth\n    training: True\n    mode: 4\n    aug: True\n    with_elastic: True\n    use_xyz: True\n    voxel_cfg:\n      scale: 50\n      spatial_shape: [128, 512]\n      max_npoint: 2500000\n    max_des_len: 78\n    lang_num_max: 4\n  val:\n    type: scannetv2_sample_graph_edge\n    dataset: scanrefer\n    data_root: /bak_home/songcl/3D_visual_grounding/data/ipdn_data/data/\n    prefix: val\n    suffix: .pth\n    training: False\n    aug: False\n    with_elastic: False\n    use_xyz: True\n    voxel_cfg:\n      scale: 50\n      spatial_shape: [128, 512]\n      max_npoint: 2500000\n    max_des_len: 78\n    lang_num_max: 32\n\nmodel:\n  input_channel: 6\n  blocks: 5\n  block_reps: 2\n  media: 32\n  normalize_before: True\n  return_blocks: True\n  pool: mean\n  infer_mode: sem\n  fps_num: 256\n  task_type: res\n  sampling_module:\n    num_proposal: 128\n    pc_dim: 256\n    lang_dim: 256\n    d_model: 256\n  dec:\n    num_layer: 6\n    d_model: 256\n    nhead: 8\n    hidden_dim: 1024\n    dropout: 0.0\n    activation_fn: gelu\n    iter_pred: True\n    attn_mask: True\n    kernel: top1\n    global_feat: mean\n    lang_att: True\n    contrastive_align_loss: True\n    num_proposal_fine: 512\n    num_proposal_query: [128, 64, 32, 16, 8, 4]\n    num_proposal_query_inst: [128, 64, 32, 16, 8, 4]\n  criterion:\n    loss_weight: [1.0, 1.0, 0.5, 5.0, 0.1, 0.1, 0.1, 1.0]\n    cost_weight: [1.0, 1.0, 0.1]\n    loss_fun: focal\n    match_last_layer: True\n    layer_differ_weight: True\n  test_cfg:\n    topk_insts: 100\n    score_thr: 0.0\n    npoint_thr: 100\n  norm_eval: False\n  fix_module: ['text_encoder']\n\noptimizer:\n  type: AdamW\n  lr: 0.0001\n  weight_decay: 0.0005\n  paramwise_cfg:\n   text_encoder:\n     lr_mult: 0.001\n   input_conv:\n     lr_mult: 0.01\n   unet:\n     lr_mult: 0.01\n   output_layer:\n     lr_mult: 0.01\n   dec:\n     lr_mult: 1.0\n\nlr_scheduler:\n  type: PolyLR\n  max_iters: 70\n  power: 4.0\n  constant_ending: 0.0\n\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"\"C:\\\\Users\\\\chuanle song\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\pwsh.exe\" -Command 'Get-Content AdaRES/ipdn/model_paper5/adares_b4_query_competition/model.py -TotalCount 260; Get-Content AdaRES/ipdn/model_paper5/adares_b4_query_competition/dec.py | Select-Object -Skip 345 -First 145'","aggregated_output":"Get-Content: \r\nLine |\r\n   2 |  Get-Content AdaRES/ipdn/model_paper5/adares_b4_query_competition/mode …\r\n     |  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\r\n     | 找不到路径“D:\\project\\AdaRES_project\\AdaRES\\ipdn\\model_paper5\\adares_b4_query_competition\\model.py”，因为该路径不存在。\r\n        # scg_weights = self.get_scg_weight(query_pos)\r\n\r\n        proj_queries = []\r\n        if self.contrastive_align_loss:\r\n            proj_queries.append(F.normalize(self.contrastive_align_projection_vision(query), p=2, dim=-1))\r\n        else:\r\n            proj_queries.append(None)\r\n            \r\n        proj_tokens = []\r\n        if self.contrastive_align_loss:\r\n            proj_tokens.append(F.normalize(self.contrastive_align_projection_text(lang_feats), p=2, dim=-1))\r\n        else:\r\n            proj_tokens.append(None)\r\n        \r\n        \r\n        pred_scores, pred_masks, attn_masks = self.prediction_head(query, mask_feats, batch_mask)\r\n        pred_indis = self.indi_embedding(query, pred_masks, batch_mask)\r\n        prediction_scores.append(pred_scores)\r\n        prediction_masks.append(pred_masks)\r\n        prediction_indis.append(pred_indis)\r\n        \r\n        lang_query = lang_feats\r\n        \r\n        # multi-round\r\n\r\n        for i in range(self.num_layer):\r\n            \r\n            lang_query = self.lla_layers[i](lang_query, lang_masks)\r\n            lang_query, _, _ = self.lia_layers[i](inst_feats, lang_query, batch_mask, None)\r\n            inst_feats, _, _ = self.ila_layers[i](lang_query, inst_feats, lang_masks, None)\r\n            lang_query = self.lia_ffn_layers[i](lang_query)\r\n            inst_feats = self.ila_ffn_layers[i](inst_feats)\r\n\r\n            coarse_query, coarse_att, _ = self.qia_layers[i](inst_feats, query, batch_mask, attn_masks)\r\n            coarse_query_ffn = self.qia_ffn_layers[i](coarse_query)\r\n            ### 细粒度\r\n            ### 利用coarse_att进行topk选择\r\n            coarse_att = coarse_att * (~batch_mask.unsqueeze(1)).float()\r\n            coarse_att = coarse_att.sum(-2)   # [B, N]\r\n            if coarse_att.shape[1] < self.num_proposal_fine:\r\n                sample_inds_fine = torch.Tensor(list(range(coarse_att.shape[1]))).int().unsqueeze(0).repeat(coarse_att.shape[0], 1).cuda()\r\n            else:   \r\n                sample_inds_fine = torch.topk(coarse_att, self.num_proposal_fine)[1].int() # (bsz, num_proposal_fine)    \r\n            sample_inds_fine = sample_inds_fine.long()\r\n            inst_feats_fine = inst_feats.gather(dim=1, index=sample_inds_fine.unsqueeze(-1).repeat(1, 1, inst_feats.size(-1)))\r\n            inst_feats_fine_pos = sp_pos.gather(dim=1, index=sample_inds_fine.long().unsqueeze(-1).repeat(1, 1, sp_pos.size(-1)))\r\n            scg_weights, scg_mask = self.get_scg_weight(query_pos,pos_k=inst_feats_fine_pos, k=self.num_proposal_query_inst[i]) #2**7 128\r\n            \r\n            fine_query, _, _ = self.qia_layers_fine[i](inst_feats_fine, coarse_query_ffn, attn_mask=~scg_mask, att_weights = scg_weights)\r\n            query_qia = (coarse_query + fine_query)/2\r\n            \r\n\r\n            query_qla, _, _ = self.qla_layers[i](lang_query, query_qia, lang_masks)\r\n            _, scg_mask = self.get_scg_weight(query_pos, k=self.num_proposal_query[i]) #2**7 128\r\n\r\n            query_self = self.qqa_layers[i](query_qla, attn_mask=~scg_mask)\r\n\r\n            query = self.norm_qqa(query_self + query_qla)\r\n\r\n            \r\n            query = self.qqa_ffn_layers[i](query)\r\n\r\n\r\n            pred_scores, pred_masks, attn_masks = self.prediction_head(query, mask_feats, batch_mask)\r\n            pred_indis = self.indi_embedding(query, pred_masks, batch_mask)\r\n            prediction_scores.append(pred_scores)\r\n            prediction_masks.append(pred_masks)\r\n            prediction_indis.append(pred_indis)\r\n            if self.contrastive_align_loss:\r\n                proj_queries.append(F.normalize(self.contrastive_align_projection_vision(query), p=2, dim=-1))\r\n            else:\r\n                proj_queries.append(None)\r\n                \r\n            if self.contrastive_align_loss:\r\n                proj_tokens.append(F.normalize(self.contrastive_align_projection_text(lang_query), p=2, dim=-1))\r\n            else:\r\n                proj_tokens.append(None)\r\n\r\n        return {\r\n            'masks': pred_masks,\r\n            'batch_mask': batch_mask,\r\n            'scores': pred_scores,\r\n            'indis': pred_indis, # [B, B_q, 2]\r\n            'proj_queries': proj_queries[-1],\r\n            'proj_tokens': proj_tokens[-1],\r\n            'sample_inds': sample_inds, # [B, K]\r\n            'ref_scores': ref_scores, # [B, M]\r\n            'aux_outputs': [{\r\n                'masks': a,\r\n                'scores': b,\r\n                'proj_queries': c,\r\n                'indis': d,\r\n                'proj_tokens': e,\r\n            } for a, b, c, d, e in zip(\r\n                prediction_masks[:-1],\r\n                prediction_scores[:-1],\r\n                proj_queries[:-1],\r\n                prediction_indis[:-1],\r\n                proj_tokens[:-1],\r\n            )],\r\n        }\r\n        \r\n    def get_batches(self, x, batch_offsets):\r\n        B = len(batch_offsets) - 1\r\n        max_len = max(batch_offsets[1:] - batch_offsets[:-1])\r\n        if torch.is_tensor(max_len):\r\n            max_len = max_len.item()\r\n        new_feats = torch.zeros(B, max_len, x.shape[1]).to(x.device)\r\n        mask = torch.ones(B, max_len, dtype=torch.bool).to(x.device)\r\n        for i in range(B):\r\n            start_idx = batch_offsets[i]\r\n            end_idx = batch_offsets[i + 1]\r\n            cur_len = end_idx - start_idx\r\n            padded_feats = torch.cat([x[start_idx:end_idx], torch.zeros(max_len - cur_len, x.shape[1]).to(x.device)], dim=0)\r\n            new_feats[i] = padded_feats\r\n            mask[i, :cur_len] = False\r\n        mask.detach()\r\n        return new_feats, mask\r\n    \r\n    def get_mask(self, query, mask_feats, batch_mask):\r\n        pred_masks = torch.einsum('bnd,bmd->bnm', query, mask_feats)\r\n        if self.attn_mask:\r\n            attn_masks = (pred_masks.sigmoid() < 0.5).bool() # [B, 1, num_sp]\r\n            attn_masks = attn_masks | batch_mask.unsqueeze(1)\r\n            attn_masks[torch.where(attn_masks.sum(-1) == attn_masks.shape[-1])] = False\r\n            attn_masks = attn_masks | batch_mask.unsqueeze(1)\r\n            attn_masks = attn_masks.detach()\r\n        else:\r\n            attn_masks = None\r\n        return pred_masks, attn_masks\r\n\r\n    def prediction_head(self, query, mask_feats, batch_mask):\r\n        query = self.out_norm(query)\r\n        pred_scores = self.out_score(query)\r\n        pred_masks, attn_masks = self.get_mask(query, mask_feats, batch_mask)\r\n        return pred_scores, pred_masks, attn_masks\r\n\r\n    def get_scg_weight(self, pos_q, pos_k=None, k_mask=None, k=None):\r\n        if pos_k == None: pos_k = pos_q\r\n        # dis = torch.cdist(pos_q, pos_k, p=2)\r\n        dis = ((pos_q.unsqueeze(2)-pos_k.unsqueeze(1))**2).sum(-1)\r\n        if k_mask is not None:\r\n            dis = torch.masked_fill(dis, k_mask.unsqueeze(1).repeat(1,pos_q.shape[1],1), 1000000.0)\r\n        gamma = 0.3  # 可调节参数，控制衰减速度（值越大，权重下降越快）\r\n        scg_weight = torch.exp(-gamma * dis)  # dis越小，att_weights越接近1\r\n","exit_code":0,"status":"completed"}}
