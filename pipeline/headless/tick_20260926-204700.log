{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"\"C:\\\\Users\\\\chuanle song\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\pwsh.exe\" -Command 'Get-ChildItem -Path AdaRES -Directory -Recurse -Filter nn_new | Select-Object -ExpandProperty FullName; Get-Content AdaRES/ipdn/model_paper5/adares_b4_query_competition/sample_model.py -TotalCount 95; Get-Content SERVERS.yaml -Raw'","aggregated_output":"import torch, math\r\nimport torch.nn as nn\r\nimport numpy as np\r\nimport sys\r\nimport os\r\nimport torch.nn.functional as F\r\nif os.path.join(os.getcwd()) not in sys.path:\r\n    sys.path.append(os.path.join(os.getcwd())) # HACK add the root folder\r\n\r\nBASE_DIR = os.path.dirname(os.path.abspath(__file__))\r\nROOT_DIR = os.path.dirname(BASE_DIR)\r\nsys.path.append(BASE_DIR)\r\nsys.path.append(os.path.join(os.getcwd(), \"lib\"))\r\nsys.path.append(os.path.join(os.getcwd(), \"lib\", 'pointnet2'))\r\n\r\nclass CrossAttentionMap(nn.Module):\r\n    def __init__(self, q_dim, k_dim, d_model):\r\n        super().__init__()\r\n        self.d_model = d_model\r\n        self.query_proj = nn.Linear(q_dim, d_model, bias=False)\r\n        self.key_proj = nn.Linear(k_dim, d_model, bias=False)\r\n\r\n    def forward(self, query, key, query_mask=None, key_padding_mask=None):\r\n        \"\"\"\r\n        Args:\r\n            query: (B, N, D1)\r\n            key: (B, L, D2)\r\n            query_mask: (B, N)\r\n            key_padding_mask: (B, L)\r\n        Returns:\r\n            attn_map: (B, N, L)\r\n        \"\"\"\r\n        # Apply projection to query and key\r\n        Q = self.query_proj(query)  # (B, N, D_model)\r\n        K = self.key_proj(key)  # (B, L, D_model)\r\n        # Compute attention scores\r\n        scores = torch.einsum('bnd,bld->bnl', Q, K) / math.sqrt(self.d_model)  # (B, N, L)\r\n        # Apply masks\r\n        if query_mask is not None:\r\n            scores = scores.masked_fill(query_mask.unsqueeze(2), float('-inf'))\r\n        # Compute attention map\r\n        attn_map = F.softmax(scores, dim=1)\r\n        return attn_map\r\n    \r\nclass SamplingModule(nn.Module):\r\n    \"\"\"\r\n    Sample object proposal.\r\n    \"\"\"\r\n    def __init__(self, num_proposal, pc_dim, lang_dim, d_model):\r\n        super().__init__()\r\n        self.num_proposal = num_proposal\r\n        \r\n        self.camap = CrossAttentionMap(pc_dim, lang_dim, d_model)\r\n\r\n    def forward(self, pc_feat, lang_feat, pc_mask, lang_mask, gate = None):\r\n        \"\"\"\r\n        Args:\r\n            features: (B, N, D)\r\n            lang_feat: (B, L, D)\r\n        \"\"\"\r\n        if pc_mask is not None:\r\n            pc_mask = pc_mask.bool()\r\n        # (B, N, L)\r\n        ref_scores = self.camap(pc_feat, lang_feat, pc_mask, lang_mask.bool()) # (B, N, L)\r\n        ref_scores = ref_scores * (~lang_mask.unsqueeze(1)).float() # (B, N, L)\r\n        ref_scores = ref_scores.sum(-1)   # [B, N]\r\n        if gate != None:\r\n            ref_scores = ref_scores * gate\r\n        # print(ref_scores)\r\n        if ref_scores.shape[1] < self.num_proposal:\r\n            sample_inds = torch.Tensor(list(range(ref_scores.shape[1]))).int().unsqueeze(0).repeat(ref_scores.shape[0], 1).cuda()\r\n        else:\r\n            sample_inds = torch.topk(ref_scores, self.num_proposal)[1].int() # (bsz, num_proposal)\r\n\r\n        return sample_inds, ref_scores\r\n\r\nif __name__=='__main__':\r\n    from easydict import EasyDict\r\n    data_dict = {'point_clouds': torch.rand(16,3000,6).cuda()}\r\n    args = EasyDict({\r\n        'kps_fusion_dim': 256\r\n    })\r\n    dks_net = SamplingModule(num_proposal=512, feat_dim=32, lang_dim=256, d_model=256).cuda()\r\n    pc_xyz = torch.rand(16, 3000, 3).cuda()\r\n    pc_feat = torch.rand(16, 32, 3000).cuda()\r\n    lang_feat = torch.rand(16, 256).cuda()\r\n    data_dict['lang_hidden'] = lang_feat\r\n    out_dict, xyz, feat = dks_net(pc_xyz, pc_feat, data_dict)\r\n    print(xyz.shape, feat.shape)\r\n    for key in sorted(out_dict.keys()):\r\n        print(key, '\\t', out_dict[key].shape)\r\n# AdaRES_project — self-authored 3D-RES baseline\nservers:\n  local:\n    host: 192.168.1.175\n    user: songcl\n    role: workstation\n    gpu: {count: 0, type: none}\n    remote_code_root: D:/project/AdaRES_project/AdaRES\n    data_root: D:/data/\n    work_dir: D:/project/AdaRES_project/Checkpoints\n\n  server-2:\n    host: 192.168.1.163\n    user: songcl\n    role: gpu_server\n    allowed_gpus: [0, 1]\n    max_tasks_per_gpu: 1\n    single_gpu_tasks_only: true\n    gpu: {count: 2, type: RTX3090}\n    remote_code_root: /bak_home/songcl/Project/AdaRES_project/AdaRES\n    conda_source: /home/dl01/anaconda3/etc/profile.d/conda.sh\n    conda_env: adares_project\n    python: /home/songcl/.conda/envs/adares_project/bin/python\n    site_packages: /home/songcl/.conda/envs/adares_project/lib/python3.8/site-packages\n    pointnet_egg: /home/songcl/.local/lib/python3.8/site-packages/pointnet2-0.0.0-py3.8-linux-x86_64.egg\n    data_root: /bak_home/songcl/3D_visual_grounding/data/ipdn_data/data/\n    work_dir: /bak_home/songcl/Project/AdaRES_project/AdaRES_checkpoints\n\n  server-6:\n    host: 100.64.3.28\n    user: songcl\n    role: gpu_server\n    allowed_gpus: []\n    gpu: {count: 8, type: H100-80GB}\n    remote_code_root: /data3/songcl/Project/AdaRES_project/AdaRES\n    data_root: /data3/songcl/data/data_cluster/\n    work_dir: /data3/songcl/Project/AdaRES_project/AdaRES_checkpoints\n\r\n","exit_code":0,"status":"completed"}}
