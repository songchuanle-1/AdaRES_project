{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"\"C:\\\\Users\\\\chuanle song\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\pwsh.exe\" -Command \"Get-Content -Raw 'AdaRES/tools/diagnose_adares_g1_label_alignment.py' -ErrorAction SilentlyContinue; Get-Content -TotalCount 220 'AdaRES/tools/diagnose_adares_n2_same_object.py'; Get-Content -TotalCount 120 'AdaRES/configs_song/model_paper5/adares_b4_query_competition_res.yaml'; Get-Content -Raw 'SERVERS.yaml'\"","aggregated_output":"import argparse\nimport json\nimport statistics\nimport sys\nimport types\nfrom pathlib import Path\n\nimport gorilla\nimport torch\nimport torch.nn.functional as F\n\nROOT = Path(__file__).resolve().parents[1]\nsys.path.insert(0, str(ROOT))\n\nfrom ipdn.dataset import build_dataset\nfrom ipdn.model_paper5.adares_b4_query_competition import IPDN\nfrom ipdn.utils import get_root_logger\n\n\ndef predictor():\n    def predict_by_feat(\n        self, scan_ids, object_idss, ann_ids, out, superpoints,\n        gt_pmasks, gt_spmasks, fps_seed_sp,\n    ):\n        rows = []\n        for index, target in enumerate(gt_pmasks):\n            valid = ~out[\"batch_mask\"][index]\n            coords = self.probe_coords[index, valid]\n            labels = self.probe_labels[0]\n            sampled = fps_seed_sp[index].long()[out[\"sample_inds\"][index].long()]\n            sampled_labels = labels[sampled]\n            sampled_pos = coords[sampled]\n            object_ids = object_idss[index]\n            object_centers = []\n            for object_id in object_ids:\n                object_points = coords[labels == object_id]\n                if object_points.numel() == 0:\n                    raise RuntimeError(f\"Missing object {object_id} in scene\")\n                object_centers.append(object_points.mean(0))\n            nearest = torch.cdist(\n                sampled_pos, torch.stack(object_centers)\n            ).argmin(0)\n            positives = torch.zeros_like(sampled_labels, dtype=torch.bool)\n            for object_id, closest in zip(object_ids, nearest):\n                positives |= sampled_labels == object_id\n                positives[closest] = True\n\n            masks = out[\"masks\"][index].sigmoid().gt(0.5)[:, superpoints]\n            truth = target.gt(0.5).to(masks.device)\n            ious = (masks & truth).sum(-1).float() / (\n                (masks | truth).sum(-1).clamp_min(1).float()\n            )\n            scores = F.softmax(out[\"indis\"][index], dim=-1)[:, 1]\n            selected = int(scores.argmax())\n            oracle = int(ious.argmax())\n            rows.append({\n                \"scene_index\": self.probe_scene_index,\n                \"selected_iou\": float(ious[selected]),\n                \"oracle_iou\": float(ious[oracle]),\n                \"selected_positive\": bool(positives[selected]),\n                \"oracle_positive\": bool(positives[oracle]),\n                \"positive_count\": int(positives.sum()),\n                \"query_count\": int(positives.numel()),\n                \"selected_seed_object\": int(sampled_labels[selected]),\n                \"oracle_seed_object\": int(sampled_labels[oracle]),\n            })\n        return {\"rows\": rows}\n\n    return predict_by_feat\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"config\")\n    parser.add_argument(\"checkpoint\")\n    parser.add_argument(\"--output\", required=True)\n    parser.add_argument(\"--scenes\", type=int, default=16)\n    parser.add_argument(\"--gpu-id\", type=int, default=1)\n    args = parser.parse_args()\n\n    gorilla.set_cuda_visible_devices([args.gpu_id], 1)\n    gorilla.set_random_seed(1999)\n    cfg = gorilla.Config.fromfile(args.config)\n    data_cfg = cfg.data.val.copy()\n    data_cfg.training = False\n    data_cfg.aug = False\n    data_cfg.with_elastic = False\n    data_cfg.lang_num_max = 32\n    dataset = build_dataset(data_cfg, get_root_logger())\n    model = IPDN(**cfg.model).cuda()\n    checkpoint = torch.load(args.checkpoint, map_location=\"cpu\")\n    loaded = model.load_state_dict(checkpoint.get(\"model\", checkpoint), strict=False)\n    allowed = {\n        \"text_encoder.embeddings.position_ids\",\n        \"text_encoder.embeddings.token_type_ids\",\n    }\n    if loaded.missing_keys or set(loaded.unexpected_keys) - allowed:\n        raise RuntimeError(f\"Checkpoint mismatch: {loaded}\")\n    model.eval()\n\n    def capture(module, inputs):\n        model.probe_coords = module.get_batches(inputs[5], inputs[2])[0]\n\n    model.dec.register_forward_pre_hook(capture)\n    model.predict_by_feat = types.MethodType(predictor(), model)\n    rows = []\n    for index in range(min(args.scenes, len(dataset))):\n        batch = dataset.collate_fn([dataset[index]])\n        model.probe_scene_index = index\n        model.probe_labels = batch[\"sp_ins_labels\"]\n        with torch.no_grad():\n            rows.extend(model(batch, mode=\"predict\")[\"rows\"])\n    if not rows:\n        raise RuntimeError(\"No expressions in fixed diagnostic subset\")\n    errors = [row for row in rows if row[\"oracle_iou\"] - row[\"selected_iou\"] > 0.05]\n    conflicting = [\n        row for row in errors if row[\"selected_positive\"] and not row[\"oracle_positive\"]\n    ]\n    result = {\n        \"checkpoint\": args.checkpoint,\n        \"scenes\": min(args.scenes, len(dataset)),\n        \"expressions\": len(rows),\n        \"material_errors\": len(errors),\n        \"error_selected_positive_oracle_negative\": len(conflicting),\n        \"error_oracle_positive\": sum(row[\"oracle_positive\"] for row in errors),\n        \"error_selected_positive\": sum(row[\"selected_positive\"] for row in errors),\n        \"mean_positive_fraction\": statistics.fmean(\n            row[\"positive_count\"] / row[\"query_count\"] for row in rows\n        ),\n        \"rows\": rows,\n    }\n    Path(args.output).write_text(json.dumps(result, indent=2), encoding=\"utf-8\")\n    print(json.dumps({key: value for key, value in result.items() if key != \"rows\"}))\n\n\nif __name__ == \"__main__\":\n    main()\n\r\nimport argparse\r\nimport json\r\nimport sys\r\nimport types\r\nfrom collections import defaultdict\r\nfrom pathlib import Path\r\n\r\nimport gorilla\r\nimport torch\r\nimport torch.nn.functional as F\r\n\r\nROOT = Path(__file__).resolve().parents[1]\r\nsys.path.insert(0, str(ROOT))\r\n\r\nfrom ipdn.dataset import build_dataset\r\nfrom ipdn.model_paper5.adares_b4_query_competition import IPDN\r\nfrom ipdn.utils import get_root_logger\r\n\r\n\r\ndef predictor():\r\n    def predict_by_feat(self, scan_ids, object_idss, ann_ids, out, superpoints,\r\n                        gt_pmasks, gt_spmasks, fps_seed_sp):\r\n        rows = []\r\n        for index, truth in enumerate(gt_pmasks):\r\n            masks = out[\"masks\"][index].sigmoid().gt(0.5)[:, superpoints]\r\n            target = truth.gt(0.5).to(masks.device)\r\n            ious = (masks & target).sum(-1).float() / (\r\n                (masks | target).sum(-1).clamp_min(1).float()\r\n            )\r\n            scores = F.softmax(out[\"indis\"][index], dim=-1)[:, 1]\r\n            selected = int(scores.argmax())\r\n            oracle = int(ious.argmax())\r\n            rows.append({\r\n                \"scene\": self.probe_scene,\r\n                \"object_ids\": [int(v) for v in object_idss[index]],\r\n                \"language\": self.probe_language[index].tolist(),\r\n                \"selected_iou\": float(ious[selected]),\r\n                \"oracle_iou\": float(ious[oracle]),\r\n                \"selected_mask\": torch.where(masks[selected])[0].tolist(),\r\n                \"oracle_mask\": torch.where(masks[oracle])[0].tolist(),\r\n            })\r\n        return {\"rows\": rows}\r\n    return predict_by_feat\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser()\r\n    parser.add_argument(\"config\")\r\n    parser.add_argument(\"checkpoint\")\r\n    parser.add_argument(\"--scenes\", type=int, default=16)\r\n    parser.add_argument(\"--gpu-id\", type=int, default=1)\r\n    parser.add_argument(\"--output\", required=True)\r\n    args = parser.parse_args()\r\n    gorilla.set_cuda_visible_devices([args.gpu_id], 1)\r\n    gorilla.set_random_seed(1999)\r\n    cfg = gorilla.Config.fromfile(args.config)\r\n    data_cfg = cfg.data.val.copy()\r\n    data_cfg.training = False\r\n    data_cfg.aug = False\r\n    data_cfg.with_elastic = False\r\n    data_cfg.lang_num_max = 32\r\n    dataset = build_dataset(data_cfg, get_root_logger())\r\n    model = IPDN(**cfg.model).cuda()\r\n    checkpoint = torch.load(args.checkpoint, map_location=\"cpu\")\r\n    loaded = model.load_state_dict(checkpoint.get(\"model\", checkpoint), strict=False)\r\n    allowed = {\"text_encoder.embeddings.position_ids\", \"text_encoder.embeddings.token_type_ids\"}\r\n    if loaded.missing_keys or set(loaded.unexpected_keys) - allowed:\r\n        raise RuntimeError(f\"Checkpoint mismatch: {loaded}\")\r\n    model.eval()\r\n    def capture_language(module, inputs):\r\n        language, mask = inputs[3], inputs[4].bool()\r\n        valid = mask.unsqueeze(-1).to(language.dtype)\r\n        pooled = (language * valid).sum(1) / valid.sum(1).clamp_min(1)\r\n        model.probe_language = F.normalize(pooled, dim=-1)\r\n\r\n    model.dec.register_forward_pre_hook(capture_language)\r\n    model.predict_by_feat = types.MethodType(predictor(), model)\r\n    rows = []\r\n    for scene in range(min(args.scenes, len(dataset))):\r\n        model.probe_scene = scene\r\n        with torch.no_grad():\r\n            rows.extend(model(dataset.collate_fn([dataset[scene]]), mode=\"predict\")[\"rows\"])\r\n    groups = defaultdict(list)\r\n    for row in rows:\r\n        if len(row[\"object_ids\"]) == 1:\r\n            groups[(row[\"scene\"], row[\"object_ids\"][0])].append(row)\r\n    pairs = []\r\n    for (scene, object_id), group in groups.items():\r\n        if len(group) < 2:\r\n            continue\r\n        for index, left in enumerate(group):\r\n            for right in group[index + 1:]:\r\n                a, b = set(left[\"selected_mask\"]), set(right[\"selected_mask\"])\r\n                c, d = set(left[\"oracle_mask\"]), set(right[\"oracle_mask\"])\r\n                pairs.append({\r\n                    \"scene\": scene,\r\n                    \"object_id\": object_id,\r\n                    \"selected_overlap\": len(a & b) / max(1, len(a | b)),\r\n                    \"oracle_overlap\": len(c & d) / max(1, len(c | d)),\r\n                    \"left_iou\": left[\"selected_iou\"],\r\n                    \"right_iou\": right[\"selected_iou\"],\r\n                    \"left_oracle_iou\": left[\"oracle_iou\"],\r\n                    \"right_oracle_iou\": right[\"oracle_iou\"],\r\n                })\r\n    result = {\r\n        \"scenes\": min(args.scenes, len(dataset)),\r\n        \"expressions\": len(rows),\r\n        \"same_object_groups\": sum(len(g) >= 2 for g in groups.values()),\r\n        \"same_object_pairs\": len(pairs),\r\n        \"pairs\": pairs,\r\n    }\r\n    nearest = []\r\n    by_scene = defaultdict(list)\r\n    for row in rows:\r\n        by_scene[row[\"scene\"]].append(row)\r\n    for group in by_scene.values():\r\n        if len(group) < 2:\r\n            continue\r\n        languages = torch.tensor([row[\"language\"] for row in group])\r\n        similarities = languages @ languages.T\r\n        similarities.fill_diagonal_(-float(\"inf\"))\r\n        for index, partner_index in enumerate(similarities.argmax(-1).tolist()):\r\n            left, right = group[index], group[partner_index]\r\n            a, b = set(left[\"selected_mask\"]), set(right[\"selected_mask\"])\r\n            nearest.append({\r\n                \"same_object\": len(left[\"object_ids\"]) == len(right[\"object_ids\"]) == 1\r\n                and left[\"object_ids\"] == right[\"object_ids\"],\r\n                \"selected_overlap\": len(a & b) / max(1, len(a | b)),\r\n                \"left_iou\": left[\"selected_iou\"],\r\n                \"right_iou\": right[\"selected_iou\"],\r\n            })\r\n    result[\"language_nearest\"] = nearest\r\n    scene_pairs = []\r\n    for group in by_scene.values():\r\n        for index, left in enumerate(group):\r\n            for right in group[index + 1:]:\r\n                a, b = set(left[\"selected_mask\"]), set(right[\"selected_mask\"])\r\n                c, d = set(left[\"oracle_mask\"]), set(right[\"oracle_mask\"])\r\n                scene_pairs.append({\r\n                    \"same_object\": len(left[\"object_ids\"]) == len(right[\"object_ids\"]) == 1\r\n                    and left[\"object_ids\"] == right[\"object_ids\"],\r\n                    \"selected_overlap\": len(a & b) / max(1, len(a | b)),\r\n                    \"oracle_overlap\": len(c & d) / max(1, len(c | d)),\r\n                    \"left_iou\": left[\"selected_iou\"],\r\n                    \"right_iou\": right[\"selected_iou\"],\r\n                })\r\n    result[\"scene_pairs\"] = scene_pairs\r\n    Path(args.output).write_text(json.dumps(result, indent=2), encoding=\"utf-8\")\r\n    print(json.dumps({key: value for key, value in result.items() if key != \"pairs\"}))\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\nwork_dir: /bak_home/songcl/Project/AdaRES_project/AdaRES_checkpoints\r\ntrain:\r\n  seed: 1999\r\n  epochs: 30\r\n  interval: 1\r\n  pretrain: /bak_home/songcl/3D_visual_grounding/data/ipdn_data/data/sp_unet_backbone.pth\r\n  save_epoch: 100\r\n  grad_clip: 0.1\r\n\r\ntest:\r\n  seed: 1999\r\n  test_topk_per_scene: 100\r\n  test_score_thresh: 0.0\r\n  test_npoint_thresh: 100\r\n\r\ndataloader:\r\n  train:\r\n    batch_size: 2\r\n    num_workers: 4\r\n    persistent_workers: True\r\n  val:\r\n    batch_size: 1\r\n    num_workers: 2\r\n    persistent_workers: True\r\n  test:\r\n    batch_size: 1\r\n    num_workers: 1\r\n    persistent_workers: True\r\n\r\ndata:\r\n  train:\r\n    type: scannetv2_sample_graph_edge\r\n    dataset: scanrefer\r\n    data_root: /bak_home/songcl/3D_visual_grounding/data/ipdn_data/data/\r\n    prefix: train\r\n    suffix: .pth\r\n    training: True\r\n    mode: 4\r\n    aug: True\r\n    with_elastic: True\r\n    use_xyz: True\r\n    voxel_cfg:\r\n      scale: 50\r\n      spatial_shape: [128, 512]\r\n      max_npoint: 2500000\r\n    max_des_len: 78\r\n    lang_num_max: 4\r\n  val:\r\n    type: scannetv2_sample_graph_edge\r\n    dataset: scanrefer\r\n    data_root: /bak_home/songcl/3D_visual_grounding/data/ipdn_data/data/\r\n    prefix: val\r\n    suffix: .pth\r\n    training: False\r\n    aug: False\r\n    with_elastic: False\r\n    use_xyz: True\r\n    voxel_cfg:\r\n      scale: 50\r\n      spatial_shape: [128, 512]\r\n      max_npoint: 2500000\r\n    max_des_len: 78\r\n    lang_num_max: 32\r\n\r\nmodel:\r\n  input_channel: 6\r\n  blocks: 5\r\n  block_reps: 2\r\n  media: 32\r\n  normalize_before: True\r\n  return_blocks: True\r\n  pool: mean\r\n  infer_mode: sem\r\n  fps_num: 256\r\n  task_type: res\r\n  sampling_module:\r\n    num_proposal: 128\r\n    pc_dim: 256\r\n    lang_dim: 256\r\n    d_model: 256\r\n  dec:\r\n    num_layer: 6\r\n    d_model: 256\r\n    nhead: 8\r\n    hidden_dim: 1024\r\n    dropout: 0.0\r\n    activation_fn: gelu\r\n    iter_pred: True\r\n    attn_mask: True\r\n    kernel: top1\r\n    global_feat: mean\r\n    lang_att: True\r\n    contrastive_align_loss: True\r\n    num_proposal_fine: 512\r\n    num_proposal_query: [128, 64, 32, 16, 8, 4]\r\n    num_proposal_query_inst: [128, 64, 32, 16, 8, 4]\r\n  criterion:\r\n    loss_weight: [1.0, 1.0, 0.5, 5.0, 0.1, 0.1, 0.1, 1.0]\r\n    cost_weight: [1.0, 1.0, 0.1]\r\n    loss_fun: focal\r\n    match_last_layer: True\r\n    layer_differ_weight: True\r\n  test_cfg:\r\n    topk_insts: 100\r\n    score_thr: 0.0\r\n    npoint_thr: 100\r\n  norm_eval: False\r\n  fix_module: ['text_encoder']\r\n\r\noptimizer:\r\n  type: AdamW\r\n  lr: 