{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"\"C:\\\\Users\\\\chuanle song\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\pwsh.exe\" -Command \"Get-Content -Raw 'D:\\\\project\\\\.agents\\\\skills\\\\songcl_research_pipeline\\\\log_decision.sh'; Get-Content -Raw 'scripts/sync.sh'\"","aggregated_output":"#!/usr/bin/env bash\n# 决策日志 — 记录流水线所有自主决策（自动 + Claude 研究决策）\n# 用法: bash log_decision.sh <project> <type> <question> <decision> [rationale] [evidence]\n#\n# type 取值:\n#   early_stop   自动早停 kill\n#   queue_push   自动队列推送\n#   next_batch   下一批实验选择（Claude 研究决策）\n#   route_change 路线扩展/放弃（Claude 研究决策）\n#   question     提出但未自行拍板、留给用户确认的问题\n#   other        其他\n#\n# 写入 pipeline/decisions/ 目录（每次决策一个独立 MD + 汇总索引 _index.md）:\n#   pipeline/decisions/<YYYYMMDD-HHMMSS>_<type>.md   单次决策详情\n#   pipeline/decisions/_index.md                     决策索引表\nset -u\n\nPROJECT=${1:?Usage: $0 <project> <type> <question> <decision> [rationale] [evidence]}\nTYPE=${2:?}\nQUESTION=${3:?}\nDECISION=${4:?}\nRATIONALE=${5:-}\nEVIDENCE=${6:-}\n\nROOT=\"${PROJECT_ROOT:-/home/songcl/3dres/project}\"\nPROJECT_DIR=$ROOT/$PROJECT\nif [ ! -d \"$PROJECT_DIR\" ]; then\n  echo \"错误: 项目目录不存在: $PROJECT_DIR\"\n  exit 1\nfi\n\nTSHUMAN=$(date '+%Y-%m-%d %H:%M:%S')\nTSTAG=$(date '+%Y%m%d-%H%M%S')\nDEC_DIR=$PROJECT_DIR/pipeline/decisions\nmkdir -p \"$DEC_DIR\"\n\n# 1. 写入独立决策文件\nDEC_FILE=$DEC_DIR/${TSTAG}_${TYPE}.md\ncat > \"$DEC_FILE\" << EOF\n# ${PROJECT} 决策记录\n\n- **时间**: $TSHUMAN\n- **类型**: $TYPE\n- **问题**: $QUESTION\n- **决策**: $DECISION\nEOF\n[ -n \"$RATIONALE\" ] && echo \"- **依据**: $RATIONALE\" >> \"$DEC_FILE\"\n[ -n \"$EVIDENCE\" ] && echo \"- **证据**: $EVIDENCE\" >> \"$DEC_FILE\"\n\n# 2. 更新决策索引表 _index.md\nINDEX_FILE=$DEC_DIR/_index.md\nif [ ! -f \"$INDEX_FILE\" ]; then\n  printf '# %s 决策索引\\n\\n| 时间 | 类型 | 问题 | 决策 |\\n|------|------|------|------|\\n' \"$PROJECT\" > \"$INDEX_FILE\"\nfi\n\n# 截断问题/决策到合理长度避免表格炸裂\nQ_SHORT=$(echo \"$QUESTION\" | head -c 60 | tr '\\n' ' ')\nD_SHORT=$(echo \"$DECISION\" | head -c 60 | tr '\\n' ' ')\nprintf '| %s | [%s](%s) | %s | %s |\\n' \\\n  \"$TSHUMAN\" \"$TYPE\" \"${TSTAG}_${TYPE}.md\" \"$Q_SHORT\" \"$D_SHORT\" \\\n  >> \"$INDEX_FILE\"\n\necho \"已记录决策 [$TYPE] -> $DEC_FILE\"\n\r\n#!/usr/bin/env bash\nset -euo pipefail\n\nSCRIPT_DIR=\"$(cd -- \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nPROJECT_ROOT=\"$(dirname \"$SCRIPT_DIR\")\"\nSERVERS_YAML=\"$(cygpath -m \"$PROJECT_ROOT/SERVERS.yaml\")\"\nSERVER=\"${1:?Usage: sync.sh <server>}\"\n\nread_value() {\n    python -c \"import yaml; d=yaml.safe_load(open(r'$SERVERS_YAML', encoding='utf-8'))['servers']['$SERVER']; print(d['$1'])\"\n}\n\nHOST=\"$(read_value host)\"\nUSER=\"$(read_value user)\"\nREMOTE_ROOT=\"$(read_value remote_code_root)\"\nTARGET=\"${USER}@${HOST}\"\nHEAD=\"$(git -C \"$PROJECT_ROOT\" rev-parse HEAD)\"\nBASE=\"$(ssh -o BatchMode=yes \"$TARGET\" \"cat '$REMOTE_ROOT/.codex_source_commit'\")\"\n\nif [[ \"$BASE\" == \"$HEAD\" ]]; then\n    exit 0\nfi\nif ! git -C \"$PROJECT_ROOT\" cat-file -e \"$BASE^{commit}\" ||\n   ! git -C \"$PROJECT_ROOT\" merge-base --is-ancestor \"$BASE\" \"$HEAD\"; then\n    echo \"Remote marker is not a local ancestor of HEAD\" >&2\n    exit 1\nfi\nmapfile -t CHANGES < <(git -C \"$PROJECT_ROOT\" diff --name-status \"$BASE\" \"$HEAD\" -- AdaRES)\nif (( ${#CHANGES[@]} == 0 )); then\n    ssh -o BatchMode=yes \"$TARGET\" \"printf '%s\\n' '$HEAD' > '$REMOTE_ROOT/.codex_source_commit'\"\n    echo \"Verified no AdaRES changes; advanced source marker on $SERVER to $HEAD\"\n    exit 0\nfi\n\nFILES=()\nfor change in \"${CHANGES[@]}\"; do\n    status=\"${change%%$'\\t'*}\"\n    path=\"${change#*$'\\t'}\"\n    if [[ \"$status\" != \"A\" || \"$path\" != AdaRES/* ]]; then\n        echo \"Refusing non-additive sync: $change\" >&2\n        exit 1\n    fi\n    FILES+=(\"${path#AdaRES/}\")\ndone\n\nMISSING=()\nfor file in \"${FILES[@]}\"; do\n    expected=\"$(git -C \"$PROJECT_ROOT\" archive \"$HEAD:AdaRES\" \"$file\" | tar -xO \"$file\" | sha256sum | cut -d ' ' -f 1)\"\n    if ssh -o BatchMode=yes \"$TARGET\" \"test -e '$REMOTE_ROOT/$file'\"; then\n        actual=\"$(ssh -o BatchMode=yes \"$TARGET\" \"sha256sum '$REMOTE_ROOT/$file'\" | cut -d ' ' -f 1)\"\n        if [[ \"$expected\" != \"$actual\" ]]; then\n            echo \"Refusing mismatched existing remote file: $file\" >&2\n            exit 1\n        fi\n    else\n        MISSING+=(\"$file\")\n    fi\ndone\n\nif (( ${#MISSING[@]} > 0 )); then\n    git -C \"$PROJECT_ROOT\" archive \"$HEAD:AdaRES\" \"${MISSING[@]}\" |\n        ssh -o BatchMode=yes \"$TARGET\" \"tar --warning=no-timestamp -C '$REMOTE_ROOT' -xkf -\"\nfi\nfor file in \"${FILES[@]}\"; do\n    expected=\"$(git -C \"$PROJECT_ROOT\" archive \"$HEAD:AdaRES\" \"$file\" | tar -xO \"$file\" | sha256sum | cut -d ' ' -f 1)\"\n    actual=\"$(ssh -o BatchMode=yes \"$TARGET\" \"sha256sum '$REMOTE_ROOT/$file'\" | cut -d ' ' -f 1)\"\n    [[ \"$expected\" == \"$actual\" ]] || { echo \"Remote hash mismatch: $file\" >&2; exit 1; }\ndone\nssh -o BatchMode=yes \"$TARGET\" \"printf '%s\\n' '$HEAD' > '$REMOTE_ROOT/.codex_source_commit'\"\necho \"Verified ${#FILES[@]} additive AdaRES files on $SERVER at $HEAD\"\n\r\n","exit_code":0,"status":"completed"}}
