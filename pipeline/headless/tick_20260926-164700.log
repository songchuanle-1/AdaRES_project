     \"next_action\": \"No admission or rank/fusion scan. Sampler-order shortcut is unsupported: only 141/240 missed oracles have later sampler rank and 99/240 higher sampler score; sampler-only mIoU is 0.34587 versus B4 0.49186. Reconsider only with independent prospective evidence, not this validation subset.\",\n      \"evidence\": [\n        {\"path\": \"AdaRES/tools/diagnose_adares_k1_sampler_rank.py\", \"sha256\": \"8b947f364948281b9140f147d908007a97f35c61767bf11bd0e1a4320a5290eb\"},\n        {\"path\": \"pipeline/analyses/AdaRES-K1-K2_native_16scenes_20260926.json\", \"sha256\": \"fb4d086a8bb4c1ca5c5e866ae35fa15964bfc14dbd163127beb4c07ee43c5402\"},\n        {\"path\": \"pipeline/analyses/AdaRES-K1-K2_negative_diagnosis_20260926-150100.md\", \"sha256\": \"2858798f675e738ab508c272b9cd546803eda47fd4944c60860f4ed6e79ab83f\"}\n      ]\n    },\n    {\n      \"id\": \"AdaRES-K2\",\n      \"stage\": \"rejected\",\n      \"next_action\": \"No admission or area threshold scan. Oracle mask is larger in only 118/240 errors and largest-mask selection gives subset mIoU 0.27271 versus B4 0.49186. Reconsider only with independent evidence for a different structural mechanism.\",\n      \"evidence\": [\n        {\"path\": \"pipeline/analyses/AdaRES-K1-K2_native_16scenes_20260926.json\", \"sha256\": \"fb4d086a8bb4c1ca5c5e866ae35fa15964bfc14dbd163127beb4c07ee43c5402\"},\n        {\"path\": \"pipeline/analyses/AdaRES-K1-K2_negative_diagnosis_20260926-150100.md\", \"sha256\": \"2858798f675e738ab508c272b9cd546803eda47fd4944c60860f4ed6e79ab83f\"}\n      ]\n    },\n    {\n      \"id\": \"AdaRES-L1\",\n      \"stage\": \"rejected\",\n      \"next_action\": \"No admission or validation feature scan. Mask-interior coherence is higher for only 116/240 missed oracles and coherence-only subset mIoU 0.13079 versus B4 0.49186. Reconsider only with independent prospective evidence for a distinct mask-quality mechanism.\",\n      \"evidence\": [\n        {\"path\": \"AdaRES/tools/diagnose_ada