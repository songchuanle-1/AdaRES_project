{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"\"C:\\\\Users\\\\chuanle song\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\pwsh.exe\" -Command \"Get-ChildItem D:\\\\project\\\\AdaRES_project -Name | Select-Object -First 50; Get-Content AdaRES/tools/diagnose_adares_s2_local_appearance.py -TotalCount 220; Get-Content AdaRES/tools/diagnose_adares_n2_same_object.py -TotalCount 140\"","aggregated_output":"AdaRES\r\nCheckpoints\r\npipeline\r\nscripts\r\n.codex_sync_1840198.tar\r\n.gitignore\r\n.pipeline.lock\r\nenvironment.md\r\nSERVERS.yaml\r\nimport argparse\r\nimport json\r\nimport statistics\r\nimport sys\r\nimport types\r\nfrom pathlib import Path\r\n\r\nimport gorilla\r\nimport torch\r\nimport torch.nn.functional as F\r\n\r\nROOT = Path(__file__).resolve().parents[1]\r\nsys.path.insert(0, str(ROOT))\r\n\r\nfrom ipdn.dataset import build_dataset\r\nfrom ipdn.model_paper5.adares_b4_query_competition import IPDN\r\nfrom ipdn.utils import get_root_logger\r\n\r\n\r\ndef predictor(self, scan_ids, object_idss, ann_ids, out, superpoints,\r\n              gt_pmasks, gt_spmasks, fps_seed_sp):\r\n    rows = []\r\n    for index, target in enumerate(gt_pmasks):\r\n        valid = ~out[\"batch_mask\"][index]\r\n        masks = out[\"masks\"][index, :, valid].sigmoid().gt(0.5)\r\n        truth = target.gt(0.5).to(masks.device)\r\n        point_masks = masks[:, superpoints]\r\n        ious = (point_masks & truth).sum(-1).float() / (\r\n            (point_masks | truth).sum(-1).clamp_min(1).float()\r\n        )\r\n        scores = F.softmax(out[\"indis\"][index], -1)[:, 1]\r\n        selected = int(scores.argmax())\r\n        top_two = scores.topk(2).indices.tolist()\r\n        changed = []\r\n        for variant, alternate in enumerate(self.alternates):\r\n            alt_masks = alternate[\"masks\"][index, :, valid].sigmoid().gt(0.5)\r\n            overlap = masks.float() @ alt_masks.float().T\r\n            union = (masks.sum(-1)[:, None] +\r\n                     alt_masks.sum(-1)[None, :] - overlap).clamp_min(1)\r\n            query = selected if variant < 3 else top_two[1]\r\n            base_seed = out[\"sample_inds\"][index, query]\r\n            same_seed = (alternate[\"sample_inds\"][index] == base_seed).nonzero(\r\n                as_tuple=True)[0]\r\n            match = (int(same_seed[0]) if same_seed.numel()\r\n                     else int((overlap / union)[query].argmax()))\r\n            alt_scores = F.softmax(alternate[\"indis\"][index], -1)[:, 1]\r\n            alt_point = alt_masks[:, superpoints]\r\n            alt_ious = (alt_point & truth).sum(-1).float() / (\r\n                (alt_point | truth).sum(-1).clamp_min(1).float()\r\n            )\r\n            changed.append({\r\n                \"selected_score_drop\": float(scores[query] - alt_scores[match]),\r\n                \"matched_score\": float(alt_scores[match]),\r\n                \"matched_mask_iou\": float((overlap / union)[query, match]),\r\n                \"selection_iou\": float(alt_ious[alt_scores.argmax()]),\r\n                \"selection_flip\": int(alt_scores.argmax()) != match,\r\n                \"same_seed\": bool(same_seed.numel()),\r\n            })\r\n        rows.append({\r\n            \"selected_iou\": float(ious[selected]),\r\n            \"oracle_iou\": float(ious.max()),\r\n            \"selected_area\": int(masks[selected].sum()),\r\n            \"repeat\": changed[0],\r\n            \"inside\": changed[1],\r\n            \"outside\": changed[2],\r\n            \"runner_inside\": changed[3],\r\n            \"runner_outside\": changed[4],\r\n            \"top_two_inside_iou\": float(ious[\r\n                top_two[0] if changed[1][\"matched_score\"] >=\r\n                changed[3][\"matched_score\"] else top_two[1]]),\r\n            \"top_two_outside_iou\": float(ious[\r\n                top_two[0] if changed[2][\"matched_score\"] >=\r\n                changed[4][\"matched_score\"] else top_two[1]]),\r\n        })\r\n    return {\"rows\": rows}\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser()\r\n    parser.add_argument(\"config\")\r\n    parser.add_argument(\"checkpoint\")\r\n    parser.add_argument(\"--output\", required=True)\r\n    parser.add_argument(\"--scenes\", type=int, default=16)\r\n    parser.add_argument(\"--gpu-id\", type=int, default=0)\r\n    args = parser.parse_args()\r\n    gorilla.set_cuda_visible_devices([args.gpu_id], 1)\r\n    gorilla.set_random_seed(1999)\r\n    cfg = gorilla.Config.fromfile(args.config)\r\n    data_cfg = cfg.data.train.copy()\r\n    data_cfg.training = False\r\n    data_cfg.aug = False\r\n    data_cfg.with_elastic = False\r\n    data_cfg.lang_num_max = 32\r\n    dataset = build_dataset(data_cfg, get_root_logger())\r\n    model = IPDN(**cfg.model).cuda()\r\n    checkpoint = torch.load(args.checkpoint, map_location=\"cpu\")\r\n    loaded = model.load_state_dict(checkpoint.get(\"model\", checkpoint), strict=False)\r\n    allowed = {\"text_encoder.embeddings.position_ids\",\r\n               \"text_encoder.embeddings.token_type_ids\"}\r\n    if loaded.missing_keys or set(loaded.unexpected_keys) - allowed:\r\n        raise RuntimeError(f\"Checkpoint mismatch: {loaded}\")\r\n    model.eval()\r\n    original = model.dec.forward\r\n\r\n    def intervened_forward(self, x, fps_seed_sp, batch_offsets,\r\n                           lang_feats=None, lang_masks=None, sp_pos=None,\r\n                           feats_2d=None):\r\n        base = original(x, fps_seed_sp, batch_offsets, lang_feats,\r\n                        lang_masks, sp_pos, feats_2d)\r\n        repeat = original(x, fps_seed_sp, batch_offsets, lang_feats,\r\n                          lang_masks, sp_pos, feats_2d)\r\n        lengths = (batch_offsets[1:] - batch_offsets[:-1]).tolist()\r\n        selected = base[\"indis\"].softmax(-1)[..., 1].argmax(-1)\r\n        alternatives = []\r\n        top_two = base[\"indis\"].softmax(-1)[..., 1].topk(2).indices\r\n        for rank in (0, 1):\r\n            for inside in (True, False):\r\n                changed = feats_2d.clone()\r\n                for index, (start, length) in enumerate(zip(\r\n                        batch_offsets[:-1].tolist(), lengths)):\r\n                    query = top_two[index, rank]\r\n                    mask = base[\"masks\"][index, query, :length].sigmoid() > 0.5\r\n                    on = mask.nonzero(as_tuple=True)[0]\r\n                    off = (~mask).nonzero(as_tuple=True)[0]\r\n                    count = min(on.numel(), off.numel())\r\n                    indices = (on if inside else off)[:count] + start\r\n                    if count > 1:\r\n                        changed[indices] = feats_2d[indices.roll(1)]\r\n                alternatives.append(original(\r\n                    x, fps_seed_sp, batch_offsets, lang_feats, lang_masks,\r\n                    sp_pos, changed,\r\n                ))\r\n        model.alternates = [repeat] + alternatives\r\n        return base\r\n\r\n    model.dec.forward = types.MethodType(intervened_forward, model.dec)\r\n    model.predict_by_feat = types.MethodType(predictor, model)\r\n    rows = []\r\n    for scene in range(min(args.scenes, len(dataset))):\r\n        with torch.no_grad():\r\n            rows.extend(model(dataset.collate_fn([dataset[scene]]),\r\n                              mode=\"predict\")[\"rows\"])\r\n    errors = [r for r in rows if r[\"oracle_iou\"] - r[\"selected_iou\"] > 0.05]\r\n    result = {\r\n        \"scenes\": min(args.scenes, len(dataset)),\r\n        \"expressions\": len(rows),\r\n        \"material_errors\": len(errors),\r\n        \"indicator_miou\": statistics.fmean(r[\"selected_iou\"] for r in rows),\r\n        \"inside_miou\": statistics.fmean(r[\"inside\"][\"selection_iou\"] for r in rows),\r\n        \"outside_miou\": statistics.fmean(r[\"outside\"][\"selection_iou\"] for r in rows),\r\n        \"inside_flips\": sum(r[\"inside\"][\"selection_flip\"] for r in rows),\r\n        \"outside_flips\": sum(r[\"outside\"][\"selection_flip\"] for r in rows),\r\n        \"error_inside_greater_drop\": sum(\r\n            r[\"inside\"][\"selected_score_drop\"] >\r\n            r[\"outside\"][\"selected_score_drop\"] for r in errors),\r\n        \"all_inside_greater_drop\": sum(\r\n            r[\"inside\"][\"selected_score_drop\"] >\r\n            r[\"outside\"][\"selected_score_drop\"] for r in rows),\r\n        \"inside_mask_iou\": statistics.fmean(\r\n            r[\"inside\"][\"matched_mask_iou\"] for r in rows),\r\n        \"outside_mask_iou\": statistics.fmean(\r\n            r[\"outside\"][\"matched_mask_iou\"] for r in rows),\r\n        \"repeat_mismatch\": sum(\r\n            abs(r[\"repeat\"][\"selected_score_drop\"]) > 1e-4\r\n            or r[\"repeat\"][\"matched_mask_iou\"] < 0.9999 for r in rows),\r\n        \"repeat_miou\": statistics.fmean(\r\n            r[\"repeat\"][\"selection_iou\"] for r in rows),\r\n        \"inside_same_seed\": sum(r[\"inside\"][\"same_seed\"] for r in rows),\r\n        \"outside_same_seed\": sum(r[\"outside\"][\"same_seed\"] for r in rows),\r\n        \"runner_inside_same_seed\": sum(\r\n            r[\"runner_inside\"][\"same_seed\"] for r in rows),\r\n        \"top_two_inside_miou\": statistics.fmean(\r\n            r[\"top_two_inside_iou\"] for r in rows),\r\n        \"top_two_outside_miou\": statistics.fmean(\r\n            r[\"top_two_outside_iou\"] for r in rows),\r\n        \"top_two_inside_flips\": sum(\r\n            r[\"top_two_inside_iou\"] != r[\"selected_iou\"] for r in rows),\r\n        \"peak_reserved_gib\": torch.cuda.max_memory_reserved() / 2**30,\r\n        \"rows\": rows,\r\n    }\r\n    Path(args.output).write_text(json.dumps(result, indent=2), encoding=\"utf-8\")\r\n    print(json.dumps({k: v for k, v in result.items() if k != \"rows\"}))\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\nimport argparse\r\nimport json\r\nimport sys\r\nimport types\r\nfrom collections import defaultdict\r\nfrom pathlib import Path\r\n\r\nimport gorilla\r\nimport torch\r\nimport torch.nn.functional as F\r\n\r\nROOT = Path(__file__).resolve().parents[1]\r\nsys.path.insert(0, str(ROOT))\r\n\r\nfrom ipdn.dataset import build_dataset\r\nfrom ipdn.model_paper5.adares_b4_query_competition import IPDN\r\nfrom ipdn.utils import get_root_logger\r\n\r\n\r\ndef predictor():\r\n    def predict_by_feat(self, scan_ids, object_idss, ann_ids, out, superpoints,\r\n                        gt_pmasks, gt_spmasks, fps_seed_sp):\r\n        rows = []\r\n        for index, truth in enumerate(gt_pmasks):\r\n            masks = out[\"masks\"][index].sigmoid().gt(0.5)[:, superpoints]\r\n            target = truth.gt(0.5).to(masks.device)\r\n            ious = (masks & target).sum(-1).float() / (\r\n                (masks | target).sum(-1).clamp_min(1).float()\r\n            )\r\n            scores = F.softmax(out[\"indis\"][index], dim=-1)[:, 1]\r\n            selected = int(scores.argmax())\r\n            oracle = int(ious.argmax())\r\n            rows.append({\r\n                \"scene\": self.probe_scene,\r\n                \"object_ids\": [int(v) for v in object_idss[index]],\r\n                \"language\": self.probe_language[index].tolist(),\r\n                \"selected_iou\": float(ious[selected]),\r\n                \"oracle_iou\": float(ious[oracle]),\r\n                \"selected_mask\": torch.where(masks[selected])[0].tolist(),\r\n                \"oracle_mask\": torch.where(masks[oracle])[0].tolist(),\r\n            })\r\n        return {\"rows\": rows}\r\n    return predict_by_feat\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser()\r\n    parser.add_argument(\"config\")\r\n    parser.add_argument(\"checkpoint\")\r\n    parser.add_argument(\"--scenes\", type=int, default=16)\r\n    parser.add_argument(\"--gpu-id\", type=int, default=1)\r\n    parser.add_argument(\"--output\", required=True)\r\n    args = parser.parse_args()\r\n    gorilla.set_cuda_visible_devices([args.gpu_id], 1)\r\n    gorilla.set_random_seed(1999)\r\n    cfg = gorilla.Config.fromfile(args.config)\r\n    data_cfg = cfg.data.val.copy()\r\n    data_cfg.training = False\r\n    data_cfg.aug = False\r\n    data_cfg.with_elastic = False\r\n    data_cfg.lang_num_max = 32\r\n    dataset = build_dataset(data_cfg, get_root_logger())\r\n    model = IPDN(**cfg.model).cuda()\r\n    checkpoint = torch.load(args.checkpoint, map_location=\"cpu\")\r\n    loaded = model.load_state_dict(checkpoint.get(\"model\", checkpoint), strict=False)\r\n    allowed = {\"text_encoder.embeddings.position_ids\", \"text_encoder.embeddings.token_type_ids\"}\r\n    if loaded.missing_keys or set(loaded.unexpected_keys) - allowed:\r\n        raise RuntimeError(f\"Checkpoint mismatch: {loaded}\")\r\n    model.eval()\r\n    def capture_language(module, inputs):\r\n        language, mask = inputs[3], inputs[4].bool()\r\n        valid = mask.unsqueeze(-1).to(language.dtype)\r\n        pooled = (language * valid).sum(1) / valid.sum(1).clamp_min(1)\r\n        model.probe_language = F.normalize(pooled, dim=-1)\r\n\r\n    model.dec.register_forward_pre_hook(capture_language)\r\n    model.predict_by_feat = types.MethodType(predictor(), model)\r\n    rows = []\r\n    for scene in range(min(args.scenes, len(dataset))):\r\n        model.probe_scene = scene\r\n        with torch.no_grad():\r\n            rows.extend(model(dataset.collate_fn([dataset[scene]]), mode=\"predict\")[\"rows\"])\r\n    groups = defaultdict(list)\r\n    for row in rows:\r\n        if len(row[\"object_ids\"]) == 1:\r\n            groups[(row[\"scene\"], row[\"object_ids\"][0])].append(row)\r\n    pairs = []\r\n    for (scene, object_id), group in groups.items():\r\n        if len(group) < 2:\r\n            continue\r\n        for index, left in enumerate(group):\r\n            for right in group[index + 1:]:\r\n                a, b = set(left[\"selected_mask\"]), set(right[\"selected_mask\"])\r\n                c, d = set(left[\"oracle_mask\"]), set(right[\"oracle_mask\"])\r\n                pairs.append({\r\n                    \"scene\": scene,\r\n                    \"object_id\": object_id,\r\n                    \"selected_overlap\": len(a & b) / max(1, len(a | b)),\r\n                    \"oracle_overlap\": len(c & d) / max(1, len(c | d)),\r\n                    \"left_iou\": left[\"selected_iou\"],\r\n                    \"right_iou\": right[\"selected_iou\"],\r\n                    \"left_oracle_iou\": left[\"oracle_iou\"],\r\n                    \"right_oracle_iou\": right[\"oracle_iou\"],\r\n                })\r\n    result = {\r\n        \"scenes\": min(args.scenes, len(dataset)),\r\n        \"expressions\": len(rows),\r\n        \"same_object_groups\": sum(len(g) >= 2 for g in groups.values()),\r\n        \"same_object_pairs\": len(pairs),\r\n        \"pairs\": pairs,\r\n    }\r\n    nearest = []\r\n    by_scene = defaultdict(list)\r\n    for row in rows:\r\n        by_scene[row[\"scene\"]].append(row)\r\n    for group in by_scene.values():\r\n        if len(group) < 2:\r\n            continue\r\n        languages = torch.tensor([row[\"language\"] for row in group])\r\n        similarities = languages @ languages.T\r\n        similarities.fill_diagonal_(-float(\"inf\"))\r\n        for index, partner_index in enumerate(similarities.argmax(-1).tolist()):\r\n            left, right = group[index], group[partner_index]\r\n            a, b = set(left[\"selected_mask\"]), set(right[\"selected_mask\"])\r\n            nearest.append({\r\n                \"same_object\": len(left[\"object_ids\"]) == len(right[\"object_ids\"]) == 1\r\n                and left[\"object_ids\"] == right[\"object_ids\"],\r\n                \"selected_overlap\": len(a & b) / max(1, len(a | b)),\r\n                \"left_iou\": left[\"selected_iou\"],\r\n                \"right_iou\": right[\"selected_iou\"],\r\n            })\r\n    result[\"language_nearest\"] = nearest\r\n    scene_pairs = []\r\n    for group in by_scene.values():\r\n        for index, left in enumerate(group):\r\n            for right in group[index + 1:]:\r\n                a, b = set(left[\"selected_mask\"]), set(right[\"selected_mask\"])\r\n                c, d = set(left[\"oracle_mask\"]), set(right[\"oracle_mask\"])\r\n                scene_pairs.append({\r\n                    \"same_object\": len(left[\"object_ids\"]) == len(right[\"object_ids\"]) == 1\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"\"C:\\\\Users\\\\chuanle song\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\pwsh.exe\" -Command 'Get-Content pipeline/analyses/AdaRES-K1-K2_negative_diagnosis_20260926-150100.md; Get-Content AdaRES/tools/diagnose_adares_h5_query_access.py -TotalCount 190; Get-Content AdaRES/ipdn/model_paper5/adares_b4_query_competition/model.py -TotalCount 220'","aggregated_output":"# Fixed native screens: sampler rank and mask area\r\n\r\n2026-09-26 15:01 Asia/Shanghai. B4-E30 best checkpoint, first 16 ScanRefer validation scenes, 441 expressions, 240 material selection errors (oracle minus selected IoU > 0.05). Read-only native server-2 GPU1 inference. Raw paired rows: `AdaRES-K1-K2_native_16scenes_20260926.json`; script: `AdaRES/tools/diagnose_adares_k1_sampler_rank.py`. These subset observations do not estimate full-validation effects.\r\n\r\n| Route | Predeclared mechanism | Paired evidence and controls | Decision |\r\n|---|---|---|---|\r\n| K1 sampler-rank shortcut | B4 confidence overuses the sampler's relevance ordering, systematically suppressing later high-IoU queries. | Oracle later than selected in 141/240 errors; oracle sampler score higher in 99/240. Sampler-only top-1 mIoU 0.34587, reversed-order control 0.03610, B4 indicator 0.49186. Sampler-only fixes 50 errors and worsens 43. | Reject this shortcut mechanism. The index difference alone is not causal evidence; no rank-weight scan or training admission. |\r\n| K2 mask-area shortcut | B4 confidence favors a systematically wrong mask scale over good target masks. | Oracle area larger in 118/240 errors, close to a split. Largest-mask top-1 mIoU 0.27271, smallest-mask 0.00000, versus B4 0.49186; largest-mask fixes 49 errors and worsens 48. | Reject this scale-bias mechanism. No area threshold or fusion scan. |\r\n\r\nThe sampler uses descending top-k relevance order, so raw index has a structural interpretation, but the selected-vs-oracle index asymmetry alone does not demonstrate that the head uses rank. K2 uses point-mask area without target information for the controls. Neither passes the diagnosis hard gate; no candidate-specific native backward, resource or admission receipt is claimed. G1 training remains a separate test.\r\nimport argparse\r\nimport json\r\nimport statistics\r\nimport sys\r\nimport types\r\nfrom pathlib import Path\r\n\r\nimport gorilla\r\nimport torch\r\nimport torch.nn.functional as F\r\n\r\nROOT = Path(__file__).resolve().parents[1]\r\nsys.path.insert(0, str(ROOT))\r\n\r\nfrom ipdn.dataset import build_dataset\r\nfrom ipdn.model_paper5.adares_b4_query_competition import IPDN\r\nfrom ipdn.utils import get_root_logger\r\n\r\n\r\ndef predictor():\r\n    def predict_by_feat(\r\n        self, scan_ids, object_idss, ann_ids, out, superpoints,\r\n        gt_pmasks, gt_spmasks, fps_seed_sp,\r\n    ):\r\n        rows = []\r\n        for index, target in enumerate(gt_pmasks):\r\n            masks = out[\"masks\"][index].sigmoid().gt(0.5)[:, superpoints]\r\n            truth = target.gt(0.5).to(masks.device)\r\n            ious = (masks & truth).sum(-1).float() / (\r\n                (masks | truth).sum(-1).clamp_min(1).float()\r\n            )\r\n            scores = F.softmax(out[\"indis\"][index], dim=-1)[:, 1]\r\n            selected, oracle = int(scores.argmax()), int(ious.argmax())\r\n            pair_intersection = (masks[selected] & masks[oracle]).sum().float()\r\n            pair_union = (masks[selected] | masks[oracle]).sum().float()\r\n            rank = self.probe_neighbor_ranks[index]\r\n            rows.append({\r\n                \"scene_index\": self.probe_scene_index,\r\n                \"selected_iou\": float(ious[selected]),\r\n                \"oracle_iou\": float(ious[oracle]),\r\n                \"pair_overlap\": float(pair_intersection / pair_union.clamp_min(1)),\r\n                \"selected_to_oracle_rank\": int(rank[selected, oracle]),\r\n                \"oracle_to_selected_rank\": int(rank[oracle, selected]),\r\n            })\r\n        return {\"rows\": rows}\r\n\r\n    return predict_by_feat\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser()\r\n    parser.add_argument(\"config\")\r\n    parser.add_argument(\"checkpoint\")\r\n    parser.add_argument(\"--output\", required=True)\r\n    parser.add_argument(\"--scenes\", type=int, default=16)\r\n    parser.add_argument(\"--gpu-id\", type=int, default=1)\r\n    args = parser.parse_args()\r\n    gorilla.set_cuda_visible_devices([args.gpu_id], 1)\r\n    gorilla.set_random_seed(1999)\r\n    cfg = gorilla.Config.fromfile(args.config)\r\n    data_cfg = cfg.data.val.copy()\r\n    data_cfg.training = False\r\n    data_cfg.aug = False\r\n    data_cfg.with_elastic = False\r\n    data_cfg.lang_num_max = 32\r\n    dataset = build_dataset(data_cfg, get_root_logger())\r\n    model = IPDN(**cfg.model).cuda()\r\n    checkpoint = torch.load(args.checkpoint, map_location=\"cpu\")\r\n    loaded = model.load_state_dict(checkpoint.get(\"model\", checkpoint), strict=False)\r\n    allowed = {\r\n        \"text_encoder.embeddings.position_ids\",\r\n        \"text_encoder.embeddings.token_type_ids\",\r\n    }\r\n    if loaded.missing_keys or set(loaded.unexpected_keys) - allowed:\r\n        raise RuntimeError(f\"Checkpoint mismatch: {loaded}\")\r\n    model.eval()\r\n\r\n    def capture(module, inputs):\r\n        _, fps_seed, offsets, _, _, positions, _ = inputs\r\n        positions = module.get_batches(positions, offsets)[0]\r\n        seeds = positions.gather(1, fps_seed.long().unsqueeze(-1).expand(-1, -1, 3))\r\n        model.probe_seed_positions = seeds\r\n\r\n    def capture_sampling(module, inputs, output):\r\n        chosen = output[0].long()\r\n        query_pos = model.probe_seed_positions.gather(\r\n            1, chosen.unsqueeze(-1).expand(-1, -1, 3)\r\n        )\r\n        distances = torch.cdist(query_pos, query_pos)\r\n        model.probe_neighbor_ranks = distances.argsort(-1).argsort(-1) + 1\r\n\r\n    model.dec.register_forward_pre_hook(capture)\r\n    model.dec.sampling_module.register_forward_hook(capture_sampling)\r\n    model.predict_by_feat = types.MethodType(predictor(), model)\r\n    rows = []\r\n    for index in range(min(args.scenes, len(dataset))):\r\n        model.probe_scene_index = index\r\n        with torch.no_grad():\r\n            rows.extend(model(dataset.collate_fn([dataset[index]]), mode=\"predict\")[\"rows\"])\r\n    errors = [r for r in rows if r[\"oracle_iou\"] - r[\"selected_iou\"] > 0.05]\r\n    result = {\r\n        \"checkpoint\": args.checkpoint,\r\n        \"scenes\": min(args.scenes, len(dataset)),\r\n        \"expressions\": len(rows),\r\n        \"material_errors\": len(errors),\r\n        \"error_pair_disjoint\": sum(r[\"pair_overlap\"] < 0.5 for r in errors),\r\n        \"error_mutual_outside_final_four\": sum(\r\n            r[\"selected_to_oracle_rank\"] > 4 and r[\"oracle_to_selected_rank\"] > 4\r\n            for r in errors\r\n        ),\r\n        \"error_mutual_outside_initial_128\": sum(\r\n            r[\"selected_to_oracle_rank\"] > 128 and r[\"oracle_to_selected_rank\"] > 128\r\n            for r in errors\r\n        ),\r\n        \"mean_selected_to_oracle_rank\": statistics.fmean(\r\n            r[\"selected_to_oracle_rank\"] for r in errors\r\n        ),\r\n        \"rows\": rows,\r\n    }\r\n    Path(args.output).write_text(json.dumps(result, indent=2), encoding=\"utf-8\")\r\n    print(json.dumps({key: value for key, value in result.items() if key != \"rows\"}))\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\nGet-Content: \r\nLine |\r\n   2 |  … lCount 190; Get-Content AdaRES/ipdn/model_paper5/adares_b4_query_comp …\r\n     |                ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\r\n     | 找不到路径“D:\\project\\AdaRES_project\\AdaRES\\ipdn\\model_paper5\\adares_b4_query_competition\\model.py”，因为该路径不存在。\r\n","exit_code":1,"status":"failed"}}
