{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"\"C:\\\\Users\\\\chuanle song\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\pwsh.exe\" -Command 'Get-Content AdaRES/ipdn/model_paper5/adares_b4_query_competition/dec.py -TotalCount 300; Get-Content pipeline/reports/summary_20260926-235952.md'","aggregated_output":"import torch\r\nimport torch.nn as nn\r\nfrom .sample_model import SamplingModule\r\nimport ipdn.torch.nn_new.functional as F\r\nfrom ipdn.torch.nn_new import MultiheadAttention\r\n\r\nclass ThreeLayerMLP(nn.Module):\r\n    \"\"\"A 3-layer MLP with normalization and dropout.\"\"\"\r\n\r\n    def __init__(self, dim, out_dim):\r\n        super().__init__()\r\n        self.net = nn.Sequential(\r\n            nn.Conv1d(dim, dim, 1, bias=False),\r\n            nn.BatchNorm1d(dim),\r\n            nn.ReLU(),\r\n            nn.Dropout(0.3),\r\n            nn.Conv1d(dim, dim, 1, bias=False),\r\n            nn.BatchNorm1d(dim),\r\n            nn.ReLU(),\r\n            nn.Dropout(0.3),\r\n            nn.Conv1d(dim, out_dim, 1)\r\n        )\r\n\r\n    def forward(self, x):\r\n        \"\"\"Forward pass, x can be (B, dim, N).\"\"\"\r\n        return self.net(x)\r\n\r\nclass CrossAttentionLayer(nn.Module):\r\n\r\n    def __init__(self, d_model=256, nhead=8, dropout=0.0):\r\n        super().__init__()\r\n        self.attn = MultiheadAttention(d_model, nhead, dropout=dropout, batch_first=True)\r\n        self.norm = nn.LayerNorm(d_model)\r\n        self.dropout = nn.Dropout(dropout)\r\n        self._reset_parameters()\r\n        self.nhead = nhead\r\n\r\n    def _reset_parameters(self):\r\n        for p in self.parameters():\r\n            if p.dim() > 1:\r\n                nn.init.xavier_uniform_(p)\r\n\r\n    def with_pos_embed(self, tensor, pos):\r\n        return tensor if pos is None else tensor + pos\r\n\r\n    def forward(self, source, query, batch_mask=None, attn_mask=None, pe=None, att_weights=None):\r\n        \"\"\"\r\n        source (B, N_p, d_model)\r\n        batch_offsets Tensor (b, n_p)\r\n        query Tensor (b, n_q, d_model)\r\n        attn_masks Tensor (b, n_q, n_p)\r\n        \"\"\"\r\n        B = query.shape[0]\r\n        query = self.with_pos_embed(query, pe)\r\n        k = v = source\r\n        if attn_mask is not None:\r\n            attn_mask = attn_mask.unsqueeze(1).repeat(1, self.nhead, 1, 1).view(B*self.nhead, query.shape[1], k.shape[1])\r\n            output, output_weight, src_weight = self.attn(query, k, v, key_padding_mask=batch_mask, attn_mask=attn_mask, att_weights =att_weights)  # (1, 100, d_model)\r\n        else:\r\n            output, output_weight, src_weight = self.attn(query, k, v, key_padding_mask=batch_mask, att_weights =att_weights)\r\n        self.dropout(output)\r\n        output = output + query\r\n        self.norm(output)\r\n\r\n        return output, output_weight, src_weight # (b, n_q, d_model), (b, n_q, n_v)\r\n\r\nclass SelfAttentionLayer(nn.Module):\r\n\r\n    def __init__(self, d_model=256, nhead=8, dropout=0.0, glu = False):\r\n        super().__init__()\r\n        self.attn = MultiheadAttention(\r\n            d_model,\r\n            nhead,\r\n            dropout=dropout,\r\n            batch_first=True,\r\n        )\r\n        self.nhead = nhead\r\n        self.norm = nn.LayerNorm(d_model)\r\n        self.dropout = nn.Dropout(dropout)\r\n        self.glu = glu\r\n        if glu:\r\n            self.glu_p = nn.Linear(d_model, d_model)\r\n            self.glu_g = nn.Linear(d_model, d_model)\r\n\r\n    def with_pos_embed(self, tensor, pos):\r\n        return tensor if pos is None else tensor + pos\r\n\r\n    def forward(self, x, x_mask=None, attn_mask=None, pe=None, norm=True, att_weights=None):\r\n        \"\"\"\r\n        x Tensor (b, n_w, c)\r\n        x_mask Tensor (b, n_w)\r\n        \"\"\"\r\n        B = x.shape[0]\r\n        q = k = self.with_pos_embed(x, pe)\r\n        if attn_mask is not None:\r\n            attn_mask = attn_mask.unsqueeze(1).repeat(1, self.nhead, 1, 1).view(B*self.nhead, q.shape[1], k.shape[1])\r\n            output, output_weight, src_weight = self.attn(q, k, x, key_padding_mask=x_mask, attn_mask=attn_mask, att_weights =att_weights)  # (1, 100, d_model)\r\n        else:\r\n            output, output_weight, src_weight = self.attn(q, k, x, key_padding_mask=x_mask, att_weights =att_weights)\r\n        if self.glu:\r\n            output = self.glu_p(output) * (self.glu_g(output).sigmoid())\r\n        output = self.dropout(output) + x\r\n        if norm: output = self.norm(output)\r\n        return output\r\n\r\nclass FFN(nn.Module):\r\n\r\n    def __init__(self, d_model, hidden_dim, dropout=0.0, activation_fn='relu'):\r\n        super().__init__()\r\n        if activation_fn == 'relu':\r\n            self.net = nn.Sequential(\r\n                nn.Linear(d_model, hidden_dim),\r\n                nn.ReLU(),\r\n                nn.Dropout(dropout),\r\n                nn.Linear(hidden_dim, d_model),\r\n                nn.Dropout(dropout),\r\n            )\r\n        elif activation_fn == 'gelu':\r\n            self.net = nn.Sequential(\r\n                nn.Linear(d_model, hidden_dim),\r\n                nn.GELU(),\r\n                nn.Dropout(dropout),\r\n                nn.Linear(hidden_dim, d_model),\r\n                nn.Dropout(dropout),\r\n            )\r\n        self.norm = nn.LayerNorm(d_model)\r\n\r\n    def forward(self, x, norm=True):\r\n        output = self.net(x)\r\n        output = output + x\r\n        if norm: output = self.norm(output)\r\n        return output\r\n\r\nclass MLP(nn.Module):\r\n    \"\"\" Very simple multi-layer perceptron (also called FFN)\"\"\"\r\n\r\n    def __init__(self, input_dim, hidden_dim, output_dim, num_layers):\r\n        super().__init__()\r\n        self.num_layers = num_layers\r\n        h = [hidden_dim] * (num_layers - 1)\r\n        self.layers = nn.ModuleList(nn.Linear(n, k) for n, k in zip([input_dim] + h, h + [output_dim]))\r\n\r\n    def forward(self, x):\r\n        for i, layer in enumerate(self.layers):\r\n            x = F.relu(layer(x)) if i < self.num_layers - 1 else layer(x)\r\n        return x\r\n\r\n\r\nclass QueryCompetitionIndicator(nn.Module):\r\n    \"\"\"Predict confidence from a query and its overlapping competitors.\"\"\"\r\n\r\n    def __init__(self, d_model):\r\n        super().__init__()\r\n        self.query_norm = nn.LayerNorm(d_model)\r\n        self.evidence_norm = nn.LayerNorm(3 * d_model + 1)\r\n        self.head = nn.Sequential(\r\n            nn.Linear(3 * d_model + 1, d_model),\r\n            nn.GELU(),\r\n            nn.Linear(d_model, d_model),\r\n            nn.GELU(),\r\n            nn.Linear(d_model, 2),\r\n        )\r\n\r\n    def forward(self, query, pred_masks, batch_mask):\r\n        valid = (~batch_mask).unsqueeze(1).to(pred_masks.dtype)\r\n        probabilities = pred_masks.sigmoid() * valid\r\n        areas = probabilities.sum(-1)\r\n        intersection = torch.einsum(\r\n            'bim,bjm->bij', probabilities, probabilities\r\n        )\r\n        union = areas.unsqueeze(-1) + areas.unsqueeze(1) - intersection\r\n        overlap = intersection / union.clamp_min(1e-6)\r\n        diagonal = torch.eye(\r\n            overlap.shape[-1], dtype=torch.bool, device=overlap.device\r\n        ).unsqueeze(0)\r\n        overlap = overlap.masked_fill(diagonal, 0.0)\r\n\r\n        competition = overlap / overlap.sum(-1, keepdim=True).clamp_min(1e-6)\r\n        normalized_query = self.query_norm(query)\r\n        context = torch.einsum('bij,bjd->bid', competition, normalized_query)\r\n        max_overlap = overlap.max(-1).values.unsqueeze(-1)\r\n        evidence = torch.cat(\r\n            [\r\n                normalized_query,\r\n                context,\r\n                normalized_query - context,\r\n                max_overlap,\r\n            ],\r\n            dim=-1,\r\n        )\r\n        return self.head(self.evidence_norm(evidence))\r\n    \r\n    \r\nclass DEC(nn.Module):\r\n    \"\"\"\r\n    in_channels List[int] (4,) [64,96,128,160]\r\n    \"\"\"\r\n    def __init__(\r\n        self,\r\n        num_layer=6,\r\n        num_class=256,\r\n        in_channel=32,\r\n        d_model=256,\r\n        nhead=8,\r\n        hidden_dim=1024,\r\n        dropout=0.0,\r\n        activation_fn='relu',\r\n        iter_pred=False,\r\n        attn_mask=False,\r\n        sampling_module=None,\r\n        kernel='top1',\r\n        global_feat='mean',\r\n        lang_att=False,\r\n        contrastive_align_loss=False,\r\n        num_proposal_fine=512,\r\n        num_proposal_query = [128,64,32,16,8,4],\r\n        num_proposal_query_inst = [128,64,32,16,8,4]\r\n    ):\r\n        super().__init__()\r\n        self.num_layer = num_layer\r\n        self.num_class = num_class\r\n        self.d_model = d_model\r\n        self.input_proj = nn.Sequential(nn.Linear(in_channel, d_model), nn.LayerNorm(d_model), nn.ReLU())\r\n        \r\n        self.input_proj_2d = nn.Sequential(nn.Linear(1024, d_model*2),nn.ReLU(),nn.Linear(d_model*2, d_model),nn.ReLU(),nn.Linear(d_model, d_model))#clip\r\n        self.sum_norm = nn.LayerNorm(d_model)\r\n        \r\n        self.lang_att = lang_att\r\n        self.contrastive_align_loss = contrastive_align_loss\r\n\r\n        H = 768\r\n        self.lang_proj = nn.Linear(H, d_model)\r\n        self.lang_norm = nn.LayerNorm(d_model)\r\n        \r\n        if sampling_module is not None:\r\n            self.sampling_module = SamplingModule(**sampling_module)\r\n        else:\r\n            self.sampling_module = None\r\n        self.num_proposal_fine = num_proposal_fine\r\n        self.num_proposal_query = num_proposal_query\r\n        self.num_proposal_query_inst = num_proposal_query_inst\r\n        self.query_generator = nn.Sequential(nn.Linear(d_model, d_model),nn.ReLU(),nn.Linear(d_model, d_model),nn.ReLU(),nn.Linear(d_model, d_model))\r\n        \r\n        # DDI and SWA\r\n        self.qia_layers = nn.ModuleList([])\r\n        self.qia_layers_fine = nn.ModuleList([])\r\n        self.qla_layers = nn.ModuleList([])\r\n        self.qqa_layers = nn.ModuleList([])\r\n        self.qqa_ffn_layers = nn.ModuleList([])\r\n        self.qia_ffn_layers = nn.ModuleList([])\r\n        self.sem_cls_heads = nn.ModuleList([])\r\n        # self.scg = nn.ModuleList([])\r\n        self.lqg = nn.ModuleList([])\r\n        if self.lang_att:\r\n            self.lla_layers = nn.ModuleList([])\r\n            self.lia_layers = nn.ModuleList([])\r\n            self.ila_layers = nn.ModuleList([])\r\n            self.lia_ffn_layers = nn.ModuleList([])\r\n            self.ila_ffn_layers = nn.ModuleList([])\r\n        for i in range(num_layer):\r\n            self.qia_layers.append(CrossAttentionLayer(d_model, nhead, dropout))\r\n            self.qia_layers_fine.append(CrossAttentionLayer(d_model, nhead, dropout))\r\n            self.qla_layers.append(CrossAttentionLayer(d_model, nhead, dropout))\r\n            self.qqa_layers.append(SelfAttentionLayer(d_model, nhead, dropout))\r\n            self.qqa_ffn_layers.append(FFN(d_model, hidden_dim, dropout, activation_fn))\r\n            self.qia_ffn_layers.append(FFN(d_model, hidden_dim, dropout, activation_fn))\r\n            \r\n            self.sem_cls_heads.append(ThreeLayerMLP(d_model, self.num_class))\r\n            # self.scg.append(SelfAttentionLayer(d_model, nhead, dropout))\r\n            self.lqg.append(CrossAttentionLayer(d_model, nhead, dropout))\r\n\r\n            self.lla_layers.append(SelfAttentionLayer(d_model, nhead, dropout))\r\n            self.lia_layers.append(CrossAttentionLayer(d_model, nhead, dropout))\r\n            self.ila_layers.append(CrossAttentionLayer(d_model, nhead, dropout))\r\n            self.lia_ffn_layers.append(FFN(d_model, hidden_dim, dropout, activation_fn))    \r\n            self.ila_ffn_layers.append(FFN(d_model, hidden_dim, dropout, activation_fn))    \r\n        self.norm_qqa = nn.LayerNorm(d_model)\r\n\r\n        self.sem_cls_head = ThreeLayerMLP(d_model, self.num_class)\r\n\r\n        self.out_norm = nn.LayerNorm(d_model)\r\n        self.out_score = nn.Sequential(nn.Linear(d_model, d_model), nn.ReLU(), nn.Linear(d_model, 1))\r\n        self.x_mask = nn.Sequential(nn.Linear(in_channel, d_model), nn.ReLU(), nn.Linear(d_model, d_model))\r\n        \r\n        self.indi_embedding = QueryCompetitionIndicator(d_model)\r\n        self.indi_norm = nn.LayerNorm(d_model)\r\n\r\n        self.iter_pred = iter_pred\r\n        self.attn_mask = attn_mask\r\n\r\n        \r\n\r\n        # Extra layers for contrastive losses\r\n        if contrastive_align_loss:\r\n            self.contrastive_align_projection_vision = nn.Sequential(nn.Linear(d_model, d_model),nn.ReLU(),nn.Linear(d_model, d_model),nn.ReLU(),nn.Linear(d_model, 64))\r\n            self.contrastive_align_projection_text = nn.Sequential(nn.Linear(d_model, d_model),nn.ReLU(),nn.Linear(d_model, d_model),nn.ReLU(),nn.Linear(d_model, 64))         \r\n        \r\n        self.scg_head = SelfAttentionLayer(d_model, nhead, dropout=0, glu=True)\r\n        \r\n    \r\n================================================================================\r\n  Research Pipeline Report - AdaRES_project\r\n  2026-09-26 23:59 Asia/Shanghai (design tick)\r\n================================================================================\r\n\r\n## 0. Goal Status\r\n| Target | Champion | Gap | Phase |\r\n|---|---|---|---|\r\n| ScanRefer mIoU >= 0.5150 | AdaRES-B4-E30 0.5094 | +0.0056 | Phase 1 unmet; Phase 2 pending |\r\n\r\nB1 baseline 0.5020; champion gain +0.0074. Prepared monitor and goal checks succeeded once and were not rerun.\r\n\r\n## 1. GPU Overview\r\n| Server | GPU | Util | Memory Used | Assignment |\r\n|---|---:|---:|---:|---|\r\n| server-2 | 0 | 0% before probes | 1 MiB before probes | no project task; T1/T2 probes completed |\r\n| server-2 | 1 | 0% before probes | 1 MiB before probes | no project task |\r\n\r\nOne targeted GPU query preceded read-only probes; no post-probe utilization claim. Server-6 excluded.\r\n\r\n## 2. Running Experiments\r\n| ID | Config | Server | GPU | Epoch | Best mIoU | Acc@50 | spmIoU | No-Impr | Status |\r\n|---|---|---|---|---|---|---|---|---|---|---|\r\n| - | - | - | - | - | - | - | - | - | none |\r\n\r\n## 3. Queue Status\r\n| Position | ID | Config | Status | Depends On | Server |\r\n|---|---|---|---|---|---|\r\n| - | - | - | no waiting or claiming tasks | - | - |\r\n\r\nActive 0/2 target; admission budget 2. No due research candidates. T1/T2 failed diagnosis/controls.\r\n\r\n## 4. This Tick's Actions\r\n- T1 fixed train64 strongest-competitor counterfactual and distant-peer control: 1660 expressions, 388 material errors, repeat mismatch 0. Frozen selector 0.82133 versus B4 0.82256. Rejected.\r\n- T2 independent local 3D-feature permutation with equal-count outside-mask control: repeat mismatch 0; inside/outside post-intervention mIoU 0.80091/0.82279. Frozen top-two selector 0.81370 versus B4 0.82256 and outside 0.82307. Rejected.\r\n- Archived raw JSON, scripts, diagnosis/review/design, hashes and ledger. No backward, training-resource gate, model/config package, admission receipt, training sync, dispatch or queue mutation. Inference memory peaks 3.48/6.02 GiB are not training peaks.\r\n- No pending questions in snapshot. Bounded distinct routes exhausted this cycle, not global hypothesis exhaustion.\r\n\r\n## 5. Decisions Made\r\n- 2026-09-26 23:59 `route_change`: reject T1/T2; leave both server-2 slots unqueued. See `pipeline/decisions/20260926-235952_route_change.md`.\r\n\r\n================================================================================\r\n  Next tick: scheduled pipeline tick\r\n================================================================================\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"\"C:\\\\Users\\\\chuanle song\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\pwsh.exe\" -Command 'Get-Content AdaRES/tools/diagnose_adares_t1_competitor_influence.py -TotalCount 230; Get-Content AdaRES/tools/diagnose_adares_b4_selection.py -TotalCount 180'","aggregated_output":"import argparse\r\nimport json\r\nimport statistics\r\nimport sys\r\nimport types\r\nfrom pathlib import Path\r\n\r\nimport gorilla\r\nimport torch\r\nimport torch.nn.functional as F\r\n\r\nROOT = Path(__file__).resolve().parents[1]\r\nsys.path.insert(0, str(ROOT))\r\n\r\nfrom ipdn.dataset import build_dataset\r\nfrom ipdn.model_paper5.adares_b4_query_competition import IPDN\r\nfrom ipdn.utils import get_root_logger\r\n\r\n\r\ndef counterfactual_scores(indicator, query, pred_masks, batch_mask):\r\n    valid = (~batch_mask).unsqueeze(1).to(pred_masks.dtype)\r\n    probabilities = pred_masks.sigmoid() * valid\r\n    areas = probabilities.sum(-1)\r\n    intersection = probabilities @ probabilities.transpose(1, 2)\r\n    overlap = intersection / (\r\n        areas[:, :, None] + areas[:, None, :] - intersection\r\n    ).clamp_min(1e-6)\r\n    diagonal = torch.eye(\r\n        overlap.shape[-1], dtype=torch.bool, device=overlap.device\r\n    ).unsqueeze(0)\r\n    overlap = overlap.masked_fill(diagonal, 0)\r\n    closest = overlap.argmax(-1)\r\n    farthest = overlap.masked_fill(diagonal, float(\"inf\")).argmin(-1)\r\n    normalized = indicator.query_norm(query)\r\n\r\n    def evaluate(dropped):\r\n        competing = overlap.clone()\r\n        competing.scatter_(2, dropped.unsqueeze(-1), 0)\r\n        weights = competing / competing.sum(-1, keepdim=True).clamp_min(1e-6)\r\n        context = weights @ normalized\r\n        evidence = torch.cat((\r\n            normalized, context, normalized - context,\r\n            competing.max(-1).values.unsqueeze(-1),\r\n        ), dim=-1)\r\n        return indicator.head(indicator.evidence_norm(evidence)).softmax(-1)[..., 1]\r\n\r\n    return evaluate(closest), evaluate(farthest), overlap.gather(\r\n        2, closest.unsqueeze(-1)\r\n    ).squeeze(-1)\r\n\r\n\r\ndef predictor(self, scan_ids, object_idss, ann_ids, out, superpoints,\r\n              gt_pmasks, gt_spmasks, fps_seed_sp):\r\n    query, masks, batch_mask = self.probe_indicator_inputs\r\n    closest, farthest, max_overlap = counterfactual_scores(\r\n        self.dec.indi_embedding, query, masks, batch_mask\r\n    )\r\n    base = out[\"indis\"].softmax(-1)[..., 1]\r\n    rows = []\r\n    for index, target in enumerate(gt_pmasks):\r\n        point_masks = out[\"masks\"][index].sigmoid().gt(0.5)[:, superpoints]\r\n        truth = target.gt(0.5).to(point_masks.device)\r\n        ious = (point_masks & truth).sum(-1).float() / (\r\n            (point_masks | truth).sum(-1).clamp_min(1).float()\r\n        )\r\n        selected, oracle = int(base[index].argmax()), int(ious.argmax())\r\n        rows.append({\r\n            \"selected\": selected,\r\n            \"oracle\": oracle,\r\n            \"selected_iou\": float(ious[selected]),\r\n            \"oracle_iou\": float(ious[oracle]),\r\n            \"selected_influence\": float(closest[index, selected] - base[index, selected]),\r\n            \"oracle_influence\": float(closest[index, oracle] - base[index, oracle]),\r\n            \"selected_control\": float(farthest[index, selected] - base[index, selected]),\r\n            \"oracle_control\": float(farthest[index, oracle] - base[index, oracle]),\r\n            \"selected_overlap\": float(max_overlap[index, selected]),\r\n            \"oracle_overlap\": float(max_overlap[index, oracle]),\r\n            \"closest_iou\": float(ious[closest[index].argmax()]),\r\n            \"farthest_iou\": float(ious[farthest[index].argmax()]),\r\n            \"closest_flip\": int(closest[index].argmax()) != selected,\r\n            \"farthest_flip\": int(farthest[index].argmax()) != selected,\r\n        })\r\n    return {\"rows\": rows}\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser()\r\n    parser.add_argument(\"config\")\r\n    parser.add_argument(\"checkpoint\")\r\n    parser.add_argument(\"--output\", required=True)\r\n    parser.add_argument(\"--scenes\", type=int, default=64)\r\n    parser.add_argument(\"--gpu-id\", type=int, default=0)\r\n    args = parser.parse_args()\r\n    gorilla.set_cuda_visible_devices([args.gpu_id], 1)\r\n    gorilla.set_random_seed(1999)\r\n    cfg = gorilla.Config.fromfile(args.config)\r\n    data_cfg = cfg.data.train.copy()\r\n    data_cfg.training = False\r\n    data_cfg.aug = False\r\n    data_cfg.with_elastic = False\r\n    data_cfg.lang_num_max = 32\r\n    dataset = build_dataset(data_cfg, get_root_logger())\r\n    model = IPDN(**cfg.model).cuda()\r\n    checkpoint = torch.load(args.checkpoint, map_location=\"cpu\")\r\n    loaded = model.load_state_dict(checkpoint.get(\"model\", checkpoint), strict=False)\r\n    allowed = {\r\n        \"text_encoder.embeddings.position_ids\",\r\n        \"text_encoder.embeddings.token_type_ids\",\r\n    }\r\n    if loaded.missing_keys or set(loaded.unexpected_keys) - allowed:\r\n        raise RuntimeError(f\"Checkpoint mismatch: {loaded}\")\r\n    model.eval()\r\n\r\n    def capture(module, inputs, output):\r\n        model.probe_indicator_inputs = inputs\r\n\r\n    model.dec.indi_embedding.register_forward_hook(capture)\r\n    model.predict_by_feat = types.MethodType(predictor, model)\r\n    rows = []\r\n    repeat_mismatch = 0\r\n    for scene in range(min(args.scenes, len(dataset))):\r\n        batch = dataset.collate_fn([dataset[scene]])\r\n        with torch.no_grad():\r\n            first = model(batch, mode=\"predict\")[\"rows\"]\r\n            second = model(batch, mode=\"predict\")[\"rows\"]\r\n        repeat_mismatch += sum(\r\n            a[\"selected\"] != b[\"selected\"]\r\n            or a[\"oracle\"] != b[\"oracle\"]\r\n            or abs(a[\"selected_influence\"] - b[\"selected_influence\"]) > 1e-4\r\n            for a, b in zip(first, second)\r\n        )\r\n        rows.extend(first)\r\n    errors = [r for r in rows if r[\"oracle_iou\"] - r[\"selected_iou\"] > 0.05]\r\n    result = {\r\n        \"scenes\": min(args.scenes, len(dataset)),\r\n        \"expressions\": len(rows),\r\n        \"material_errors\": len(errors),\r\n        \"repeat_mismatch\": repeat_mismatch,\r\n        \"oracle_influence_higher\": sum(\r\n            r[\"oracle_influence\"] > r[\"selected_influence\"] for r in errors\r\n        ),\r\n        \"oracle_control_higher\": sum(\r\n            r[\"oracle_control\"] > r[\"selected_control\"] for r in errors\r\n        ),\r\n        \"oracle_overlap_higher\": sum(\r\n            r[\"oracle_overlap\"] > r[\"selected_overlap\"] for r in errors\r\n        ),\r\n        \"indicator_miou\": statistics.fmean(r[\"selected_iou\"] for r in rows),\r\n        \"closest_miou\": statistics.fmean(r[\"closest_iou\"] for r in rows),\r\n        \"farthest_miou\": statistics.fmean(r[\"farthest_iou\"] for r in rows),\r\n        \"closest_flips\": sum(r[\"closest_flip\"] for r in rows),\r\n        \"farthest_flips\": sum(r[\"farthest_flip\"] for r in rows),\r\n        \"peak_reserved_gib\": torch.cuda.max_memory_reserved() / 2**30,\r\n        \"rows\": rows,\r\n    }\r\n    Path(args.output).write_text(json.dumps(result, indent=2), encoding=\"utf-8\")\r\n    print(json.dumps({k: v for k, v in result.items() if k != \"rows\"}))\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\nimport argparse\r\nimport json\r\nimport statistics\r\nimport sys\r\nimport types\r\nfrom pathlib import Path\r\n\r\nimport gorilla\r\nimport torch\r\nimport torch.nn.functional as F\r\n\r\nROOT = Path(__file__).resolve().parents[1]\r\nsys.path.insert(0, str(ROOT))\r\n\r\nfrom ipdn.dataset import build_dataset\r\nfrom ipdn.utils import get_root_logger\r\n\r\n\r\ndef selection_predictor():\r\n    def predict_by_feat(\r\n        self, scan_ids, object_idss, ann_ids, out, superpoints,\r\n        gt_pmasks, gt_spmasks, fps_seed_sp,\r\n    ):\r\n        rows = []\r\n        for index, target in enumerate(gt_pmasks):\r\n            masks = out[\"masks\"][index].sigmoid().gt(0.5)\r\n            scores = F.softmax(out[\"indis\"][index], dim=-1)[:, 1]\r\n            selected = int(scores.argmax())\r\n            point_masks = masks[:, superpoints]\r\n            truth = target.gt(0.5).to(point_masks.device)\r\n            intersection = (point_masks & truth).sum(-1).float()\r\n            union = (point_masks | truth).sum(-1).float()\r\n            ious = intersection / union.clamp_min(1)\r\n            oracle = int(ious.argmax())\r\n            pair_intersection = (masks[selected] & masks[oracle]).sum().float()\r\n            pair_union = (masks[selected] | masks[oracle]).sum().float()\r\n            rows.append({\r\n                \"selected_iou\": float(ious[selected]),\r\n                \"oracle_iou\": float(ious[oracle]),\r\n                \"selected_oracle_overlap\": float(\r\n                    pair_intersection / pair_union.clamp_min(1)\r\n                ),\r\n                \"oracle_score_rank\": int(\r\n                    (scores.argsort(descending=True) == oracle)\r\n                    .nonzero(as_tuple=True)[0].item()\r\n                ) + 1,\r\n                \"selected_query\": selected,\r\n                \"oracle_query\": oracle,\r\n            })\r\n        return {\"rows\": rows}\r\n\r\n    return predict_by_feat\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser()\r\n    parser.add_argument(\"config\")\r\n    parser.add_argument(\"checkpoint\")\r\n    parser.add_argument(\"--output\", required=True)\r\n    parser.add_argument(\"--scenes\", type=int, default=16)\r\n    parser.add_argument(\"--gpu-id\", type=int, default=1)\r\n    parser.add_argument(\r\n        \"--model\",\r\n        choices=(\"adares_b4_query_competition\", \"adares_g1_metric_targets\"),\r\n        default=\"adares_b4_query_competition\",\r\n    )\r\n    args = parser.parse_args()\r\n\r\n    if args.model == \"adares_g1_metric_targets\":\r\n        from ipdn.model_paper5.adares_g1_metric_targets import IPDN\r\n    else:\r\n        from ipdn.model_paper5.adares_b4_query_competition import IPDN\r\n\r\n    gorilla.set_cuda_visible_devices([args.gpu_id], 1)\r\n    gorilla.set_random_seed(1999)\r\n    cfg = gorilla.Config.fromfile(args.config)\r\n    data_cfg = cfg.data.val.copy()\r\n    data_cfg.training = False\r\n    data_cfg.aug = False\r\n    data_cfg.with_elastic = False\r\n    data_cfg.lang_num_max = 32\r\n    logger = get_root_logger()\r\n    dataset = build_dataset(data_cfg, logger)\r\n    model = IPDN(**cfg.model).cuda()\r\n    model.eval()\r\n    checkpoint = torch.load(args.checkpoint, map_location=\"cpu\")\r\n    state = checkpoint.get(\"model\", checkpoint)\r\n    loaded = model.load_state_dict(state, strict=False)\r\n    allowed = {\r\n        \"text_encoder.embeddings.position_ids\",\r\n        \"text_encoder.embeddings.token_type_ids\",\r\n    }\r\n    if loaded.missing_keys or set(loaded.unexpected_keys) - allowed:\r\n        raise RuntimeError(f\"Checkpoint mismatch: {loaded}\")\r\n    model.predict_by_feat = types.MethodType(selection_predictor(), model)\r\n\r\n    rows = []\r\n    for index in range(min(args.scenes, len(dataset))):\r\n        batch = dataset.collate_fn([dataset[index]])\r\n        with torch.no_grad():\r\n            rows.extend(model(batch, mode=\"predict\")[\"rows\"])\r\n    if not rows:\r\n        raise RuntimeError(\"No expressions in diagnostic subset\")\r\n    errors = [row for row in rows if row[\"oracle_iou\"] - row[\"selected_iou\"] > 0.05]\r\n    result = {\r\n        \"checkpoint\": args.checkpoint,\r\n        \"scenes\": min(args.scenes, len(dataset)),\r\n        \"expressions\": len(rows),\r\n        \"top1_miou\": statistics.fmean(row[\"selected_iou\"] for row in rows),\r\n        \"oracle_miou\": statistics.fmean(row[\"oracle_iou\"] for row in rows),\r\n        \"material_error_count\": len(errors),\r\n        \"error_pair_overlap_mean\": (\r\n            statistics.fmean(row[\"selected_oracle_overlap\"] for row in errors)\r\n            if errors else None\r\n        ),\r\n        \"error_pair_overlap_ge_half\": sum(\r\n            row[\"selected_oracle_overlap\"] >= 0.5 for row in errors\r\n        ),\r\n        \"error_oracle_rank_le_three\": sum(\r\n            row[\"oracle_score_rank\"] <= 3 for row in errors\r\n        ),\r\n        \"rows\": rows,\r\n    }\r\n    Path(args.output).write_text(json.dumps(result, indent=2), encoding=\"utf-8\")\r\n    print(json.dumps({key: value for key, value in result.items() if key != \"rows\"}))\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n","exit_code":0,"status":"completed"}}
