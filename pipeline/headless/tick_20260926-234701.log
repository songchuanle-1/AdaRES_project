size())\r\n 331:         # pp\r\n 332:         # seed_sp = self.scg_head(seed_sp, seed_sp, seed_sp, attention_weights = scg_weights)\r\n 333:         seed_sp = self.scg_head(seed_sp, att_weights = scg_weights)\r\n 334: \r\n 335:          # sampling\r\n 336:         if hasattr(self, 'sampling_module') and self.sampling_module is not None:\r\n 337:             sample_inds, ref_scores = self.sampling_module(seed_sp, lang_feats, None, lang_masks)\r\n 338:             sample_inds = sample_inds.long()\r\n 339:             sampled_seed = seed_sp.gather(dim=1, index=sample_inds.unsqueeze(-1).repeat(1, 1, seed_sp.size(-1)))\r\n 340:             query_pos = seed_sp_pos.gather(dim=1, index=sample_inds.unsqueeze(-1).repeat(1, 1, seed_sp_pos.size(-1)))\r\n 341:             query = self.query_generator(sampled_seed)\r\n 342:         else:\r\n 343:             query = self.query_generator(seed_sp)\r\n 344:             query_pos = seed_sp_pos\r\n 345:             \r\n 346:         # scg_weights = self.get_scg_weight(query_pos)\r\n 347: \r\n 348:         proj_queries = []\r\n 349:         if self.contrastive_align_loss:\r\n 350:             proj_queries.append(F.normalize(self.contrastive_align_projection_vision(query), p=2, dim=-1))\r\n 351:         else:\r\n 352:             proj_queries.append(None)\r\n 353:             \r\n 354:         proj_tokens = []\r\n 355:         if self.contrastive_align_loss:\r\n 356:             proj_tokens.append(F.normalize(self.contrastive_align_projection_text(lang_feats), p=2, dim=-1))\r\n 357:         else:\r\n 358:             proj_tokens.append(None)\r\n 359:         \r\n 360:         \r\n 361:         pred_scores, pred_masks, attn_masks = self.prediction_head(query, mask_feats, batch_mask)\r\n 362:         pred_indis = self.indi_embedding(query, pred_masks, batch_mask)\r\n 363:         prediction_scores.append(pred_scores)\r\n 364:         prediction_masks.append(pred_masks)\r\n 365:         prediction_indis.append(pred_indis)\r\n 366:         \r\n 367:         lang_query = lang_feats\r\n 368:         \r\n 369:         # multi-round\r\n 370: \r\n 371:         for i in range(self.num_layer):\r\n 372:             \r\n 373:             lang_query = self.lla_layers[i](lang_query, lang_masks)\r\n 374:             lang_query, _, _ = self.lia_layers[i](inst_feats, lang_query, batch_mask, None)\r\n 375:             inst_feats, _, _ = self.ila_layers[i](lang_query, inst_feats, lang_masks, None)\r\n 376:             lang_query = self.lia_ffn_layers[i](lang_query)\r\n 377:             inst_feats = self.ila_ffn_layers[i](inst_feats)\r\n 378: \r\n 379:             coarse_query, coarse_att, _ = self.qia_layers[i](inst_feats, query, batch_mask, attn_masks)\r\n 380:             coarse_query_ffn = self.qia_ffn_layers[i](coarse_query)\r\n 381:             ### 细粒度\r\n 382:             ### 利用coarse_att进行topk选择\r\n 383:             coarse_att = coarse_att * (~batch_mask.unsqueeze(1)).float()\r\n 384:             coarse_att = coarse_att.sum(-2)   # [B, N]\r\n 385:             if coarse_att.shape[1] < self.num_proposal_fine:\r\n 386:                 sample_inds_fine = torch.Tensor(list(range(coarse_att.shape[1]))).int().unsqueeze(0).repeat(coarse_att.shape[0], 1).cuda()\r\n 387:             else:   \r\n 388:                 sample_inds_fine = torch.topk(coarse_att, self.num_proposal_fine)[1].int() # (bsz, num_proposal_fine)    \r\n 389:             sample_inds_fine = sample_inds_fine.long()\r\n 390:             inst_feats_fine = inst_feats.gather(dim=1, index=sample_inds_fine.unsqueeze(-1).repeat(1, 1, inst_feats.size(-1)))\r\n 391:             inst_feats_fine_pos = sp_pos.gather(dim=1, index=sample_inds_fine.long().unsqueeze(-1).repeat(1, 1, sp_pos.size(-1)))\r\n 392:             scg_weights, scg_mask = self.get_scg_weight(query_pos,pos_k=inst_feats_fine_pos, k=self.num_proposal_query_inst[i]) #2**7 128\r\n 393:             \r\n 394:             fine_query, _, _ = self.qia_layers_fine[i](inst_feats_fine, coarse_query_ffn, attn_mask=~scg_mask, att_weights = scg_weights)\r\n 395:             query_qia = (coarse_query + fine_query)/2\r\n 396:             \r\n 397: \r\n 398:             query_qla, _, _ = self.qla_layers[i](lang_query, query_qia, lang_masks)\r\n 399:             _, scg_mask = self.get_scg_weight(query_pos, k=self.num_proposal_query[i]) #2**7 128\r\n 400: \r\n 401:             query_self = self.qqa_layers[i](query_qla, attn_mask=~scg_mask)\r\n 402: \r\n 403:             query = self.norm_qqa(query_self + query_qla)\r\n 404: \r\n 405:             \r\n 406:             query = self.qqa_ffn_layers[i](query)\r\n 407: \r\n 408: \r\n 409:             pred_scores, pred_masks, attn_masks = self.prediction_head(query, mask_feats, batch_mask)\r\n 410:             pred_indis = self.indi_embedding(query, pred_masks, batch_mask)\r\n 411:             prediction_scores.append(pred_scores)\r\n 412:             prediction_masks.append(pred_masks)\r\n 413:             prediction_indis.append(pred_indis)\r\n 414:             if self.contrastive_align_loss:\r\n 415:                 proj_queries.append(F.normalize(self.contrastive_align_projection_vision(query), p=2, dim=-1))\r\n 416:             else:\r\n 417:                 proj_queries.append(None)\r\n 418:                 \r\n 419:             if self.contrastive_align_loss:\r\n 420:                 proj_tokens.append(F.normalize(self.contrastive_align_projection_text(lang_query), p=2, dim=-1))\r\n 421:             else:\r\n 422:                 proj_tokens.append(None)\r\n 423: \r\n 424:         return {\r\n 425:             'masks': pred_masks,\r\n 426:             'batch_mask': batch_mask,\r\n 427:             'scores': pred_scores,\r\n 428:             'indis': pred_indis, # [B, B_q, 2]\r\n 429:             'proj_queries': proj_queries[-1],\r\n 430:             'proj_tokens': proj_tokens[-1],\r\n 431:             'sample_inds': sample_inds, # [B, K]\r\n 432:             'ref_scores': ref_scores, # [B, M]\r\n 433:             'aux_outputs': [{\r\n 434:                 'masks': a,\r\n 435:                 'scores': b,\r\n 436:                 'proj_queries': c,\r\n 437:                 'indis': d,\r\n 438:                 'proj_tokens': e,\r\n 439:             } for a, b, c, d, e in zip(\r\n 440:                 prediction_masks[:-1],\r\n 441:                 prediction_scores[:-1],\r\n 442:                 proj_queries[:-1],\r\n 443:                 prediction_indis[:-1],\r\n 444:                 proj_tokens[:-1],\r\n 445:             )],\r\n 446:         }\r\nimport argparse\r\nimport json\r\nimport statistics\r\nimport sys\r\nimport types\r\nfrom pathlib import Path\r\n\r\nimport gorilla\r\nimport torch\r\nimport torch.nn.functional as F\r\n\r\nROOT = Path(__file__).resolve().parents[1]\r\nsys.path.insert(0, str(ROOT))\r\n\r\nfrom ipdn.dataset import build_dataset\r\nfrom ipdn.model_paper5.adares_b4_query_competition import IPDN\r\nfrom ipdn.utils import get_root_logger\r\n\r\n\r\ndef predictor():\r\n    def predict_by_feat(\r\n        self, scan_ids, object_idss, ann_ids, out, superpoints,\r\n        gt_pmasks, gt_spmasks, fps_seed_sp,\r\n    ):\r\n        rows = []\r\n        valid = (~out[\"batch_mask\"]).float()\r\n        masks = out[\"masks\"].sigmoid() * valid[:, None, :]\r\n        scene = self.probe_scene\r\n        language = self.probe_language\r\n        token_mask = self.probe_token_mask.to(language.device).float()\r\n        text = (language * token_mask[:, :, None]).sum(1) / token_mask.sum(\r\n            1, keepdim=True\r\n        ).clamp_min(1)\r\n        fg = torch.bmm(masks, scene) / masks.sum(-1, keepdim=True).clamp_min(1e-6)\r\n        bg_weights = (1 - out[\"masks\"].sigmoid()) * valid[:, None, :]\r\n        bg = torch.bmm(bg_weights, scene) / bg_weights.sum(\r\n            -1, keepdim=True\r\n        ).clamp_min(1e-6)\r\n        contrast = F.cosine_similarity(fg - bg, text[:, None, :], dim=-1)\r\n        scene_mean = (scene * valid[:, :, None]).sum(1) / valid.sum(\r\n            1, keepdim=True\r\n        ).clamp_min(1)\r\n        scene_only = F.cosine_similarity(\r\n            fg - bg, scene_mean[:, None, :], dim=-1\r\n        )\r\n        intersection = torch.bmm(masks, masks.transpose(1, 2))\r\n        area = masks.sum(-1)\r\n        union = area[:, :, None] + area[:, None, :] - intersection\r\n        overlap = intersection / union.clamp_min(1e-6)\r\n        overlap.diagonal(dim1=1, dim2=2).zero_()\r\n        crowding = overlap.sum(-1)\r\n        indicator = F.softmax(out[\"indis\"], dim=-1)[..., 1]\r\n        for index, target in enumerate(gt_pmasks):\r\n            point_masks = out[\"masks\"][index].sigmoid().gt(0.5)[:, superpoints]\r\n            truth = target.gt(0.5).to(point_masks.device)\r\n            ious = (point_masks & truth).sum(-1).float() / (\r\n                (point_masks | truth).sum(-1).clamp_min(1).float()\r\n            )\r\n            selected = int(indicator[index].argmax())\r\n            oracle = int(ious.argmax())\r\n            rows.append({\r\n                \"scene_index\": self.probe_scene_index,\r\n                \"selected_iou\": float(ious[selected]),\r\n                \"oracle_iou\": float(ious[oracle]),\r\n                \"selected_contrast\": float(contrast[index, selected]),\r\n                \"oracle_contrast\": float(contrast[index, oracle]),\r\n                \"selected_scene_only\": float(scene_only[index, selected]),\r\n                \"oracle_scene_only\": float(scene_only[index, oracle]),\r\n                \"selected_crowding\": float(crowding[index, selected]),\r\n                \"oracle_crowding\": float(crowding[index, oracle]),\r\n                \"contrast_iou\": float(ious[contrast[index].argmax()]),\r\n                \"scene_only_iou\": float(ious[scene_only[index].argmax()]),\r\n            })\r\n        return {\"rows\": rows}\r\n\r\n    return predict_by_feat\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser()\r\n    parser.add_argument(\"config\")\r\n    parser.add_argument(\"checkpoint\")\r\n    parser.add_argument(\"--output\", required=True)\r\n    parser.add_argument(\"--scenes\", type=int, default=16)\r\n    parser.add_argument(\"--gpu-id\", type=int, default=1)\r\n    args = parser.parse_args()\r\n\r\n    gorilla.set_cuda_visible_devices([args.gpu_id], 1)\r\n    gorilla.set_random_seed(1999)\r\n    cfg = gorilla.Config.fromfile(args.config)\r\n    data_cfg = cfg.data.val.copy()\r\n    data_cfg.training = False\r\n    data_cfg.aug = False\r\n    data_cfg.with_elastic = False\r\n    data_cfg.lang_num_max = 32\r\n    dataset = build_dataset(data_cfg, get_root_logger())\r\n    model = IPDN(**cfg.model).cuda()\r\n    checkpoint = torch.load(args.checkpoint, map_location=\"cpu\")\r\n    loaded = model.load_state_dict(checkpoint.get(\"model\", checkpoint), strict=False)\r\n    allowed = {\r\n        \"text_encoder.embeddings.position_ids\",\r\n        \"text_encoder.embeddings.token_type_ids\",\r\n    }\r\n    if loaded.missing_keys or set(loaded.unexpected_keys) - allowed:\r\n        raise RuntimeError(f\"Checkpoint mismatch: {loaded}\")\r\n    model.eval()\r\n\r\n    def capture_scene(module, inputs, output):\r\n        model.probe_scene = output\r\n\r\n    def capture_language(module, inputs, output):\r\n        model.probe_language = output\r\n\r\n    model.dec.ila_ffn_layers[-1].register_forward_hook(capture_scene)\r\n    model.dec.lia_ffn_layers[-1].register_forward_hook(capture_language)\r\n    model.predict_by_feat = types.MethodType(predictor(), model)\r\n    rows = []\r\n    for index in range(min(args.scenes, len(dataset))):\r\n        batch = dataset.collate_fn([dataset[index]])\r\n        model.probe_scene_index = index\r\n        model.probe_token_mask = batch[\"lang_masks\"]\r\n        with torch.no_grad():\r\n            rows.extend(model(batch, mode=\"predict\")[\"rows\"])\r\n    errors = [r for r in rows if r[\"oracle_iou\"] - r[\"selected_iou\"] > 0.05]\r\n    result = {\r\n        \"checkpoint\": args.checkpoint,\r\n        \"scenes\": min(args.scenes, len(dataset)),\r\n        \"expressions\": len(rows),\r\n        \"material_errors\": len(errors),\r\n        \"oracle_contrast_higher\": sum(\r\n","exit_code":0,"status":"completed"}}
