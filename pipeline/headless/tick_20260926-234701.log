       normalized_query = self.query_norm(query)\r\n 180:         context = torch.einsum('bij,bjd->bid', competition, normalized_query)\r\n 181:         max_overlap = overlap.max(-1).values.unsqueeze(-1)\r\n 182:         evidence = torch.cat(\r\n 183:             [\r\n 184:                 normalized_query,\r\n 185:                 context,\r\n 186:                 normalized_query - context,\r\n 187:                 max_overlap,\r\n 188:             ],\r\n 189:             dim=-1,\r\n 190:         )\r\n 191:         return self.head(self.evidence_norm(evidence))\r\n 192:     \r\n 193:     \r\n 194: class DEC(nn.Module):\r\n 195:     \"\"\"\r\n 196:     in_channels List[int] (4,) [64,96,128,160]\r\n 197:     \"\"\"\r\n 198:     def __init__(\r\n 199:         self,\r\n 200:         num_layer=6,\r\n 201:         num_class=256,\r\n 202:         in_channel=32,\r\n 203:         d_model=256,\r\n        remapped_seeds = torch.stack([\r\n            length - 1 - seeds for length, seeds in zip(lengths, fps_seed_sp)\r\n        ])\r\n        changed = original(\r\n            x[order], remapped_seeds, batch_offsets, lang_feats, lang_masks,\r\n            sp_pos[order], feats_2d[order],\r\n        )\r\n        # Reverse is self-inverse within each scene. Padding remains at the end.\r\n        for index, length in enumerate(lengths):\r\n            changed[\"masks\"][index, :, :length] = changed[\"masks\"][\r\n                index, :, :length].flip(-1)\r\n        model.alternate_output = changed\r\n        return base\r\n\r\n    model.dec.forward = types.MethodType(paired_forward, model.dec)\r\n    model.predict_by_feat = types.MethodType(predictor, model)\r\n    rows = []\r\n    repeat_mismatch = 0\r\n    for scene in range(min(args.scenes, len(dataset))):\r\n        batch = dataset.collate_fn([dataset[scene]])\r\n        with torch.no_grad():\r\n            first = model(batch, mode=\"predict\")[\"rows\"]\r\n            second = model(batch, mode=\"predict\")[\"rows\"]\r\n        repeat_mismatch += sum(\r\n            abs(a[\"selected_iou\"] - b[\"selected_iou\"]) > 1e-4\r\n            or abs(a[\"selected_stability\"] - b[\"selected_stability\"]) > 1e-4\r\n            for a, b in zip(first, second)\r\n        )\r\n        rows.extend(first)\r\n    errors = [r for r in rows if r[\"oracle_iou\"] - r[\"selected_iou\"] > 0.05]\r\n    result = {\r\n        \"scenes\": min(args.scenes, len(dataset)),\r\n        \"expressions\": len(rows),\r\n        \"material_errors\": len(errors),\r\n        \"repeat_mismatch\": repeat_mismatch,\r\n        \"indicator_miou\": statistics.fmean(r[\"selected_iou\"] for r in rows),\r\n        \"oracle_more_stable\": sum(\r\n            r[\"oracle_stability\"] > r[\"selected_stability\"] for r in errors),\r\n        \"oracle_higher_matched_score\": sum(\r\n            r[\"oracle_match_score\"] > r[\"selected_match_score\"] for r in errors),\r\n        \"selection_match_fraction\": statistics.fmean(\r\n            r[\"alt_selection_matches\"] for r in rows),\r\n        \"selection_mask_iou_mean\": statistics.fmean(\r\n            r[\"alt_selection_mask_iou\"] for r in rows),\r\n        \"selected_stability_mean\": statistics.fmean(\r\n            r[\"selected_stability\"] for r in errors) if errors else None,\r\n        \"oracle_stability_mean\": statistics.fmean(\r\n            r[\"oracle_stability\"] for r in errors) if errors else None,\r\n        \"average_miou\": statistics.fmean(r[\"average_iou\"] for r in rows),\r\n        \"matched_alt_miou\": statistics.fmean(r[\"matched_alt_iou\"] for r in rows),\r\n        \"average_flips\": sum(r[\"average_flip\"] for r in rows),\r\n        \"peak_reserved_gib\": torch.cuda.max_memory_reserved() / 2**30,\r\n        \"rows\": rows,\r\n    }\r\n    Path(args.output).write_text(json.dumps(result, indent=2), encoding=\"utf-8\")\r\n    print(json.dumps({k: v for k, v in result.items() if k != \"rows\"}))\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n        \"material_errors\": len(errors),\r\n        \"indicator_miou\": statistics.fmean(r[\"selected_iou\"] for r in rows),\r\n        \"inside_miou\": statistics.fmean(r[\"inside\"][\"selection_iou\"] for r in rows),\r\n        \"outside_miou\": statistics.fmean(r[\"outside\"][\"selection_iou\"] for r in rows),\r\n        \"inside_flips\": sum(r[\"inside\"][\"selection_flip\"] for r in rows),\r\n        \"outside_flips\": sum(r[\"outside\"][\"selection_flip\"] for r in rows),\r\n        \"error_inside_greater_drop\": sum(\r\n            r[\"inside\"][\"selected_score_drop\"] >\r\n            r[\"outside\"][\"selected_score_drop\"] for r in errors),\r\n        \"all_inside_greater_drop\": sum(\r\n            r[\"inside\"][\"selected_score_drop\"] >\r\n            r[\"outside\"][\"selected_score_drop\"] for r in rows),\r\n        \"inside_mask_iou\": statistics.fmean(\r\n            r[\"inside\"][\"matched_mask_iou\"] for r in rows),\r\n        \"outside_mask_iou\": statistics.fmean(\r\n            r[\"outside\"][\"matched_mask_iou\"] for r in rows),\r\n        \"repeat_mismatch\": sum(\r\n            abs(r[\"repeat\"][\"selected_score_drop\"]) > 1e-4\r\n            or r[\"repeat\"][\"matched_mask_iou\"] < 0.9999 for r in rows),\r\n        \"repeat_miou\": statistics.fmean(\r\n            r[\"repeat\"][\"selection_iou\"] for r in rows),\r\n        \"inside_same_seed\": sum(r[\"inside\"][\"same_seed\"] for r in rows),\r\n        \"outside_same_seed\": sum(r[\"outside\"][\"same_seed\"] for r in rows),\r\n        \"runner_inside_same_seed\": sum(\r\n            r[\"runner_inside\"][\"same_seed\"] for r in rows),\r\n        \"top_two_inside_miou\": statistics.fmean(\r\n            r[\"top_two_inside_iou\"] for r in rows),\r\n        \"top_two_outside_miou\": statistics.fmean(\r\n            r[\"top_two_outside_iou\"] for r in rows),\r\n        \"top_two_inside_flips\": sum(\r\n            r[\"top_two_inside_iou\"] != r[\"selected_iou\"] for r in rows),\r\n        \"peak_reserved_gib\": torch.cuda.max_memory_reserved() / 2**30,\r\n        \"rows\": rows,\r\n    }\r\n    Path(args.output).write_text(json.dumps(result, indent=2), encoding=\"utf-8\")\r\n    print(json.dumps({k: v for k, v in result.items() if k != \"rows\"}))\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n","exit_code":0,"status":"completed"}}
