{"type":"item.completed","item":{"id":"item_58","type":"command_execution","command":"\"C:\\\\Users\\\\chuanle song\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\pwsh.exe\" -Command \"Get-Content -LiteralPath 'AdaRES/ipdn/model_paper5/adares_c1_listwise_expected_mask/loss.py' | Select-Object -Skip 178 -First 110\"","aggregated_output":"            mask_bce_loss += F.binary_cross_entropy_with_logits(pred_mask, tgt_mask.float())\r\n            mask_dice_loss += dice_loss(pred_mask, tgt_mask.float())\r\n        score_loss = score_loss / num_boxes\r\n        mask_bce_loss = mask_bce_loss / num_boxes\r\n        mask_dice_loss = mask_dice_loss / num_boxes\r\n        # score_loss = score_loss / len(pred_masks)\r\n        # mask_bce_loss = mask_bce_loss / len(pred_masks)\r\n        # mask_dice_loss = mask_dice_loss / len(pred_masks)\r\n\r\n        return mask_bce_loss, mask_dice_loss, score_loss\r\n\r\n    def loss_indi(self, pred_indis, targets, indices, num_boxes):\r\n        logits = pred_indis.log_softmax(-1) # [B, Q, 2]\r\n\r\n        # Trick to get target indices across batches\r\n        src_idx = self._get_src_permutation_idx(indices)\r\n\r\n        # positive: [0, 1]\r\n        pos_mask = torch.tensor([0, 1], dtype=torch.float, device=logits.device)\r\n        target_mask = torch.zeros_like(logits) # [B, Q, 2]\r\n        target_mask[:, :, 0] = 1\r\n        target_mask[src_idx] = pos_mask\r\n\r\n        target_sim = torch.zeros_like(logits)\r\n        target_sim[:, :, 0] = 1\r\n        target_sim[src_idx] = pos_mask\r\n\r\n        # STEP Compute entropy\r\n        entropy = torch.log(target_sim + 1e-6) * target_sim\r\n        loss_ce = (entropy - logits * target_sim).sum(-1)\r\n\r\n        # Weight less 'no_object'\r\n        eos_coef = torch.full(\r\n            loss_ce.shape, self.eos_coef,\r\n            device=target_sim.device\r\n        )\r\n        eos_coef[src_idx] = 1\r\n        loss_ce = loss_ce * eos_coef\r\n\r\n        loss_ce = loss_ce.sum() / num_boxes\r\n\r\n        return loss_ce\r\n\r\n    @staticmethod\r\n    def _query_iou(pred_mask, target_masks):\r\n        \"\"\"IoU of every query mask against the best matching target mask.\"\"\"\r\n        pred_binary = (pred_mask.sigmoid() >= 0.5).float()\r\n        target_binary = (target_masks > 0.5).float()\r\n        intersection = torch.matmul(pred_binary, target_binary.transpose(0, 1))\r\n        pred_area = pred_binary.sum(-1, keepdim=True)\r\n        target_area = target_binary.sum(-1).unsqueeze(0)\r\n        union = pred_area + target_area - intersection\r\n        iou = intersection / union.clamp_min(1.0)\r\n        return iou.max(dim=-1).values\r\n\r\n    def loss_listwise(self, pred_indis, pred_masks, targets):\r\n        \"\"\"Match the ranking distribution over queries to their oracle IoU.\r\n\r\n        Let s_i be the positive-vs-negative indicator margin and u_i the mask\r\n        IoU of query i.  With p_i = softmax(s_i / tau_s) and\r\n        q_i = softmax(u_i / tau_u), the listwise objective is\r\n        KL(q || p) = sum_i q_i (log q_i - log p_i).\r\n        \"\"\"\r\n        total = pred_indis.new_zeros(())\r\n        valid = 0\r\n        for logits, pred_mask, target in zip(pred_indis, pred_masks, targets):\r\n            if target['masks'] is None:\r\n                continue\r\n            iou = self._query_iou(pred_mask, target['masks'])\r\n            if iou.numel() < 2 or float(iou.detach().max()) <= 1e-4:\r\n                continue\r\n            margin = logits[:, 1] - logits[:, 0]\r\n            log_prob = F.log_softmax(margin / self.rank_temperature, dim=0)\r\n            target_prob = F.softmax(iou / self.target_temperature, dim=0)\r\n            total = total - (target_prob * log_prob).sum()\r\n            valid += 1\r\n        return total / max(valid, 1)\r\n\r\n    def loss_expected_mask(self, pred_indis, pred_masks, targets):\r\n        \"\"\"Supervise the score-weighted expected mask.\r\n\r\n        M_bar = sum_i p_i * sigmoid(M_i), where p_i is the same listwise\r\n        ranking distribution used above.  This couples ranking and mask\r\n        quality instead of optimizing them independently.\r\n        \"\"\"\r\n        total = pred_indis.new_zeros(())\r\n        valid = 0\r\n        for logits, pred_mask, target in zip(pred_indis, pred_masks, targets):\r\n            if target['masks'] is None or target['masks'].numel() == 0:\r\n                continue\r\n            margin = logits[:, 1] - logits[:, 0]\r\n            probability = F.softmax(margin / self.rank_temperature, dim=0)\r\n            expected = (\r\n                probability.unsqueeze(1) * pred_mask.sigmoid()\r\n            ).sum(dim=0)\r\n            for target_mask in target['masks']:\r\n                target_mask = target_mask.float()\r\n                bce = F.binary_cross_entropy(\r\n                    expected.clamp(1e-6, 1.0 - 1e-6), target_mask\r\n                )\r\n                numerator = 2.0 * (expected * target_mask).sum()\r\n                denominator = expected.sum() + target_mask.sum()\r\n                dice = 1.0 - (numerator + 1.0) / (denominator + 1.0)\r\n                total = total + bce + dice\r\n                valid += 1\r\n        return total / max(valid, 1)\r\n\r\n    ############################\r\n    # BRIEF semantic alignment #\r\n    ############################\r\n","exit_code":0,"status":"completed"}}
