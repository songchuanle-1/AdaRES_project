no_object'\n-        eos_coef = torch.full(\n-            loss_ce.shape, self.eos_coef,\n-            device=target_sim.device\n-        )\n-        eos_coef[src_idx] = 1\n-        loss_ce = loss_ce * eos_coef\n-\n-        loss_ce = loss_ce.sum() / num_boxes\n-\n-        return loss_ce\n+    def loss_indi(self, pred_indis, pred_masks, targets, indices, num_boxes):\n+        logits = pred_indis.log_softmax(-1)\n+        losses = []\n+        with torch.no_grad():\n+            for masks, target in zip(pred_masks, targets):\n+                if target[\"masks\"] is None or target[\"masks\"].numel() == 0:\n+                    quality = masks.new_zeros(masks.shape[0])\n+                else:\n+                    binary = masks.sigmoid() >= 0.5\n+                    truth = target[\"masks\"] > 0.5\n+                    intersection = (\n+                        binary.float() @ truth.float().transpose(0, 1)\n+                    )\n+                    union = (\n+                        binary.sum(-1, keepdim=True)\n+                        + truth.sum(-1).unsqueeze(0)\n+                        - intersection\n+                    )\n+                    quality = (intersection / union.clamp_min(1)).max(-1).values\n+                losses.append(quality)\n+        quality = torch.stack(losses)\n+        soft_targets = torch.stack((1 - quality, quality), dim=-1)\n+        entropy = -(soft_targets * soft_targets.clamp_min(1e-6).log()).sum(-1)\n+        ce = -(soft_targets * logits).sum(-1) - entropy\n+        weights = self.eos_coef + (1 - self.eos_coef) * quality\n+        return (weights * ce).sum() / num_boxes.clamp_min(1)\n \n     ############################\n     # BRIEF semantic alignment #\n@@ -412,7 +407,7 @@ class Criterion(nn.Module):\n         if is_dist_avail_and_initialized():\n             torch.distributed.all_reduce(num_insts)\n         \n-        indi_loss = self.loss_indi(pred_indis, target, indices, num_insts)\n+        indi_loss = self.loss_indi(pre