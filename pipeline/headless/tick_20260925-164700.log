{"type":"item.completed","item":{"id":"item_63","type":"command_execution","command":"\"C:\\\\Users\\\\chuanle song\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\pwsh.exe\" -Command \"Get-Content -LiteralPath 'AdaRES/tools/probe_adares_d1_real_batch.py' -TotalCount 260\"","aggregated_output":"import argparse\r\nimport importlib\r\nimport json\r\nimport sys\r\nimport time\r\nfrom pathlib import Path\r\n\r\nimport gorilla\r\nimport torch\r\n\r\nROOT = Path(__file__).resolve().parents[1]\r\nsys.path.insert(0, str(ROOT))\r\nsys.path.insert(0, str(Path.cwd()))\r\n\r\nfrom ipdn.dataset import build_dataset\r\nfrom ipdn.utils import get_root_logger\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser()\r\n    parser.add_argument(\"config\")\r\n    parser.add_argument(\"--module\", default=\"ipdn.model_paper5.adares_d1_full_query_comparison\")\r\n    parser.add_argument(\"--package-dir\", type=Path)\r\n    parser.add_argument(\"--gpu-id\", type=int, default=1)\r\n    parser.add_argument(\"--batch-size\", type=int, default=2)\r\n    parser.add_argument(\"--indices\", type=int, nargs=\"+\")\r\n    args = parser.parse_args()\r\n\r\n    gorilla.set_cuda_visible_devices([args.gpu_id], 1)\r\n    gorilla.set_random_seed(1999)\r\n    cfg = gorilla.Config.fromfile(args.config)\r\n    if args.package_dir:\r\n        import ipdn.model_paper5\r\n        ipdn.model_paper5.__path__.append(str(args.package_dir.resolve()))\r\n    dataset = build_dataset(cfg.data.train, get_root_logger())\r\n    indices = args.indices if args.indices is not None else list(range(args.batch_size))\r\n    if len(indices) != args.batch_size or any(i < 0 or i >= len(dataset) for i in indices):\r\n        raise ValueError(\"Scene indices must match batch size and be within the dataset\")\r\n    batch = dataset.collate_fn([dataset[i] for i in indices])\r\n    model = importlib.import_module(args.module).IPDN(**cfg.model).cuda()\r\n    model.train()\r\n    torch.cuda.reset_peak_memory_stats()\r\n    torch.cuda.synchronize()\r\n    start = time.perf_counter()\r\n    loss, _ = model(batch, mode=\"loss\")\r\n    if not torch.isfinite(loss):\r\n        raise RuntimeError(f\"Non-finite real-batch loss: {loss}\")\r\n    loss.backward()\r\n    torch.cuda.synchronize()\r\n    elapsed = time.perf_counter() - start\r\n    names = [\"dec.indi_embedding.head.0.weight\", \"dec.out_norm.weight\"]\r\n    if hasattr(model.dec.indi_embedding, \"pair_score\"):\r\n        names.append(\"dec.indi_embedding.pair_score.0.weight\")\r\n    params = dict(model.named_parameters())\r\n    gradients = {}\r\n    for name in names:\r\n        grad = params[name].grad\r\n        if grad is None or not torch.isfinite(grad).all() or grad.abs().sum() == 0:\r\n            raise RuntimeError(f\"Missing, non-finite or zero gradient: {name}\")\r\n        gradients[name] = float(grad.norm())\r\n    print(json.dumps({\r\n        \"batch_size\": args.batch_size,\r\n        \"indices\": indices,\r\n        \"loss\": float(loss.detach()),\r\n        \"gradient_norms\": gradients,\r\n        \"forward_backward_seconds\": elapsed,\r\n        \"peak_allocated_gib\": torch.cuda.max_memory_allocated() / 2**30,\r\n        \"peak_reserved_gib\": torch.cuda.max_memory_reserved() / 2**30,\r\n    }))\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_66","type":"command_execution","command":"\"C:\\\\Users\\\\chuanle song\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\pwsh.exe\" -Command \"Get-Content -LiteralPath 'AdaRES/tools/test_adares_d1_full_query_comparison.py' -TotalCount 180\"","aggregated_output":"from pathlib import Path\r\nimport sys\r\n\r\nimport torch\r\n\r\nROOT = Path(__file__).resolve().parents[1]\r\nsys.path.insert(0, str(ROOT))\r\n\r\nfrom ipdn.model_paper5.adares_d1_full_query_comparison.dec import (\r\n    QueryCompetitionIndicator,\r\n)\r\n\r\n\r\ndef main():\r\n    torch.manual_seed(1999)\r\n    module = QueryCompetitionIndicator(d_model=8)\r\n    query = torch.randn(2, 4, 8, requires_grad=True)\r\n    masks = torch.randn(2, 4, 6, requires_grad=True)\r\n\r\n        [[False, False, False, False, True, True], [False] * 6]\r\n    )\r\n\r\n    logits = module(query, masks, padding)\r\n    assert logits.shape == (2, 4, 2)\r\n    assert torch.isfinite(logits).all()\r\n\r\n    changed_padding = masks.detach().clone()\r\n    changed_padding[0, :, 4:] = 1e4\r\n    torch.testing.assert_close(\r\n        logits[0], module(query, changed_padding, padding)[0]\r\n    )\r\n\r\n    changed_rival = query.detach().clone()\r\n    changed_rival[0, 1] += torch.arange(8, dtype=query.dtype)\r\n    assert not torch.allclose(\r\n        logits[0, 0], module(changed_rival, masks, padding)[0, 0]\r\n    )\r\n\r\n    loss = logits.square().mean()\r\n    loss.backward()\r\n    for name, tensor in ((\"query\", query), (\"masks\", masks)):\r\n        assert tensor.grad is not None, f\"missing {name} gradient\"\r\n        assert torch.isfinite(tensor.grad).all(), f\"invalid {name} gradient\"\r\n        assert tensor.grad.abs().sum() > 0, f\"zero {name} gradient\"\r\n\r\n    print(\r\n        {\r\n            \"shape\": list(logits.shape),\r\n            \"loss\": float(loss.detach()),\r\n            \"query_grad\": float(query.grad.norm()),\r\n            \"mask_grad\": float(masks.grad.norm()),\r\n        }\r\n    )\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n","exit_code":0,"status":"completed"}}
