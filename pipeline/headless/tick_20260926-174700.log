h, mode=\"loss\")\n    if not torch.isfinite(loss):\n        raise RuntimeError(f\"Non-finite real-batch loss: {loss}\")\n    loss.backward()\n    torch.cuda.synchronize()\n    elapsed = time.perf_counter() - start\n    names = [\"dec.indi_embedding.head.0.weight\", \"dec.out_norm.weight\"]\n    if hasattr(model.dec.indi_embedding, \"pair_score\"):\n        names.append(\"dec.indi_embedding.pair_score.0.weight\")\n    params = dict(model.named_parameters())\n    gradients = {}\n    for name in names:\n        grad = params[name].grad\n        if grad is None or not torch.isfinite(grad).all() or grad.abs().sum() == 0:\n            raise RuntimeError(f\"Missing, non-finite or zero gradient: {name}\")\n        gradients[name] = float(grad.norm())\n    print(json.dumps({\n        \"batch_size\": args.batch_size,\n        \"indices\": indices,\n        \"loss\": float(loss.detach()),\n        \"gradient_norms\": gradients,\n        \"forward_backward_seconds\": elapsed,\n        \"peak_allocated_gib\": torch.cuda.max_memory_allocated() / 2**30,\n        \"peak_reserved_gib\": torch.cuda.max_memory_reserved() / 2**30,\n    }))\n\n\nif __name__ == \"__main__\":\n    main()\n\r\n","exit_code":0,"status":"completed"}}
