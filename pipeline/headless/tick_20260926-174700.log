": 0.0,\n      \"oracle_iou\": 0.11937949806451797,\n      \"selected_oracle_overlap\": 0.25641027092933655,\n      \"oracle_score_rank\": 31,\n      \"selected_query\": 0,\n      \"oracle_query\": 59\n    },\n    {\n      \"selected_iou\": 0.9649758338928223,\n      \"oracle_iou\": 0.9649758338928223,\n      \"selected_oracle_overlap\": 1.0,\n      \"oracle_score_rank\": 1,\n      \"selected_query\": 1,\n      \"oracle_query\": 1\n    },\n    {\n      \"selected_iou\": 0.8748997449874878,\n      \"oracle_iou\": 0.916806697845459,\n      \"selected_oracle_overlap\": 0.9090909361839294,\n      \"oracle_score_rank\": 5,\n      \"selected_query\": 5,\n      \"oracle_query\": 9\n    },\n    {\n      \"selected_iou\": 0.8912989497184753,\n      \"oracle_iou\": 0.9082469940185547,\n      \"selected_oracle_overlap\": 0.9538461565971375,\n      \"oracle_score_rank\": 27,\n      \"selected_query\": 2,\n      \"oracle_query\": 66\n    },\n    {\n      \"selected_iou\": 0.9483235478401184,\n      \"oracle_iou\": 0.9635326862335205,\n      \"selected_oracle_overlap\": 0.9459459185600281,\n      \"oracle_score_rank\": 7,\n      \"selected_query\": 0,\n      \"oracle_query\": 12\n    },\n    {\n      \"selected_iou\": 1.0,\n      \"oracle_iou\": 1.0,\n      \"selected_oracle_overlap\": 1.0,\n      \"oracle_score_rank\": 2,\n      \"selected_query\": 1,\n      \"oracle_query\": 0\n    },\n    {\n      \"selected_iou\": 0.9347913265228271,\n      \"oracle_iou\": 0.9347913265228271,\n      \"selected_oracle_overlap\": 1.0,\n      \"oracle_score_rank\": 2,\n      \"selected_query\": 2,\n      \"oracle_query\": 1\n    },\n    {\n      \"selected_iou\": 0.9583941698074341,\n      \"oracle_iou\": 0.9583941698074341,\n      \"selected_oracle_overlap\": 1.0,\n      \"oracle_score_rank\": 1,\n      \"selected_query\": 1,\n      \"oracle_query\": 1\n    },\n    {\n      \"selected_iou\": 0.9044985771179199,\n      \"oracle_iou\": 0.9105866551399231,\n      \"selected_oracle_overlap\": 0.969