{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"\"C:\\\\Users\\\\chuanle song\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\pwsh.exe\" -Command \"Get-Content 'AdaRES/ipdn/model_paper5/adares_b4_query_competition/dec.py' -TotalCount 260; Get-Content 'AdaRES/tools/diagnose_adares_m1_seed_support.py' -TotalCount 220\"","aggregated_output":"import torch\r\nimport torch.nn as nn\r\nfrom .sample_model import SamplingModule\r\nimport ipdn.torch.nn_new.functional as F\r\nfrom ipdn.torch.nn_new import MultiheadAttention\r\n\r\nclass ThreeLayerMLP(nn.Module):\r\n    \"\"\"A 3-layer MLP with normalization and dropout.\"\"\"\r\n\r\n    def __init__(self, dim, out_dim):\r\n        super().__init__()\r\n        self.net = nn.Sequential(\r\n            nn.Conv1d(dim, dim, 1, bias=False),\r\n            nn.BatchNorm1d(dim),\r\n            nn.ReLU(),\r\n            nn.Dropout(0.3),\r\n            nn.Conv1d(dim, dim, 1, bias=False),\r\n            nn.BatchNorm1d(dim),\r\n            nn.ReLU(),\r\n            nn.Dropout(0.3),\r\n            nn.Conv1d(dim, out_dim, 1)\r\n        )\r\n\r\n    def forward(self, x):\r\n        \"\"\"Forward pass, x can be (B, dim, N).\"\"\"\r\n        return self.net(x)\r\n\r\nclass CrossAttentionLayer(nn.Module):\r\n\r\n    def __init__(self, d_model=256, nhead=8, dropout=0.0):\r\n        super().__init__()\r\n        self.attn = MultiheadAttention(d_model, nhead, dropout=dropout, batch_first=True)\r\n        self.norm = nn.LayerNorm(d_model)\r\n        self.dropout = nn.Dropout(dropout)\r\n        self._reset_parameters()\r\n        self.nhead = nhead\r\n\r\n    def _reset_parameters(self):\r\n        for p in self.parameters():\r\n            if p.dim() > 1:\r\n                nn.init.xavier_uniform_(p)\r\n\r\n    def with_pos_embed(self, tensor, pos):\r\n        return tensor if pos is None else tensor + pos\r\n\r\n    def forward(self, source, query, batch_mask=None, attn_mask=None, pe=None, att_weights=None):\r\n        \"\"\"\r\n        source (B, N_p, d_model)\r\n        batch_offsets Tensor (b, n_p)\r\n        query Tensor (b, n_q, d_model)\r\n        attn_masks Tensor (b, n_q, n_p)\r\n        \"\"\"\r\n        B = query.shape[0]\r\n        query = self.with_pos_embed(query, pe)\r\n        k = v = source\r\n        if attn_mask is not None:\r\n            attn_mask = attn_mask.unsqueeze(1).repeat(1, self.nhead, 1, 1).view(B*self.nhead, query.shape[1], k.shape[1])\r\n            output, output_weight, src_weight = self.attn(query, k, v, key_padding_mask=batch_mask, attn_mask=attn_mask, att_weights =att_weights)  # (1, 100, d_model)\r\n        else:\r\n            output, output_weight, src_weight = self.attn(query, k, v, key_padding_mask=batch_mask, att_weights =att_weights)\r\n        self.dropout(output)\r\n        output = output + query\r\n        self.norm(output)\r\n\r\n        return output, output_weight, src_weight # (b, n_q, d_model), (b, n_q, n_v)\r\n\r\nclass SelfAttentionLayer(nn.Module):\r\n\r\n    def __init__(self, d_model=256, nhead=8, dropout=0.0, glu = False):\r\n        super().__init__()\r\n        self.attn = MultiheadAttention(\r\n            d_model,\r\n            nhead,\r\n            dropout=dropout,\r\n            batch_first=True,\r\n        )\r\n        self.nhead = nhead\r\n        self.norm = nn.LayerNorm(d_model)\r\n        self.dropout = nn.Dropout(dropout)\r\n        self.glu = glu\r\n        if glu:\r\n            self.glu_p = nn.Linear(d_model, d_model)\r\n            self.glu_g = nn.Linear(d_model, d_model)\r\n\r\n    def with_pos_embed(self, tensor, pos):\r\n        return tensor if pos is None else tensor + pos\r\n\r\n    def forward(self, x, x_mask=None, attn_mask=None, pe=None, norm=True, att_weights=None):\r\n        \"\"\"\r\n        x Tensor (b, n_w, c)\r\n        x_mask Tensor (b, n_w)\r\n        \"\"\"\r\n        B = x.shape[0]\r\n        q = k = self.with_pos_embed(x, pe)\r\n        if attn_mask is not None:\r\n            attn_mask = attn_mask.unsqueeze(1).repeat(1, self.nhead, 1, 1).view(B*self.nhead, q.shape[1], k.shape[1])\r\n            output, output_weight, src_weight = self.attn(q, k, x, key_padding_mask=x_mask, attn_mask=attn_mask, att_weights =att_weights)  # (1, 100, d_model)\r\n        else:\r\n            output, output_weight, src_weight = self.attn(q, k, x, key_padding_mask=x_mask, att_weights =att_weights)\r\n        if self.glu:\r\n            output = self.glu_p(output) * (self.glu_g(output).sigmoid())\r\n        output = self.dropout(output) + x\r\n        if norm: output = self.norm(output)\r\n        return output\r\n\r\nclass FFN(nn.Module):\r\n\r\n    def __init__(self, d_model, hidden_dim, dropout=0.0, activation_fn='relu'):\r\n        super().__init__()\r\n        if activation_fn == 'relu':\r\n            self.net = nn.Sequential(\r\n                nn.Linear(d_model, hidden_dim),\r\n                nn.ReLU(),\r\n                nn.Dropout(dropout),\r\n                nn.Linear(hidden_dim, d_model),\r\n                nn.Dropout(dropout),\r\n            )\r\n        elif activation_fn == 'gelu':\r\n            self.net = nn.Sequential(\r\n                nn.Linear(d_model, hidden_dim),\r\n                nn.GELU(),\r\n                nn.Dropout(dropout),\r\n                nn.Linear(hidden_dim, d_model),\r\n                nn.Dropout(dropout),\r\n            )\r\n        self.norm = nn.LayerNorm(d_model)\r\n\r\n    def forward(self, x, norm=True):\r\n        output = self.net(x)\r\n        output = output + x\r\n        if norm: output = self.norm(output)\r\n        return output\r\n\r\nclass MLP(nn.Module):\r\n    \"\"\" Very simple multi-layer perceptron (also called FFN)\"\"\"\r\n\r\n    def __init__(self, input_dim, hidden_dim, output_dim, num_layers):\r\n        super().__init__()\r\n        self.num_layers = num_layers\r\n        h = [hidden_dim] * (num_layers - 1)\r\n        self.layers = nn.ModuleList(nn.Linear(n, k) for n, k in zip([input_dim] + h, h + [output_dim]))\r\n\r\n    def forward(self, x):\r\n        for i, layer in enumerate(self.layers):\r\n            x = F.relu(layer(x)) if i < self.num_layers - 1 else layer(x)\r\n        return x\r\n\r\n\r\nclass QueryCompetitionIndicator(nn.Module):\r\n    \"\"\"Predict confidence from a query and its overlapping competitors.\"\"\"\r\n\r\n    def __init__(self, d_model):\r\n        super().__init__()\r\n        self.query_norm = nn.LayerNorm(d_model)\r\n        self.evidence_norm = nn.LayerNorm(3 * d_model + 1)\r\n        self.head = nn.Sequential(\r\n            nn.Linear(3 * d_model + 1, d_model),\r\n            nn.GELU(),\r\n            nn.Linear(d_model, d_model),\r\n            nn.GELU(),\r\n            nn.Linear(d_model, 2),\r\n        )\r\n\r\n    def forward(self, query, pred_masks, batch_mask):\r\n        valid = (~batch_mask).unsqueeze(1).to(pred_masks.dtype)\r\n        probabilities = pred_masks.sigmoid() * valid\r\n        areas = probabilities.sum(-1)\r\n        intersection = torch.einsum(\r\n            'bim,bjm->bij', probabilities, probabilities\r\n        )\r\n        union = areas.unsqueeze(-1) + areas.unsqueeze(1) - intersection\r\n        overlap = intersection / union.clamp_min(1e-6)\r\n        diagonal = torch.eye(\r\n            overlap.shape[-1], dtype=torch.bool, device=overlap.device\r\n        ).unsqueeze(0)\r\n        overlap = overlap.masked_fill(diagonal, 0.0)\r\n\r\n        competition = overlap / overlap.sum(-1, keepdim=True).clamp_min(1e-6)\r\n        normalized_query = self.query_norm(query)\r\n        context = torch.einsum('bij,bjd->bid', competition, normalized_query)\r\n        max_overlap = overlap.max(-1).values.unsqueeze(-1)\r\n        evidence = torch.cat(\r\n            [\r\n                normalized_query,\r\n                context,\r\n                normalized_query - context,\r\n                max_overlap,\r\n            ],\r\n            dim=-1,\r\n        )\r\n        return self.head(self.evidence_norm(evidence))\r\n    \r\n    \r\nclass DEC(nn.Module):\r\n    \"\"\"\r\n    in_channels List[int] (4,) [64,96,128,160]\r\n    \"\"\"\r\n    def __init__(\r\n        self,\r\n        num_layer=6,\r\n        num_class=256,\r\n        in_channel=32,\r\n        d_model=256,\r\n        nhead=8,\r\n        hidden_dim=1024,\r\n        dropout=0.0,\r\n        activation_fn='relu',\r\n        iter_pred=False,\r\n        attn_mask=False,\r\n        sampling_module=None,\r\n        kernel='top1',\r\n        global_feat='mean',\r\n        lang_att=False,\r\n        contrastive_align_loss=False,\r\n        num_proposal_fine=512,\r\n        num_proposal_query = [128,64,32,16,8,4],\r\n        num_proposal_query_inst = [128,64,32,16,8,4]\r\n    ):\r\n        super().__init__()\r\n        self.num_layer = num_layer\r\n        self.num_class = num_class\r\n        self.d_model = d_model\r\n        self.input_proj = nn.Sequential(nn.Linear(in_channel, d_model), nn.LayerNorm(d_model), nn.ReLU())\r\n        \r\n        self.input_proj_2d = nn.Sequential(nn.Linear(1024, d_model*2),nn.ReLU(),nn.Linear(d_model*2, d_model),nn.ReLU(),nn.Linear(d_model, d_model))#clip\r\n        self.sum_norm = nn.LayerNorm(d_model)\r\n        \r\n        self.lang_att = lang_att\r\n        self.contrastive_align_loss = contrastive_align_loss\r\n\r\n        H = 768\r\n        self.lang_proj = nn.Linear(H, d_model)\r\n        self.lang_norm = nn.LayerNorm(d_model)\r\n        \r\n        if sampling_module is not None:\r\n            self.sampling_module = SamplingModule(**sampling_module)\r\n        else:\r\n            self.sampling_module = None\r\n        self.num_proposal_fine = num_proposal_fine\r\n        self.num_proposal_query = num_proposal_query\r\n        self.num_proposal_query_inst = num_proposal_query_inst\r\n        self.query_generator = nn.Sequential(nn.Linear(d_model, d_model),nn.ReLU(),nn.Linear(d_model, d_model),nn.ReLU(),nn.Linear(d_model, d_model))\r\n        \r\n        # DDI and SWA\r\n        self.qia_layers = nn.ModuleList([])\r\n        self.qia_layers_fine = nn.ModuleList([])\r\n        self.qla_layers = nn.ModuleList([])\r\n        self.qqa_layers = nn.ModuleList([])\r\n        self.qqa_ffn_layers = nn.ModuleList([])\r\n        self.qia_ffn_layers = nn.ModuleList([])\r\n        self.sem_cls_heads = nn.ModuleList([])\r\n        # self.scg = nn.ModuleList([])\r\n        self.lqg = nn.ModuleList([])\r\n        if self.lang_att:\r\n            self.lla_layers = nn.ModuleList([])\r\n            self.lia_layers = nn.ModuleList([])\r\n            self.ila_layers = nn.ModuleList([])\r\n            self.lia_ffn_layers = nn.ModuleList([])\r\n            self.ila_ffn_layers = nn.ModuleList([])\r\n        for i in range(num_layer):\r\nimport argparse\r\nimport json\r\nimport statistics\r\nimport sys\r\nimport types\r\nfrom pathlib import Path\r\n\r\nimport gorilla\r\nimport torch\r\nimport torch.nn.functional as F\r\n\r\nROOT = Path(__file__).resolve().parents[1]\r\nsys.path.insert(0, str(ROOT))\r\n\r\nfrom ipdn.dataset import build_dataset\r\nfrom ipdn.model_paper5.adares_b4_query_competition import IPDN\r\nfrom ipdn.utils import get_root_logger\r\n\r\n\r\ndef predictor():\r\n    def predict_by_feat(\r\n        self, scan_ids, object_idss, ann_ids, out, superpoints,\r\n        gt_pmasks, gt_spmasks, fps_seed_sp,\r\n    ):\r\n        rows = []\r\n        for index, target in enumerate(gt_pmasks):\r\n            masks = out[\"masks\"][index].sigmoid().gt(0.5)[:, superpoints]\r\n            truth = target.gt(0.5).to(masks.device)\r\n            ious = (masks & truth).sum(-1).float() / (\r\n                (masks | truth).sum(-1).clamp_min(1).float()\r\n            )\r\n            seed_sp = fps_seed_sp[index].long()[out[\"sample_inds\"][index].long()]\r\n            query_index = torch.arange(seed_sp.numel(), device=seed_sp.device)\r\n            seed_support = out[\"masks\"][index, query_index, seed_sp].sigmoid()\r\n            confidence = F.softmax(out[\"indis\"][index], dim=-1)[:, 1]\r\n            selected = int(confidence.argmax())\r\n            oracle = int(ious.argmax())\r\n            rows.append({\r\n                \"scene_index\": self.probe_scene_index,\r\n                \"selected_iou\": float(ious[selected]),\r\n                \"oracle_iou\": float(ious[oracle]),\r\n                \"selected_seed_support\": float(seed_support[selected]),\r\n                \"oracle_seed_support\": float(seed_support[oracle]),\r\n                \"seed_support_only_iou\": float(ious[seed_support.argmax()]),\r\n            })\r\n        return {\"rows\": rows}\r\n\r\n    return predict_by_feat\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser()\r\n    parser.add_argument(\"config\")\r\n    parser.add_argument(\"checkpoint\")\r\n    parser.add_argument(\"--output\", required=True)\r\n    parser.add_argument(\"--scenes\", type=int, default=16)\r\n    parser.add_argument(\"--gpu-id\", type=int, default=1)\r\n    args = parser.parse_args()\r\n\r\n    gorilla.set_cuda_visible_devices([args.gpu_id], 1)\r\n    gorilla.set_random_seed(1999)\r\n    cfg = gorilla.Config.fromfile(args.config)\r\n    data_cfg = cfg.data.val.copy()\r\n    data_cfg.training = False\r\n    data_cfg.aug = False\r\n    data_cfg.with_elastic = False\r\n    data_cfg.lang_num_max = 32\r\n    dataset = build_dataset(data_cfg, get_root_logger())\r\n    model = IPDN(**cfg.model).cuda()\r\n    checkpoint = torch.load(args.checkpoint, map_location=\"cpu\")\r\n    loaded = model.load_state_dict(checkpoint.get(\"model\", checkpoint), strict=False)\r\n    allowed = {\r\n        \"text_encoder.embeddings.position_ids\",\r\n        \"text_encoder.embeddings.token_type_ids\",\r\n    }\r\n    if loaded.missing_keys or set(loaded.unexpected_keys) - allowed:\r\n        raise RuntimeError(f\"Checkpoint mismatch: {loaded}\")\r\n    model.eval()\r\n    model.predict_by_feat = types.MethodType(predictor(), model)\r\n    rows = []\r\n    for index in range(min(args.scenes, len(dataset))):\r\n        model.probe_scene_index = index\r\n        with torch.no_grad():\r\n            rows.extend(model(dataset.collate_fn([dataset[index]]), mode=\"predict\")[\"rows\"])\r\n    errors = [row for row in rows if row[\"oracle_iou\"] - row[\"selected_iou\"] > 0.05]\r\n    result = {\r\n        \"checkpoint\": args.checkpoint,\r\n        \"scenes\": min(args.scenes, len(dataset)),\r\n        \"expressions\": len(rows),\r\n        \"material_errors\": len(errors),\r\n        \"oracle_support_higher\": sum(\r\n            r[\"oracle_seed_support\"] > r[\"selected_seed_support\"] for r in errors\r\n        ),\r\n        \"selected_support_mean\": statistics.fmean(\r\n            r[\"selected_seed_support\"] for r in errors\r\n        ),\r\n        \"oracle_support_mean\": statistics.fmean(\r\n            r[\"oracle_seed_support\"] for r in errors\r\n        ),\r\n        \"indicator_miou\": statistics.fmean(r[\"selected_iou\"] for r in rows),\r\n        \"seed_support_only_miou\": statistics.fmean(\r\n            r[\"seed_support_only_iou\"] for r in rows\r\n        ),\r\n        \"rows\": rows,\r\n    }\r\n    Path(args.output).write_text(json.dumps(result, indent=2), encoding=\"utf-8\")\r\n    print(json.dumps({k: v for k, v in result.items() if k != \"rows\"}))\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n","exit_code":0,"status":"completed"}}
