{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"\"C:\\\\Users\\\\chuanle song\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\pwsh.exe\" -Command 'Get-Content AdaRES/tools/diagnose_adares_h3_score_evidence.py -TotalCount 230; Get-Content AdaRES/ipdn/model_paper5/adares_b4_query_competition/dec.py | Select-Object -Skip 290 -First 90; Get-Content AdaRES/ipdn/model_paper5/adares_b4_query_competition/sample_model.py -TotalCount 230'","aggregated_output":"import argparse\r\nimport json\r\nimport statistics\r\nimport sys\r\nimport types\r\nfrom pathlib import Path\r\n\r\nimport gorilla\r\nimport torch\r\nimport torch.nn.functional as F\r\n\r\nROOT = Path(__file__).resolve().parents[1]\r\nsys.path.insert(0, str(ROOT))\r\n\r\nfrom ipdn.dataset import build_dataset\r\nfrom ipdn.model_paper5.adares_b4_query_competition import IPDN\r\nfrom ipdn.utils import get_root_logger\r\n\r\n\r\ndef predictor():\r\n    def predict_by_feat(\r\n        self, scan_ids, object_idss, ann_ids, out, superpoints,\r\n        gt_pmasks, gt_spmasks, fps_seed_sp,\r\n    ):\r\n        rows = []\r\n        for index, target in enumerate(gt_pmasks):\r\n            masks = out[\"masks\"][index].sigmoid().gt(0.5)[:, superpoints]\r\n            truth = target.gt(0.5).to(masks.device)\r\n            ious = (masks & truth).sum(-1).float() / (\r\n                (masks | truth).sum(-1).clamp_min(1).float()\r\n            )\r\n            indicator = F.softmax(out[\"indis\"][index], dim=-1)[:, 1]\r\n            quality = out[\"scores\"][index].sigmoid().flatten()\r\n            selected = int(indicator.argmax())\r\n            score_selected = int(quality.argmax())\r\n            oracle = int(ious.argmax())\r\n            rows.append({\r\n                \"scene_index\": self.probe_scene_index,\r\n                \"indicator_iou\": float(ious[selected]),\r\n                \"score_iou\": float(ious[score_selected]),\r\n                \"oracle_iou\": float(ious[oracle]),\r\n                \"indicator_query\": selected,\r\n                \"score_query\": score_selected,\r\n                \"oracle_query\": oracle,\r\n                \"indicator_score_quality\": float(quality[selected]),\r\n                \"oracle_score_quality\": float(quality[oracle]),\r\n                \"indicator_confidence\": float(indicator[selected]),\r\n                \"oracle_confidence\": float(indicator[oracle]),\r\n            })\r\n        return {\"rows\": rows}\r\n\r\n    return predict_by_feat\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser()\r\n    parser.add_argument(\"config\")\r\n    parser.add_argument(\"checkpoint\")\r\n    parser.add_argument(\"--output\", required=True)\r\n    parser.add_argument(\"--scenes\", type=int, default=16)\r\n    parser.add_argument(\"--gpu-id\", type=int, default=1)\r\n    args = parser.parse_args()\r\n    gorilla.set_cuda_visible_devices([args.gpu_id], 1)\r\n    gorilla.set_random_seed(1999)\r\n    cfg = gorilla.Config.fromfile(args.config)\r\n    data_cfg = cfg.data.val.copy()\r\n    data_cfg.training = False\r\n    data_cfg.aug = False\r\n    data_cfg.with_elastic = False\r\n    data_cfg.lang_num_max = 32\r\n    dataset = build_dataset(data_cfg, get_root_logger())\r\n    model = IPDN(**cfg.model).cuda()\r\n    checkpoint = torch.load(args.checkpoint, map_location=\"cpu\")\r\n    loaded = model.load_state_dict(checkpoint.get(\"model\", checkpoint), strict=False)\r\n    allowed = {\r\n        \"text_encoder.embeddings.position_ids\",\r\n        \"text_encoder.embeddings.token_type_ids\",\r\n    }\r\n    if loaded.missing_keys or set(loaded.unexpected_keys) - allowed:\r\n        raise RuntimeError(f\"Checkpoint mismatch: {loaded}\")\r\n    model.eval()\r\n    model.predict_by_feat = types.MethodType(predictor(), model)\r\n    rows = []\r\n    for index in range(min(args.scenes, len(dataset))):\r\n        model.probe_scene_index = index\r\n        with torch.no_grad():\r\n            rows.extend(model(dataset.collate_fn([dataset[index]]), mode=\"predict\")[\"rows\"])\r\n    errors = [row for row in rows if row[\"oracle_iou\"] - row[\"indicator_iou\"] > 0.05]\r\n    result = {\r\n        \"checkpoint\": args.checkpoint,\r\n        \"scenes\": min(args.scenes, len(dataset)),\r\n        \"expressions\": len(rows),\r\n        \"material_errors\": len(errors),\r\n        \"indicator_miou\": statistics.fmean(r[\"indicator_iou\"] for r in rows),\r\n        \"score_miou\": statistics.fmean(r[\"score_iou\"] for r in rows),\r\n        \"score_better_on_errors\": sum(\r\n            r[\"score_iou\"] > r[\"indicator_iou\"] for r in errors\r\n        ),\r\n        \"score_worse_on_errors\": sum(\r\n            r[\"score_iou\"] < r[\"indicator_iou\"] for r in errors\r\n        ),\r\n        \"oracle_quality_gt_selected_on_errors\": sum(\r\n            r[\"oracle_score_quality\"] > r[\"indicator_score_quality\"]\r\n            for r in errors\r\n        ),\r\n        \"rows\": rows,\r\n    }\r\n    Path(args.output).write_text(json.dumps(result, indent=2), encoding=\"utf-8\")\r\n    print(json.dumps({key: value for key, value in result.items() if key != \"rows\"}))\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n        \r\n\r\n        # Extra layers for contrastive losses\r\n        if contrastive_align_loss:\r\n            self.contrastive_align_projection_vision = nn.Sequential(nn.Linear(d_model, d_model),nn.ReLU(),nn.Linear(d_model, d_model),nn.ReLU(),nn.Linear(d_model, 64))\r\n            self.contrastive_align_projection_text = nn.Sequential(nn.Linear(d_model, d_model),nn.ReLU(),nn.Linear(d_model, d_model),nn.ReLU(),nn.Linear(d_model, 64))         \r\n        \r\n        self.scg_head = SelfAttentionLayer(d_model, nhead, dropout=0, glu=True)\r\n        \r\n    \r\n    def forward_iter_pred(self, x, fps_seed_sp, batch_offsets, lang_feats=None, lang_masks=None, sp_pos=None, feats_2d=None):\r\n        \"\"\"\r\n        x [B*M, inchannel]\r\n        \"\"\"\r\n        \r\n        lang_feats = self.lang_proj(lang_feats) \r\n        lang_feats = self.lang_norm(lang_feats)  \r\n        lang_masks = ~(lang_masks.bool())\r\n        inst_feats = self.input_proj(x)\r\n        \r\n        inst_feats_2d = self.input_proj_2d(feats_2d)\r\n        inst_feats = self.sum_norm(inst_feats+inst_feats_2d)\r\n        \r\n        mask_feats = self.x_mask(x)\r\n        inst_feats, batch_mask = self.get_batches(inst_feats, batch_offsets)\r\n        mask_feats, _ = self.get_batches(mask_feats, batch_offsets)\r\n        \r\n        sp_pos, _ = self.get_batches(sp_pos, batch_offsets)\r\n        \r\n        prediction_masks, prediction_scores, prediction_indis = [], [], []\r\n        \r\n        sample_inds = None\r\n        ref_scores = None\r\n         \r\n        seed_sp = inst_feats.gather(dim=1, index=fps_seed_sp.long().unsqueeze(-1).repeat(1, 1, inst_feats.size(-1)))\r\n        seed_sp_pos = sp_pos.gather(dim=1, index=fps_seed_sp.long().unsqueeze(-1).repeat(1, 1, sp_pos.size(-1)))\r\n        \r\n        scg_weights,scg_mask = self.get_scg_weight(seed_sp_pos)\r\n        # print(scg_weights)\r\n        # print(scg_weights.size())\r\n        # pp\r\n        # seed_sp = self.scg_head(seed_sp, seed_sp, seed_sp, attention_weights = scg_weights)\r\n        seed_sp = self.scg_head(seed_sp, att_weights = scg_weights)\r\n\r\n         # sampling\r\n        if hasattr(self, 'sampling_module') and self.sampling_module is not None:\r\n            sample_inds, ref_scores = self.sampling_module(seed_sp, lang_feats, None, lang_masks)\r\n            sample_inds = sample_inds.long()\r\n            sampled_seed = seed_sp.gather(dim=1, index=sample_inds.unsqueeze(-1).repeat(1, 1, seed_sp.size(-1)))\r\n            query_pos = seed_sp_pos.gather(dim=1, index=sample_inds.unsqueeze(-1).repeat(1, 1, seed_sp_pos.size(-1)))\r\n            query = self.query_generator(sampled_seed)\r\n        else:\r\n            query = self.query_generator(seed_sp)\r\n            query_pos = seed_sp_pos\r\n            \r\n        # scg_weights = self.get_scg_weight(query_pos)\r\n\r\n        proj_queries = []\r\n        if self.contrastive_align_loss:\r\n            proj_queries.append(F.normalize(self.contrastive_align_projection_vision(query), p=2, dim=-1))\r\n        else:\r\n            proj_queries.append(None)\r\n            \r\n        proj_tokens = []\r\n        if self.contrastive_align_loss:\r\n            proj_tokens.append(F.normalize(self.contrastive_align_projection_text(lang_feats), p=2, dim=-1))\r\n        else:\r\n            proj_tokens.append(None)\r\n        \r\n        \r\n        pred_scores, pred_masks, attn_masks = self.prediction_head(query, mask_feats, batch_mask)\r\n        pred_indis = self.indi_embedding(query, pred_masks, batch_mask)\r\n        prediction_scores.append(pred_scores)\r\n        prediction_masks.append(pred_masks)\r\n        prediction_indis.append(pred_indis)\r\n        \r\n        lang_query = lang_feats\r\n        \r\n        # multi-round\r\n\r\n        for i in range(self.num_layer):\r\n            \r\n            lang_query = self.lla_layers[i](lang_query, lang_masks)\r\n            lang_query, _, _ = self.lia_layers[i](inst_feats, lang_query, batch_mask, None)\r\n            inst_feats, _, _ = self.ila_layers[i](lang_query, inst_feats, lang_masks, None)\r\n            lang_query = self.lia_ffn_layers[i](lang_query)\r\n            inst_feats = self.ila_ffn_layers[i](inst_feats)\r\n\r\n            coarse_query, coarse_att, _ = self.qia_layers[i](inst_feats, query, batch_mask, attn_masks)\r\n            coarse_query_ffn = self.qia_ffn_layers[i](coarse_query)\r\nimport torch, math\r\nimport torch.nn as nn\r\nimport numpy as np\r\nimport sys\r\nimport os\r\nimport torch.nn.functional as F\r\nif os.path.join(os.getcwd()) not in sys.path:\r\n    sys.path.append(os.path.join(os.getcwd())) # HACK add the root folder\r\n\r\nBASE_DIR = os.path.dirname(os.path.abspath(__file__))\r\nROOT_DIR = os.path.dirname(BASE_DIR)\r\nsys.path.append(BASE_DIR)\r\nsys.path.append(os.path.join(os.getcwd(), \"lib\"))\r\nsys.path.append(os.path.join(os.getcwd(), \"lib\", 'pointnet2'))\r\n\r\nclass CrossAttentionMap(nn.Module):\r\n    def __init__(self, q_dim, k_dim, d_model):\r\n        super().__init__()\r\n        self.d_model = d_model\r\n        self.query_proj = nn.Linear(q_dim, d_model, bias=False)\r\n        self.key_proj = nn.Linear(k_dim, d_model, bias=False)\r\n\r\n    def forward(self, query, key, query_mask=None, key_padding_mask=None):\r\n        \"\"\"\r\n        Args:\r\n            query: (B, N, D1)\r\n            key: (B, L, D2)\r\n            query_mask: (B, N)\r\n            key_padding_mask: (B, L)\r\n        Returns:\r\n            attn_map: (B, N, L)\r\n        \"\"\"\r\n        # Apply projection to query and key\r\n        Q = self.query_proj(query)  # (B, N, D_model)\r\n        K = self.key_proj(key)  # (B, L, D_model)\r\n        # Compute attention scores\r\n        scores = torch.einsum('bnd,bld->bnl', Q, K) / math.sqrt(self.d_model)  # (B, N, L)\r\n        # Apply masks\r\n        if query_mask is not None:\r\n            scores = scores.masked_fill(query_mask.unsqueeze(2), float('-inf'))\r\n        # Compute attention map\r\n        attn_map = F.softmax(scores, dim=1)\r\n        return attn_map\r\n    \r\nclass SamplingModule(nn.Module):\r\n    \"\"\"\r\n    Sample object proposal.\r\n    \"\"\"\r\n    def __init__(self, num_proposal, pc_dim, lang_dim, d_model):\r\n        super().__init__()\r\n        self.num_proposal = num_proposal\r\n        \r\n        self.camap = CrossAttentionMap(pc_dim, lang_dim, d_model)\r\n\r\n    def forward(self, pc_feat, lang_feat, pc_mask, lang_mask, gate = None):\r\n        \"\"\"\r\n        Args:\r\n            features: (B, N, D)\r\n            lang_feat: (B, L, D)\r\n        \"\"\"\r\n        if pc_mask is not None:\r\n            pc_mask = pc_mask.bool()\r\n        # (B, N, L)\r\n        ref_scores = self.camap(pc_feat, lang_feat, pc_mask, lang_mask.bool()) # (B, N, L)\r\n        ref_scores = ref_scores * (~lang_mask.unsqueeze(1)).float() # (B, N, L)\r\n        ref_scores = ref_scores.sum(-1)   # [B, N]\r\n        if gate != None:\r\n            ref_scores = ref_scores * gate\r\n        # print(ref_scores)\r\n        if ref_scores.shape[1] < self.num_proposal:\r\n            sample_inds = torch.Tensor(list(range(ref_scores.shape[1]))).int().unsqueeze(0).repeat(ref_scores.shape[0], 1).cuda()\r\n        else:\r\n            sample_inds = torch.topk(ref_scores, self.num_proposal)[1].int() # (bsz, num_proposal)\r\n\r\n        return sample_inds, ref_scores\r\n\r\nif __name__=='__main__':\r\n    from easydict import EasyDict\r\n    data_dict = {'point_clouds': torch.rand(16,3000,6).cuda()}\r\n    args = EasyDict({\r\n        'kps_fusion_dim': 256\r\n    })\r\n    dks_net = SamplingModule(num_proposal=512, feat_dim=32, lang_dim=256, d_model=256).cuda()\r\n    pc_xyz = torch.rand(16, 3000, 3).cuda()\r\n    pc_feat = torch.rand(16, 32, 3000).cuda()\r\n    lang_feat = torch.rand(16, 256).cuda()\r\n    data_dict['lang_hidden'] = lang_feat\r\n    out_dict, xyz, feat = dks_net(pc_xyz, pc_feat, data_dict)\r\n    print(xyz.shape, feat.shape)\r\n    for key in sorted(out_dict.keys()):\r\n        print(key, '\\t', out_dict[key].shape)\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_26","type":"agent_message","text":"The sampler returns queries in descending language-relevance order, which makes the index skew a concrete hypothesis: the confidence head may be overusing sampler rank. I’ll add a read-only native probe for selected/oracle ranks, sampler-only selection, and a reversed-order control on the fixed 16 scenes. No training candidate is admitted from index statistics alone."}}
