{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"\"C:\\\\Users\\\\chuanle song\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\pwsh.exe\" -Command \"Get-Content 'AdaRES/tools/diagnose_adares_n1_gradient_interference.py' -TotalCount 180; Get-Content 'AdaRES/tools/diagnose_adares_n2_same_object.py' -TotalCount 155\"","aggregated_output":"import argparse\r\nimport importlib\r\nimport json\r\nimport sys\r\nfrom pathlib import Path\r\n\r\nimport gorilla\r\nimport torch\r\n\r\nROOT = Path(__file__).resolve().parents[1]\r\nsys.path.insert(0, str(ROOT))\r\n\r\nfrom ipdn.dataset import build_dataset\r\nfrom ipdn.utils import get_root_logger\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser()\r\n    parser.add_argument(\"config\")\r\n    parser.add_argument(\"--model\", choices=(\"adares_b4_query_competition\", \"adares_g1_metric_targets\"), required=True)\r\n    parser.add_argument(\"--indices\", type=int, nargs=2, default=(0, 1))\r\n    parser.add_argument(\"--gpu-id\", type=int, default=1)\r\n    parser.add_argument(\"--checkpoint\")\r\n    parser.add_argument(\"--detach-mask-evidence\", action=\"store_true\")\r\n    parser.add_argument(\"--one-step\", action=\"store_true\")\r\n    parser.add_argument(\"--output\", required=True)\r\n    args = parser.parse_args()\r\n\r\n    gorilla.set_cuda_visible_devices([args.gpu_id], 1)\r\n    gorilla.set_random_seed(1999)\r\n    cfg = gorilla.Config.fromfile(args.config)\r\n    dataset = build_dataset(cfg.data.train, get_root_logger())\r\n    model_type = importlib.import_module(f\"ipdn.model_paper5.{args.model}\").IPDN\r\n    model = model_type(**cfg.model).cuda()\r\n    if args.checkpoint:\r\n        checkpoint = torch.load(args.checkpoint, map_location=\"cpu\")\r\n        loaded = model.load_state_dict(checkpoint.get(\"model\", checkpoint), strict=False)\r\n        allowed = {\"text_encoder.embeddings.position_ids\", \"text_encoder.embeddings.token_type_ids\"}\r\n        if loaded.missing_keys or set(loaded.unexpected_keys) - allowed:\r\n            raise RuntimeError(f\"Checkpoint mismatch: {loaded}\")\r\n    model.train()\r\n    if args.detach_mask_evidence:\r\n        indicator_module = model.dec.indi_embedding\r\n        original_forward = indicator_module.forward\r\n\r\n        def detached_forward(query, pred_masks, batch_mask):\r\n            return original_forward(query, pred_masks.detach(), batch_mask)\r\n\r\n        indicator_module.forward = detached_forward\r\n    batch = dataset.collate_fn([dataset[i] for i in args.indices])\r\n    cpu_rng = torch.get_rng_state()\r\n    cuda_rng = torch.cuda.get_rng_state()\r\n    loss, parts = model(batch, mode=\"loss\")\r\n    params = dict(model.named_parameters())\r\n    parameter = params[\"dec.x_mask.0.weight\"]\r\n    indicator = parts[\"indi_loss\"]\r\n    mask = parts[\"mask_bce_loss\"] + parts[\"mask_dice_loss\"]\r\n    grad_indicator = torch.autograd.grad(indicator, parameter, retain_graph=True, allow_unused=True)[0]\r\n    grad_mask = torch.autograd.grad(mask, parameter, retain_graph=True, allow_unused=True)[0]\r\n    if grad_mask is None or (grad_indicator is None and not args.detach_mask_evidence):\r\n        raise RuntimeError(\"Unexpected missing gradient\")\r\n    if grad_indicator is None:\r\n        grad_indicator = torch.zeros_like(grad_mask)\r\n    if not torch.isfinite(grad_indicator).all() or not torch.isfinite(grad_mask).all():\r\n        raise RuntimeError(\"Non-finite gradient\")\r\n    indicator_norm = grad_indicator.norm()\r\n    mask_norm = grad_mask.norm()\r\n    if mask_norm == 0 or (indicator_norm == 0 and not args.detach_mask_evidence):\r\n        raise RuntimeError(\"Zero gradient\")\r\n    result = {\r\n        \"model\": args.model,\r\n        \"checkpoint\": args.checkpoint,\r\n        \"detach_mask_evidence\": args.detach_mask_evidence,\r\n        \"indices\": args.indices,\r\n        \"total_loss\": float(loss.detach()),\r\n        \"indicator_loss\": float(indicator.detach()),\r\n        \"mask_loss\": float(mask.detach()),\r\n        \"indicator_gradient_norm\": float(indicator_norm),\r\n        \"mask_gradient_norm\": float(mask_norm),\r\n        \"gradient_cosine\": (\r\n            float((grad_indicator * grad_mask).sum() / (indicator_norm * mask_norm))\r\n            if indicator_norm > 0 else None\r\n        ),\r\n        \"opposed_element_fraction\": float(((grad_indicator * grad_mask) < 0).float().mean()),\r\n        \"peak_reserved_gib\": torch.cuda.max_memory_reserved() / 2**30,\r\n    }\r\n    if args.one_step:\r\n        before = float(mask.detach())\r\n        loss.backward()\r\n        with torch.no_grad():\r\n            parameter.add_(parameter.grad, alpha=-float(cfg.optimizer.lr))\r\n        torch.set_rng_state(cpu_rng)\r\n        torch.cuda.set_rng_state(cuda_rng)\r\n        _, after_parts = model(batch, mode=\"loss\")\r\n        after = float((after_parts[\"mask_bce_loss\"] + after_parts[\"mask_dice_loss\"]).detach())\r\n        result[\"one_step_mask_before\"] = before\r\n        result[\"one_step_mask_after\"] = after\r\n        result[\"one_step_mask_delta\"] = after - before\r\n    Path(args.output).write_text(json.dumps(result, indent=2), encoding=\"utf-8\")\r\n    print(json.dumps(result))\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\nimport argparse\r\nimport json\r\nimport sys\r\nimport types\r\nfrom collections import defaultdict\r\nfrom pathlib import Path\r\n\r\nimport gorilla\r\nimport torch\r\nimport torch.nn.functional as F\r\n\r\nROOT = Path(__file__).resolve().parents[1]\r\nsys.path.insert(0, str(ROOT))\r\n\r\nfrom ipdn.dataset import build_dataset\r\nfrom ipdn.model_paper5.adares_b4_query_competition import IPDN\r\nfrom ipdn.utils import get_root_logger\r\n\r\n\r\ndef predictor():\r\n    def predict_by_feat(self, scan_ids, object_idss, ann_ids, out, superpoints,\r\n                        gt_pmasks, gt_spmasks, fps_seed_sp):\r\n        rows = []\r\n        for index, truth in enumerate(gt_pmasks):\r\n            masks = out[\"masks\"][index].sigmoid().gt(0.5)[:, superpoints]\r\n            target = truth.gt(0.5).to(masks.device)\r\n            ious = (masks & target).sum(-1).float() / (\r\n                (masks | target).sum(-1).clamp_min(1).float()\r\n            )\r\n            scores = F.softmax(out[\"indis\"][index], dim=-1)[:, 1]\r\n            selected = int(scores.argmax())\r\n            oracle = int(ious.argmax())\r\n            rows.append({\r\n                \"scene\": self.probe_scene,\r\n                \"object_ids\": [int(v) for v in object_idss[index]],\r\n                \"language\": self.probe_language[index].tolist(),\r\n                \"selected_iou\": float(ious[selected]),\r\n                \"oracle_iou\": float(ious[oracle]),\r\n                \"selected_mask\": torch.where(masks[selected])[0].tolist(),\r\n                \"oracle_mask\": torch.where(masks[oracle])[0].tolist(),\r\n            })\r\n        return {\"rows\": rows}\r\n    return predict_by_feat\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser()\r\n    parser.add_argument(\"config\")\r\n    parser.add_argument(\"checkpoint\")\r\n    parser.add_argument(\"--scenes\", type=int, default=16)\r\n    parser.add_argument(\"--gpu-id\", type=int, default=1)\r\n    parser.add_argument(\"--output\", required=True)\r\n    args = parser.parse_args()\r\n    gorilla.set_cuda_visible_devices([args.gpu_id], 1)\r\n    gorilla.set_random_seed(1999)\r\n    cfg = gorilla.Config.fromfile(args.config)\r\n    data_cfg = cfg.data.val.copy()\r\n    data_cfg.training = False\r\n    data_cfg.aug = False\r\n    data_cfg.with_elastic = False\r\n    data_cfg.lang_num_max = 32\r\n    dataset = build_dataset(data_cfg, get_root_logger())\r\n    model = IPDN(**cfg.model).cuda()\r\n    checkpoint = torch.load(args.checkpoint, map_location=\"cpu\")\r\n    loaded = model.load_state_dict(checkpoint.get(\"model\", checkpoint), strict=False)\r\n    allowed = {\"text_encoder.embeddings.position_ids\", \"text_encoder.embeddings.token_type_ids\"}\r\n    if loaded.missing_keys or set(loaded.unexpected_keys) - allowed:\r\n        raise RuntimeError(f\"Checkpoint mismatch: {loaded}\")\r\n    model.eval()\r\n    def capture_language(module, inputs):\r\n        language, mask = inputs[3], inputs[4].bool()\r\n        valid = mask.unsqueeze(-1).to(language.dtype)\r\n        pooled = (language * valid).sum(1) / valid.sum(1).clamp_min(1)\r\n        model.probe_language = F.normalize(pooled, dim=-1)\r\n\r\n    model.dec.register_forward_pre_hook(capture_language)\r\n    model.predict_by_feat = types.MethodType(predictor(), model)\r\n    rows = []\r\n    for scene in range(min(args.scenes, len(dataset))):\r\n        model.probe_scene = scene\r\n        with torch.no_grad():\r\n            rows.extend(model(dataset.collate_fn([dataset[scene]]), mode=\"predict\")[\"rows\"])\r\n    groups = defaultdict(list)\r\n    for row in rows:\r\n        if len(row[\"object_ids\"]) == 1:\r\n            groups[(row[\"scene\"], row[\"object_ids\"][0])].append(row)\r\n    pairs = []\r\n    for (scene, object_id), group in groups.items():\r\n        if len(group) < 2:\r\n            continue\r\n        for index, left in enumerate(group):\r\n            for right in group[index + 1:]:\r\n                a, b = set(left[\"selected_mask\"]), set(right[\"selected_mask\"])\r\n                c, d = set(left[\"oracle_mask\"]), set(right[\"oracle_mask\"])\r\n                pairs.append({\r\n                    \"scene\": scene,\r\n                    \"object_id\": object_id,\r\n                    \"selected_overlap\": len(a & b) / max(1, len(a | b)),\r\n                    \"oracle_overlap\": len(c & d) / max(1, len(c | d)),\r\n                    \"left_iou\": left[\"selected_iou\"],\r\n                    \"right_iou\": right[\"selected_iou\"],\r\n                    \"left_oracle_iou\": left[\"oracle_iou\"],\r\n                    \"right_oracle_iou\": right[\"oracle_iou\"],\r\n                })\r\n    result = {\r\n        \"scenes\": min(args.scenes, len(dataset)),\r\n        \"expressions\": len(rows),\r\n        \"same_object_groups\": sum(len(g) >= 2 for g in groups.values()),\r\n        \"same_object_pairs\": len(pairs),\r\n        \"pairs\": pairs,\r\n    }\r\n    nearest = []\r\n    by_scene = defaultdict(list)\r\n    for row in rows:\r\n        by_scene[row[\"scene\"]].append(row)\r\n    for group in by_scene.values():\r\n        if len(group) < 2:\r\n            continue\r\n        languages = torch.tensor([row[\"language\"] for row in group])\r\n        similarities = languages @ languages.T\r\n        similarities.fill_diagonal_(-float(\"inf\"))\r\n        for index, partner_index in enumerate(similarities.argmax(-1).tolist()):\r\n            left, right = group[index], group[partner_index]\r\n            a, b = set(left[\"selected_mask\"]), set(right[\"selected_mask\"])\r\n            nearest.append({\r\n                \"same_object\": len(left[\"object_ids\"]) == len(right[\"object_ids\"]) == 1\r\n                and left[\"object_ids\"] == right[\"object_ids\"],\r\n                \"selected_overlap\": len(a & b) / max(1, len(a | b)),\r\n                \"left_iou\": left[\"selected_iou\"],\r\n                \"right_iou\": right[\"selected_iou\"],\r\n            })\r\n    result[\"language_nearest\"] = nearest\r\n    scene_pairs = []\r\n    for group in by_scene.values():\r\n        for index, left in enumerate(group):\r\n            for right in group[index + 1:]:\r\n                a, b = set(left[\"selected_mask\"]), set(right[\"selected_mask\"])\r\n                c, d = set(left[\"oracle_mask\"]), set(right[\"oracle_mask\"])\r\n                scene_pairs.append({\r\n                    \"same_object\": len(left[\"object_ids\"]) == len(right[\"object_ids\"]) == 1\r\n                    and left[\"object_ids\"] == right[\"object_ids\"],\r\n                    \"selected_overlap\": len(a & b) / max(1, len(a | b)),\r\n                    \"oracle_overlap\": len(c & d) / max(1, len(c | d)),\r\n                    \"left_iou\": left[\"selected_iou\"],\r\n                    \"right_iou\": right[\"selected_iou\"],\r\n                })\r\n    result[\"scene_pairs\"] = scene_pairs\r\n    Path(args.output).write_text(json.dumps(result, indent=2), encoding=\"utf-8\")\r\n    print(json.dumps({key: value for key, value in result.items() if key != \"pairs\"}))\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n","exit_code":0,"status":"completed"}}
