e": 0.021046670155952393, "prospective8eps_queries_bound": 2.2737367544323206e-13, "exact_cached_repeat": true, "exact_actual_formula_reconstruction": true, "joint_superpoint_permutation_error": 1.249000902703301e-16, "equal_row_mass": true, "equal_point_coverage": true, "actual_overlap_matrix_difference": 0.998324597696198}, {"seed": 28, "actual_W2_score_difference": 0.02416510448868464, "prospective8eps_queries_bound": 2.2737367544323206e-13, "exact_cached_repeat": true, "exact_actual_formula_reconstruction": true, "joint_superpoint_permutation_error": 1.1102230246251565e-16, "equal_row_mass": true, "equal_point_coverage": true, "actual_overlap_matrix_difference": 0.998324597696198}, {"seed": 29, "actual_W2_score_difference": 0.019194876577446424, "prospective8eps_queries_bound": 2.2737367544323206e-13, "exact_cached_repeat": true, "exact_actual_formula_reconstruction": true, "joint_superpoint_permutation_error": 1.249000902703301e-16, "equal_row_mass": true, "equal_point_coverage": true, "actual_overlap_matrix_difference": 0.998324597696198}, {"seed": 30, "actual_W2_score_difference": 0.015207189183419158, "prospective8eps_queries_bound": 2.2737367544323206e-13, "exact_cached_repeat": true, "exact_actual_formula_reconstruction": true, "joint_superpoint_permutation_error": 1.249000902703301e-16, "equal_row_mass": true, "equal_point_coverage": true, "actual_overlap_matrix_difference": 0.998324597696198}, {"seed": 31, "actual_W2_score_difference": 0.02120320396454517, "prospective8eps_queries_bound": 2.2737367544323206e-13, "exact_cached_repeat": true, "exact_actual_formula_reconstruction": true, "joint_superpoint_permutation_error": 1.5265566588595902e-16, "equal_row_mass": true, "equal_point_coverage": true, "actual_overlap_matrix_difference": 0.998324597696198}], "CPU_cases": 32, "queries": 128, "actual_W2_source_sha256": "6362d882662b0e51594cd4af994359b93f99497affc93600322a34ca6c349b01", "actual_W2_class_source": "class QueryCompetitionIndicator(nn.Module):\n    \"\"\"Predict confidence from a query and its overlapping competitors.\"\"\"\n\n    def __init__(self, d_model):\n        super().__init__()\n        self.query_norm = nn.LayerNorm(d_model)\n        self.evidence_norm = nn.LayerNorm(3 * d_model + 1)\n        self.head = nn.Sequential(\n            nn.Linear(3 * d_model + 1, d_model),\n            nn.GELU(),\n            nn.Linear(d_model, d_model),\n            nn.GELU(),\n            nn.Linear(d_model, 2),\n        )\n\n    def forward(self, query, pred_masks, batch_mask, point_mass):\n        valid = (~batch_mask).unsqueeze(1).to(pred_masks.dtype)\n        probabilities = pred_masks.sigmoid() * valid\n        weighted = probabilities * point_mass.unsqueeze(1)\n        areas = weighted.sum(-1)\n        intersection = torch.einsum(\n            'bim,bjm->bij', weighted, probabilities\n        )\n        union = areas.unsqueeze(-1) + areas.unsqueeze(1) - intersection\n        overlap = intersection / union.clamp_min(1e-6)\n        diagonal = torch.eye(\n            overlap.shape[-1], dtype=torch.bool, device=overlap.device\n        ).unsqueeze(0)\n        overlap = overlap.masked_fill(diagonal, 0.0)\n\n        competition = overlap / overlap.sum(-1, keepdim=True).clamp_min(1e-6)\n        normalized_query = self.query_norm(query)\n        context = torch.einsum('bij,bjd->bid', competition, normalized_query)\n        max_overlap = overlap.max(-1).values.unsqueeze(-1)\n        evidence = torch.cat(\n            [\n                normalized_query,\n                context,\n                normalized_query - context,\n                max_overlap,\n            ],\n            dim=-1,\n        )\n        return self.head(self.evidence_norm(evidence))", "all_actual_parent_distinguish_equal_marginal_fixtures": true, "minimum_actual_W2_score_difference": 0.014131082463533007, "maximum_joint_permutation_error": 1.8041124150158794e-16, "maximum_prospective_bound": 2.2737367544323206e-13, "proposed_missing_context_premise": "disconfirmed_by_actual_parent", "scientific_status": "rejected_missing_information_realization_not_all_pairwise_hypotheses", "limitations": ["Actual W2 already computes the point-mass pairwise intersection/union/competitor context.", "Hard versus soft overlap alone would change numerics, not supply the claimed missing correspondence path.", "Fixed diagnostic mask logits are not deployed or chosen using validation.", "Controlled actual-class differences are not population efficacy.", "No new model/config/checkpoint/loss/admission/queue or GPU operation."]}